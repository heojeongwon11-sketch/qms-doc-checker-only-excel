    // 정적 UI 라벨은 i18n 객체로 처리하지만, 토스트 메시지나 파일 배지처럼
    // 조건에 따라 즉석에서 만들어지는 문구는 currentLang을 보고 바로 골라 쓴다.
    // 키워드/규격 값 같은 "데이터"는 이 함수를 거치지 않고 그대로 유지한다.
    function bi(kor, eng) {
      return (currentLang === 'eng') ? eng : kor;
    }

    function translateTextToEng(text) {
      if (!text || typeof text !== 'string') return text;
      let s = text;

      // 문장 전체를 바꾸는 규칙을 먼저 적용한다. 아래쪽의 단어 단위 치환("관리계획서"→
      // "Control Plan" 등)이 먼저 실행되면 그 단어를 포함한 긴 문장 패턴을 더 이상
      // 찾을 수 없게 되므로, 반드시 구체적/긴 패턴이 일반적/짧은 패턴보다 먼저 와야 한다.

      // 관리계획서와 대상문서 항목의 키워드/규격 매칭 결과 사유 (verifySpecAndUnitMatch)
      s = s.replace(/⚠️ \[단위 불일치\] 키워드는 일치했으나 단위가 다릅니다\. \(관리계획서: '(.*?)' vs 대상문서: '(.*?)'\)/g,
        "⚠️ [Unit Mismatch] Keyword matches but the unit differs. (Control Plan: '$1' vs Target Doc: '$2')")
        .replace(/❌ \[규격 불일치\] 키워드는 일치했으나 규격이 다릅니다\. 관리계획서 \[(.*?)\] vs 대상문서 \[(.*?)\]/g,
          'Keyword matches but the spec differs. Control Plan [$1] vs Target Doc [$2]')
        .replace(/키워드 및 규격\/단위 100% 일치 \(Pass\)/g, 'Keyword and spec/unit match 100% (Pass)')
        .replace(/미기재/g, 'not specified');

      // REVIEW / MISSING 사유 문구 (runAnalysis 1~5단계)
      s = s.replace(/🔍 \[REVIEW - 유사도 (\d+)%\] 검사표준서 제품특성 '(.*?)' Exact Match 없음\. 가장 유사한 후보 발견: '(.*?)'\./g,
        "🔍 [REVIEW - $1% Similarity] No Exact Match for Inspection Standard Product Feature '$2'. Most similar candidate found: '$3'.")
        .replace(/❌ \[MISSING\] 검사표준서 제품특성 '(.*?)' 일치 항목 없음\./g,
          "❌ [MISSING] No matching item for Inspection Standard Product Feature '$1'.")
        .replace(/🔍 \[REVIEW - 유사도 (\d+)%\] 공정특성 Exact Match 없음\. 가장 유사한 후보 발견: '(.*?)'\. 작업자 직접 동일 여부 확인 필요\./g,
          "🔍 [REVIEW - $1% Similarity] No Exact Match for Process Feature. Most similar candidate found: '$2'. Operator manual verification required.")
        .replace(/🔍 \[REVIEW - 유사도 (\d+)%\] 작업요소 Exact Match 없음\. 가장 유사한 후보 발견: '(.*?)'\. 작업자 직접 동일 여부 확인 필요\./g,
          "🔍 [REVIEW - $1% Similarity] No Exact Match for Work Element. Most similar candidate found: '$2'. Operator manual verification required.")
        // "100%"가 붙는 경우/안 붙는 경우 둘 다 커버 (실제 생성 문구엔 100%가 없음).
        // 뒤에서 "유사도"→"Similarity" 단어 단위 치환이 먼저 일어나면 이 패턴을 못 찾으므로
        // 반드시 그 전에 처리한다.
        .replace(/공정특성\/작업요소( 100%)? Exact Match 없음 및 최고 유사도 70% 미만/g, 'No Exact Match for Process Feature/Work Element & max similarity < 70%')
        .replace(/관리표준\/기록방법 \[(.*?)\] 이\(가\) 4대 검사 대상 문서에 해당하지 않아 검사 패스\(SKIPPED\) 처리/g,
          'Control method [$1] is not one of the 4 target document types, skipped (SKIPPED).')
        .replace(/지정 문서 \[(.*?)\] \(관리표준: "(.*?)"\) 파일이 업로드되지 않아 검사 패스/g, 'Target doc [$1] (control method: "$2") file is not uploaded, skipped.');

      // 퍼징 작업지도서 직접 대조 사유 문구
      s = s.replace(/✅ \[MATCH\] 퍼징 작업지도서 '(.*?)' 값이 관리계획서와 일치합니다\./g,
        "✅ [MATCH] Purging Work Instruction '$1' matches the Control Plan.")
        .replace(/❌ \[MISMATCH\] 퍼징 작업지도서 '(.*?)' 값이 관리계획서와 다릅니다\./g,
          "❌ [MISMATCH] Purging Work Instruction '$1' differs from the Control Plan.")
        .replace(/⚠️ \[MISSING\] 퍼징 작업지도서에 '(.*?)' 값이 기재되어 있지 않습니다\./g,
          "⚠️ [MISSING] '$1' is not filled in on the Purging Work Instruction.")
        .replace(/⚠️ \[MISSING\] 퍼징 작업지도서에서 '(.*?)' 항목 자체를 찾지 못했습니다\./g,
          "⚠️ [MISSING] The '$1' field itself was not found on the Purging Work Instruction.")
        .replace(/🔍 \[REVIEW\] 관리계획서에서 '(.*?)' 기준값을 찾지 못했습니다\. 작업자 직접 확인 필요\./g,
          "🔍 [REVIEW] Reference value '$1' was not found in the Control Plan. Operator verification required.")
        .replace(/🔍 \[REVIEW\] 숫자 값은 같으나 표기가 다릅니다\. 작업자 직접 확인 필요\./g,
          '🔍 [REVIEW] The numeric value matches but the notation differs. Operator verification required.')
        .replace(/🔍 \[REVIEW\] 숫자 값으로 읽을 수 없어 직접 대조가 불가합니다\. 작업자 직접 확인 필요\./g,
          '🔍 [REVIEW] The value could not be read as a number, so a direct check is not possible. Operator verification required.')
        .replace(/🔍 \[REVIEW\] 퍼징 작업지도서 파일에서 데이터를 읽지 못했습니다\. 작업자 직접 확인 필요\./g,
          '🔍 [REVIEW] Could not read data from the Purging Work Instruction file. Operator verification required.')
        .replace(/🔍 \[REVIEW\] '(.*?)' 항목은 자동 대조 규칙이 없습니다\. 작업자 직접 확인 필요\./g,
          "🔍 [REVIEW] '$1' has no automatic check rule. Operator verification required.")
        .replace(/\(관리계획서: (.*?) \/ 퍼징 작업지도서: (.*?)\)/g, '(Control Plan: $1 / Purging Work Instruction: $2)')
        .replace(/\(퍼징 작업지도서: (.*?)\)/g, '(Purging Work Instruction: $1)')
        .replace(/퍼징 지정항목 직접 대조/g, 'Direct check of designated purging fields')
        .replace(/퍼징 작업지도서 대조/g, 'Purging Work Instruction check')
        .replace(/제품 중량 검사 \(규격 하한\)/g, 'Product Weight Inspection (spec lower limit)')
        .replace(/제품 중량 검사 \(규격 상한\)/g, 'Product Weight Inspection (spec upper limit)')
        .replace(/작업요소 - 사출성형장치/g, 'Work Element - Injection Molding Machine')
        .replace(/대상설비/g, 'Target Equipment')
        .replace(/Tool 번호/g, 'Tool No.')
        .replace(/제품 중량 Min/g, 'Product Weight Min')
        .replace(/제품 중량 Max/g, 'Product Weight Max')
        .replace(/제품번호/g, 'Product No.')
        .replace(/설비번호/g, 'Equipment No.')
        .replace(/금형 No/g, 'Mold No.')
        .replace(/CAV 수량/g, 'CAV Qty')
        .replace(/품명/g, 'Part Name')
        // 5번 퍼징 조건 정보 항목명. 사유 문구 안에서 항상 작은따옴표로 감싸이므로
        // 따옴표째 치환한다. ('조건' 같은 흔한 단어가 '작업조건기록지' 등 다른
        // 문서명 번역을 망가뜨리는 것을 막기 위함)
        .replace(/'노즐부 온도'/g, "'Nozzle Temp'")
        .replace(/'실린더 전단부 온도'/g, "'Cylinder Front Temp'")
        .replace(/'실린더 중반부 온도'/g, "'Cylinder Middle Temp'")
        .replace(/'실린더 후반부 온도'/g, "'Cylinder Rear Temp'")
        .replace(/'투입부 온도'/g, "'Feed Zone Temp'")
        .replace(/'계량 RPM'/g, "'Metering RPM'")
        .replace(/'사출속도 (\d)'/g, "'Injection Speed $1'")
        .replace(/'보압시간 (\d)'/g, "'Holding Time $1'")
        .replace(/'보압 (\d)'/g, "'Holding Pressure $1'")
        .replace(/'사출 시간'/g, "'Injection Time'")
        .replace(/'온조기 셋업 온도 \((Front|Rear)\)'/g, "'Mold Temp Controller Setpoint ($1)'")
        .replace(/'매니폴드 셋업 온도'/g, "'Manifold Setpoint Temp'")
        .replace(/'스쿠류Φ'/g, "'Screw Φ'")
        .replace(/'기준설정\(횟수\)'/g, "'Base Setting (Count)'")
        .replace(/'1shot 퍼징량'/g, "'1-shot Purge Volume'")
        .replace(/'퍼징량 합계'/g, "'Total Purge Volume'")
        .replace(/'조건'/g, "'Condition'")
        .replace(/'노즐 내경'/g, "'Nozzle Bore'")
        // 관리계획서 쪽 기준 항목명(REVIEW 사유에 등장)
        .replace(/'노즐부 히터 온도'/g, "'Nozzle Heater Temp'")
        .replace(/'전단부 히터 온도'/g, "'Front Zone Heater Temp'")
        .replace(/'중반부 히터 온도'/g, "'Middle Zone Heater Temp'")
        .replace(/'후반부 히터 온도'/g, "'Rear Zone Heater Temp'")
        .replace(/'투입부 히터온도'/g, "'Feed Zone Heater Temp'")
        .replace(/'스크류 회전속도'/g, "'Screw Rotation Speed'")
        .replace(/'최대 사출 시간'/g, "'Max Injection Time'")
        .replace(/'핫 런너 매니폴드 온도'/g, "'Hot Runner Manifold Temp'")
        .replace(/'사출속도(\d)'/g, "'Injection Speed $1'")
        .replace(/'보압시간(\d)'/g, "'Holding Time $1'")
        .replace(/'보압(\d)'/g, "'Holding Pressure $1'")
        .replace(/'금형 온도\(FRONT\/REAR\) - (Front|Rear)'/g, "'Mold Temp (FRONT/REAR) - $1'")
        // 제습건조기 사용 관리 기준서
        .replace(/✅ \[MATCH\] 제습건조기 기준서 '(.*?)' 값이 관리계획서와 일치합니다\./g,
          "✅ [MATCH] Dryer Control Standard '$1' matches the Control Plan.")
        .replace(/❌ \[MISMATCH\] 제습건조기 기준서 '(.*?)' 값이 관리계획서와 다릅니다\./g,
          "❌ [MISMATCH] Dryer Control Standard '$1' differs from the Control Plan.")
        .replace(/⚠️ \[MISSING\] 제습건조기 기준서에 '(.*?)' 값이 기재되어 있지 않습니다\./g,
          "⚠️ [MISSING] '$1' is not filled in on the Dryer Control Standard.")
        .replace(/⚠️ \[MISSING\] 제습건조기 기준서에서 '(.*?)' 항목 자체를 찾지 못했습니다\./g,
          "⚠️ [MISSING] The '$1' field itself was not found on the Dryer Control Standard.")
        .replace(/🔍 \[REVIEW\] 제습건조기 사용 관리 기준서 파일에서 데이터를 읽지 못했습니다\. 작업자 직접 확인 필요\./g,
          '🔍 [REVIEW] Could not read data from the Dryer Control Standard file. Operator verification required.')
        .replace(/\(관리계획서: (.*?) \/ 제습건조기 기준서: (.*?)\)/g, '(Control Plan: $1 / Dryer Control Standard: $2)')
        .replace(/\(제습건조기 기준서: (.*?)\)/g, '(Dryer Control Standard: $1)')
        .replace(/제습건조기 지정항목 직접 대조/g, 'Direct check of designated dryer fields')
        .replace(/제습건조기 기준서 대조/g, 'Dryer Control Standard check')
        .replace(/제습건조기 사용 관리 기준서/g, 'Dryer Usage Control Standard')
        .replace(/'원재료 명'/g, "'Material Name'")
        .replace(/'원재료 번호'/g, "'Material No.'")
        .replace(/'표준 수분 함습율'/g, "'Standard Moisture Content'")
        .replace(/'수분 함습율'/g, "'Moisture Content'")
        .replace(/'건조 온도'/g, "'Drying Temp'")
        .replace(/'수분 함유율'/g, "'Moisture Content'")
        .replace(/'공정특성 - Trade Name'/g, "'Process Char. - Trade Name'")
        .replace(/'공정특성 - Part No'/g, "'Process Char. - Part No'")
        .replace(/'작업요소 - 건조기 설정 온도'/g, "'Work Element - Dryer Set Temp'");

      // 짧은 단어/구 단위 치환은 위의 긴 문장 패턴을 다 처리한 "다음"에 실행한다.
      s = s.replace(/퍼징\s*작업지도서/g, 'Purging Work Instruction')
        .replace(/검사표준서/g, 'Inspection Standard')
        .replace(/설비일상점검표/g, 'Equipment Checklist')
        .replace(/스크류 점검일지/g, 'Screw Inspection Log')
        .replace(/작업조건기록지/g, 'Work Condition Log')
        .replace(/관리계획서/g, 'Control Plan')
        .replace(/대상문서/g, 'target document')
        .replace(/비대상 문서/g, 'Non-target Document');

      s = s.replace(/제품특성 Exact Match/g, 'Product Feature Exact Match')
        .replace(/공정특성명 \(100% Exact Match\)/g, 'Process Feature (100% Exact Match)')
        .replace(/작업요소명 \(100% Exact Match\)/g, 'Work Element (100% Exact Match)')
        .replace(/공정특성명/g, 'Process Feature')
        .replace(/작업요소명/g, 'Work Element')
        .replace(/제품특성명/g, 'Product Feature')
        .replace(/제품특성 유사도/g, 'Product Feature Similarity')
        .replace(/공정특성 유사도/g, 'Process Feature Similarity')
        .replace(/작업요소 유사도/g, 'Work Element Similarity')
        .replace(/유사도/g, 'Similarity')
        .replace(/\(검토필요\)/g, '(Needs Review)')
        .replace(/제품특성 미존재/g, 'Product Feature Missing')
        .replace(/Exact Match 및 유사도 기준 미달/g, 'No Exact Match & Low Similarity')
        .replace(/비대상 \(SKIP\)/g, 'Non-target (SKIP)')
        .replace(/미검사/g, 'Uninspected');

      s = s.replace(/3점 규격 & 단위 완벽 일치/g, '3-point spec & unit match perfectly.')
        .replace(/수치 범위는 일치하나 단위 불일치/g, 'spec range matches but unit mismatches')
        .replace(/키워드는 100% 일치하나 규격 범위\/표기 검토 필요/g, 'keyword matches 100% but spec range/notation needs review')
        .replace(/키워드는 100% 일치하나 규격 수치 범위 불일치/g, 'keyword matches 100% but spec values mismatch')
        .replace(/Exact Match 100% 없음/g, 'No 100% Exact Match')
        .replace(/가장 유사한 후보 발견/g, 'most similar candidate found')
        .replace(/작업자 직접 동일 여부 확인 필요/g, 'operator manual verification required')
        // "100%"가 붙는 경우/안 붙는 경우 둘 다 커버 (실제 생성 문구엔 100%가 없음)
        .replace(/공정특성\/작업요소( 100%)? Exact Match 없음 및 최고 유사도 70% 미만/g, 'No Exact Match for Process Feature/Work Element & max similarity < 70%')
        .replace(/최고 유사 후보/g, 'best candidate')
        .replace(/일치 항목 없음/g, 'no matching item')
        .replace(/키워드는 일치했으나 규격이 다릅니다/g, 'Keyword matches but the spec differs')
        .replace(/검사구분 불일치/g, 'Inspection Class Mismatch')
        .replace(/Nominal 불일치/g, 'Nominal Spec Mismatch')
        .replace(/평가\/측정방법 불일치/g, 'Eval/Measurement Method Mismatch')
        .replace(/크기\(n\) 불일치/g, 'Sample Size (n) Mismatch')
        .replace(/검사주기 불일치/g, 'Inspection Frequency Mismatch');

      return s;
    }

