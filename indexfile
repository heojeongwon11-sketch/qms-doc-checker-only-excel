    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      if (!container) return;

      const styleByType = {
        success: 'bg-emerald-950/90 text-emerald-300 border-emerald-800',
        warning: 'bg-amber-950/90 text-amber-300 border-amber-800',
        error: 'bg-rose-950/90 text-rose-300 border-rose-800'
      };
      const iconByType = {
        success: 'check-circle-2',
        warning: 'alert-triangle',
        error: 'alert-triangle'
      };

      const toast = document.createElement('div');
      toast.className = `px-4 py-3 rounded-xl text-xs font-medium flex items-center space-x-2 shadow-2xl transition-all duration-300 pointer-events-auto border transform translate-y-2 opacity-0 ${styleByType[type] || styleByType.error}`;
      toast.innerHTML = `<i data-lucide="${iconByType[type] || 'alert-triangle'}" class="w-4 h-4"></i><span>${message}</span>`;

      container.appendChild(toast);
      lucide.createIcons();

      setTimeout(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      }, 50);

      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 4000);
    }

    function normalizeTargetDoc(methodStr) {
      if (!methodStr || typeof methodStr !== 'string') return null;
      const clean = normalizeText(methodStr).replace(/\s+/g, '');
      if (!clean || clean === '-' || clean === '--') return null;

      // ※ 퍼징 작업지도서는 여기서 라우팅하지 않는다. 관리계획서의 관리기록방법을 보고
      //    대상을 정하는 4대 문서와 달리, 퍼징 작업지도서는 지도서 안에 이미 정해진
      //    항목을 관리계획서와 직접 대조하는 방식이라 runPurgingGuideAnalysis에서
      //    별도로 처리한다.
      if (clean.includes('설비일일점검일지') || clean.includes('설비일상점검표') || clean.includes('설비일일점검') || clean.includes('설비점검')) {
        return '설비일상점검표';
      }

      if (clean.includes('셋업&일일성형조건기록지') || clean.includes('셋업') || clean.includes('성형조건') || clean.includes('작업조건기록지') || clean.includes('조건기록지')) {
        return '작업조건기록지';
      }

      if (clean.includes('스크류점검일지작성') || clean.includes('스크류점검일지') || clean.includes('스크류점검') || clean.includes('스크류')) {
        return '스크류 점검일지';
      }

      if (clean.includes('air에측정data입력') || clean.includes('검사표준서') || clean.includes('검사표준') || clean.includes('air') || clean.includes('측정data')) {
        return '검사표준서';
      }

      return null;
    }

    function isDashOrEmpty(val) {
      if (!val) return true;
      const s = String(val).trim();
      // ⚠️ 어딘가에서 JS의 undefined/null 값이 안전장치 없이 문자열로 이어붙여지면
      // (예: `${a} ${b}`에서 b가 undefined) 화면에 "undefined"라는 글자 그대로가
      // 노출되는 문제가 있었다. 원인 지점을 근본적으로 다 막기 어려우므로, 이 값이
      // 어디서 와도 "빈 값"으로 취급되도록 방어선을 여기 central하게 추가한다.
      const sl = s.toLowerCase();
      return !s || s === '-' || s === '--' || s === 'ㅡ' || s === '~' || s === 'N/A' || s === '없음' || sl === 'undefined' || sl === 'null' || sl === 'nan';
    }

    ['cp', 'is', 'eq', 'sc', 'wc', 'pg', 'dd'].forEach(key => {
      const dropzone = document.getElementById(`dropzone-${key}`);
      if (!dropzone) return;

      ['dragenter', 'dragover'].forEach(eventName => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          dropzone.classList.add('dropzone-active');
        }, false);
      });

      ['dragleave', 'drop'].forEach(eventName => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          dropzone.classList.remove('dropzone-active');
        }, false);
      });

      dropzone.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        const files = dt.files;
        if (files.length > 0) {
          document.getElementById(`file-${key}`).files = files;
          handleFileUpload(key, { target: { files: files } });
        }
      });
    });

    async function handleFileUpload(key, event) {
      try {
        const inputFiles = event.target.files;
        if (!inputFiles || inputFiles.length === 0) return;

        if (!docData[key]) docData[key] = { filesList: [] };
        if (!docData[key].filesList) docData[key].filesList = [];

        // 슬롯당 파일 1개만 허용. 이미 파일이 있으면 새 업로드를 막고,
        // 기존 파일을 먼저 삭제(✕ 버튼)하도록 안내한다.
        if (docData[key].filesList.length > 0) {
          showToast(bi(
            '⚠️ 이미 파일이 업로드되어 있습니다. 추가 업로드는 불가하며, 먼저 기존 파일을 삭제(✕)한 뒤 다시 업로드해주세요.',
            '⚠️ A file is already uploaded here. Additional uploads are not allowed — please remove (✕) the existing file first, then upload again.'
          ), 'error');
          event.target.value = '';
          return;
        }

        // 드래그앤드롭 등으로 여러 파일이 한 번에 들어와도 첫 번째 파일만 사용한다.
        const filesArray = Array.from(inputFiles).slice(0, 1);
        if (inputFiles.length > 1) {
          showToast(bi(
            '⚠️ 이 문서는 파일 1개만 업로드할 수 있어, 첫 번째 파일만 사용됩니다.',
            '⚠️ Only one file is allowed for this document — only the first selected file will be used.'
          ), 'warning');
        }

        for (const file of filesArray) {
          const ext = file.name.split('.').pop().toLowerCase();
          const isExcel = ['xlsx', 'xls', 'csv'].includes(ext);

          // 이 버전은 엑셀/CSV만 지원한다 (PDF/사진 업로드 및 백엔드 OCR 연동 제거).
          // 드래그앤드롭은 input의 accept 속성을 우회할 수 있어 여기서도 한 번 더 막는다.
          if (!isExcel) {
            showToast(bi(
              `⚠️ 엑셀(.xlsx/.xls/.csv) 파일만 업로드할 수 있습니다.`,
              `⚠️ Only Excel files (.xlsx/.xls/.csv) can be uploaded.`
            ), 'error');
            continue;
          }

          const fileObj = {
            id: 'f_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5),
            fileName: file.name,
            fileType: 'excel',
            file: file,
            workbook: null,
            activeSheet: '',
            sheetConfirmed: false, // 사용자가 시트 선택 드롭다운을 직접 다뤘는지 여부 (자동 추정값 그대로 쓰는 중이면 false)
            apiResult: null,
            apiError: null,
            isAnalyzing: false
          };

          docData[key].filesList.push(fileObj);
          updateDocUI(key);

          const reader = new FileReader();
          reader.onload = function (e) {
            try {
              const data = new Uint8Array(e.target.result);
              // cellStyles: true를 켜야 .xls 등에서도 셀 서식(배경색/글꼴 등) 정보를
              // 최대한 함께 읽어온다. 이건 나중에 표시 단계에서 .xls를 xlsx로
              // 변환할 때 서식을 살리기 위해 필요하다 (아래 annotateWorkbookCopy 참고).
              const workbook = XLSX.read(data, { type: 'array', cellDates: true, cellFormulas: false, cellStyles: true });
              fileObj.workbook = workbook;
              fileObj.activeSheet = detectLatestSheet(workbook);
              // 시트가 하나뿐이면 고를 게 없으니 확인된 것으로 처리한다.
              // 여러 개면 사용자가 드롭다운을 직접 확인/선택하기 전까지는 미확인 상태로 남겨둔다.
              fileObj.sheetConfirmed = !workbook.SheetNames || workbook.SheetNames.length <= 1;
            } catch (err) {
              alert(`엑셀 파싱 오류: ` + err.message);
            } finally {
              fileObj.isAnalyzing = false;
              updateDocUI(key);
            }
          };
          reader.readAsArrayBuffer(file);
        }

        const fileInput = document.getElementById(`file-${key}`);
        if (fileInput) fileInput.value = '';
      } catch (err) {
        console.error('handleFileUpload 예외 발생:', err);
      }
    }

    function removeFile(key, index) {
      if (docData[key] && docData[key].filesList && docData[key].filesList[index] !== undefined) {
        docData[key].filesList.splice(index, 1);
        updateDocUI(key);
      }
    }

    // ⚠️ 이름 패턴만으로 "어느 시트가 최종본인지" 완벽히 알아내는 것은 근본적으로 불가능하다.
    // 예를 들어 "OO 수정본"은 어떤 회사에서는 "수정이 완료된 최종본"을 뜻하지만, 다른
    // 문서에서는 "아직 검토 중인 작업용 사본"을 뜻할 수도 있다 — 이름만 보고는 구분이 안 된다.
    // 그래서 이 함수는 "그럴듯한 기본값"만 골라주고, 실제로 여러 시트가 있는 파일은
    // runAnalysis()에서 사용자가 시트 선택 드롭다운을 직접 확인/선택하도록 강제한다
    // (requireSheetConfirmation 참고). 자동 추정 결과를 아무 확인 없이 그대로 써버리는 것이
    // "표시가 엉뚱한 시트에 찍히는" 문제의 근본 원인이었다.
    function detectLatestSheet(workbook) {
      const sheetNames = workbook.SheetNames;
      if (!sheetNames || sheetNames.length === 0) return '';
      if (sheetNames.length === 1) return sheetNames[0];

      let bestSheet = sheetNames[0];
      let maxScore = -1;

      const dateRegex = /(20\d{2})[-._]?(0[1-9]|1[0-2])?[-._]?(0[1-9]|[12]\d|3[01])?/;
      const verRegex = /v(\d+(\.\d+)?)|rev(\d+)|개정(\d+)|최신|최종/i;

      sheetNames.forEach((name, idx) => {
        // 탭 순서는 아주 약한 동점자 처리용으로만 쓴다. (예전엔 idx*10으로 너무 크게
        // 반영돼서, 이름에 아무 단서가 없는 시트들 사이에서는 사실상 "마지막 탭"이
        // 거의 항상 이겨버렸다. 이것만으로 "최종본"을 가려낼 근거는 되지 않는다.)
        let score = idx;

        if (/최신|최종|final/i.test(name)) score += 1000;
        if (/개정/i.test(name)) score += 500;

        const dateMatch = name.match(dateRegex);
        if (dateMatch) {
          const dateStr = dateMatch[0].replace(/[-._]/g, '');
          score += parseInt(dateStr.padEnd(8, '0'), 10) / 10000;
        }

        if (verRegex.test(name)) score += 200;
        if (/이력|history|cover|표지/i.test(name)) score -= 2000;

        if (score > maxScore) {
          maxScore = score;
          bestSheet = name;
        }
      });

      return bestSheet;
    }

    // 여러 시트가 있는 파일 중, 사용자가 아직 시트 선택 드롭다운을 한 번도 건드리지
    // 않은(= detectLatestSheet의 자동 추정값을 그대로 쓰고 있는) 파일 목록을 반환한다.
    // 자동 추정은 "이름이 그럴듯한 기본값"일 뿐 정답이 아닐 수 있으므로, 분석 시작 전에
    // 반드시 사용자가 한 번은 눈으로 확인(또는 다른 시트로 변경)하게 만든다.
    function getUnconfirmedMultiSheetFiles() {
      const unconfirmed = [];
      Object.keys(docData).forEach(key => {
        const f = docData[key] && docData[key].filesList && docData[key].filesList[0];
        if (f && f.fileType === 'excel' && f.workbook && f.workbook.SheetNames && f.workbook.SheetNames.length > 1 && !f.sheetConfirmed) {
          unconfirmed.push({ key, fileName: f.fileName, activeSheet: f.activeSheet });
        }
      });
      return unconfirmed;
    }

    function updateDocUI(key) {
      const statusEl = document.getElementById(`status-${key}`);
      const labelEl = document.getElementById(`label-${key}`);
      const listEl = document.getElementById(`file-list-${key}`);
      const wrapper = document.getElementById(`sheet-select-wrapper-${key}`);
      const select = document.getElementById(`sheet-select-${key}`);

      const filesList = (docData[key] && docData[key].filesList) ? docData[key].filesList : [];
      const count = filesList.length; // 슬롯당 파일 1개만 허용하므로 0 또는 1
      const f = filesList[0];

      if (statusEl) {
        if (count === 0) {
          statusEl.innerText = bi('미업로드', 'Not Uploaded');
          statusEl.className = 'text-xs px-2 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700';
        } else {
          statusEl.innerText = bi('업로드 완료', 'Uploaded');
          statusEl.className = 'text-xs px-2.5 py-1 rounded bg-emerald-950 text-emerald-400 border border-emerald-800 font-semibold';
        }
      }

      if (labelEl) {
        if (count === 0) {
          labelEl.innerText = key === 'cp'
            ? bi('관리계획서 파일 선택 (클릭 또는 드래그앤드롭)', 'Select Control Plan File (Click or Drag & Drop)')
            : bi('파일 선택', 'Select File');
        } else {
          labelEl.innerText = bi('다른 파일로 교체하려면 기존 파일을 먼저 삭제하세요', 'Remove the current file first to upload a different one');
        }
      }

      if (listEl) {
        if (count === 0) {
          listEl.classList.add('hidden');
          listEl.innerHTML = '';
        } else {
          listEl.classList.remove('hidden');
          listEl.innerHTML = `
            <div class="flex items-center justify-between py-1.5 px-2 rounded bg-slate-800/80 border border-slate-700/50 text-slate-200">
              <div class="flex items-center space-x-2 truncate min-w-0 flex-1">
                <i data-lucide="file-check-2" class="w-3.5 h-3.5 text-emerald-400 shrink-0"></i>
                <span class="truncate font-medium text-[11px]">${f.fileName}</span>
                <span class="text-[9px] px-1.5 py-0.5 rounded bg-slate-700/80 text-slate-300 shrink-0 uppercase font-mono border border-slate-600/40">${f.fileType}</span>
              </div>
              <button type="button" onclick="removeFile('${key}', 0)" class="text-slate-400 hover:text-red-400 text-xs px-1 font-bold ml-1 cursor-pointer" title="${bi('파일 삭제', 'Remove file')}">✕</button>
            </div>
          `;
          if (window.lucide) {
            lucide.createIcons();
          }
        }
      }

      if (wrapper && select) {
        if (f && f.fileType === 'excel' && f.workbook && f.workbook.SheetNames && f.workbook.SheetNames.length > 1) {
          wrapper.classList.remove('hidden');
          select.innerHTML = f.workbook.SheetNames.map(s =>
            `<option value="${s}" ${s === f.activeSheet ? 'selected' : ''}>${s} ${s === f.activeSheet ? bi('(자동선택: 최신)', '(auto: latest)') : ''}</option>`
          ).join('');

          // 여러 시트가 있는데 아직 사용자가 확인/선택하지 않았다면, 눈에 띄게 확인을 요청한다.
          // (자동 추정이 틀린 시트를 고를 수 있고, 그걸 그대로 분석하면 엉뚱한 시트에 표시가 찍힌다.)
          const warnId = `sheet-confirm-warn-${key}`;
          let warnEl = document.getElementById(warnId);
          if (!f.sheetConfirmed) {
            if (!warnEl) {
              warnEl = document.createElement('div');
              warnEl.id = warnId;
              warnEl.className = 'mt-1 flex items-center justify-between gap-2 text-[11px] text-amber-400 bg-amber-950/40 border border-amber-800/60 rounded px-2 py-1';
              wrapper.appendChild(warnEl);
            }
            warnEl.innerHTML = `
              <span>${bi('⚠️ 여러 시트 중 자동 선택된 시트입니다. 맞는지 확인해 주세요.', '⚠️ This sheet was auto-selected among several. Please confirm it is correct.')}</span>
              <button type="button" onclick="confirmActiveSheet('${key}')" class="shrink-0 px-1.5 py-0.5 rounded bg-amber-800/60 hover:bg-amber-700/70 text-amber-100 font-semibold">${bi('확인', 'Confirm')}</button>
            `;
          } else if (warnEl) {
            warnEl.remove();
          }
        } else {
          wrapper.classList.add('hidden');
          const warnEl = document.getElementById(`sheet-confirm-warn-${key}`);
          if (warnEl) warnEl.remove();
        }
      }
    }

    function onSheetChange(key) {
      const select = document.getElementById(`sheet-select-${key}`);
      if (docData[key] && docData[key].filesList && docData[key].filesList[0] && select) {
        docData[key].filesList[0].activeSheet = select.value;
        docData[key].filesList[0].sheetConfirmed = true; // 드롭다운을 직접 조작 = 사용자가 시트를 확인했다는 뜻
        updateDocUI(key);
      }
    }

    // "이 시트가 맞습니다" 버튼 등으로, 자동 추정값을 그대로 쓰기로 명시적으로 확인한 경우.
    function confirmActiveSheet(key) {
      if (docData[key] && docData[key].filesList && docData[key].filesList[0]) {
        docData[key].filesList[0].sheetConfirmed = true;
        updateDocUI(key);
      }
    }


    function sheetToMatrix(worksheet) {
      const range = XLSX.utils.decode_range(worksheet['!ref'] || 'A1');
      const matrix = [];

      for (let R = range.s.r; R <= range.e.r; ++R) {
        const row = [];
        for (let C = range.s.c; C <= range.e.c; ++C) {
          const cellAddress = XLSX.utils.encode_cell({ r: R, c: C });
          const cell = worksheet[cellAddress];
          row.push(cell ? String(cell.v).trim() : '');
        }
        matrix.push(row);
      }

      // ⚠️ worksheet['!merges']의 좌표(m.s.r/m.s.c 등)는 시트 전체 기준 "절대좌표"인데,
      // matrix 배열은 range.s.r/range.s.c를 0으로 삼는 "range 기준 상대좌표"로 만들어진다.
      // 시트의 실제 사용범위가 A1부터 시작하면(range.s.r===0, range.s.c===0) 절대좌표와
      // 상대좌표가 우연히 같아서 문제가 안 드러났지만, 이 스크류 점검일지처럼 B2부터
      // 시작하는 파일에서는 절대좌표를 그대로 matrix 인덱스로 써버리면 완전히 엉뚱한
      // 행/열의 값을 읽고 덮어써서(예: J7의 값이 아니라 H7 근처의 값이 잘못 복사됨),
      // "스크류 직경 규격"에 체크링 값이 섞여 들어가는 등의 오류가 났다.
      // 반드시 range.s.r/range.s.c를 빼서 상대좌표로 변환한 뒤 matrix에 접근해야 한다.
      if (worksheet['!merges']) {
        worksheet['!merges'].forEach(m => {
          const sr = m.s.r - range.s.r, sc = m.s.c - range.s.c;
          const er = m.e.r - range.s.r, ec = m.e.c - range.s.c;
          const topValue = matrix[sr] ? matrix[sr][sc] : '';
          if (topValue) {
            for (let R = sr; R <= er; ++R) {
              for (let C = sc; C <= ec; ++C) {
                if (matrix[R]) matrix[R][C] = topValue;
              }
            }
          }
        });
      }

      return matrix;
    }

    function cleanString(str) {
      if (!str) return '';
      let s = String(str).toLowerCase();

      s = s.replace(/[~\-ㅡ–—]/g, '~');
      s = s.replace(/[\s_(),./\\:;\[\]]/g, '');

      s = s.replace(/스위치/g, '센서');
      s = s.replace(/test/g, '점검');
      s = s.replace(/시험/g, '점검');
      s = s.replace(/검사/g, '점검');
      s = s.replace(/temp/g, '온도');
      s = s.replace(/press/g, '압력');
      s = s.replace(/torque/g, '토크');
      s = s.replace(/수축/g, '수링크');

      return s;
    }

    function cleanUnit(unitStr) {
      if (!unitStr) return '';
      const original = String(unitStr).trim();
      let u = original.toLowerCase();

      if (/^°c$|^℃$|^degc$|^도c$|^도$/i.test(u) || u.includes('°c') || u.includes('℃')) {
        return '℃';
      }

      if (/kgf?\/cm[2²]|kgf?\/㎠/i.test(u)) {
        return 'kg/㎠';
      }

      if (/m[3³]\/h/i.test(u)) {
        return 'm³/h';
      }

      if (u === 'bar') return 'bar';

      if (/^sec$|^s$|^초$/i.test(u) || u.includes('sec')) {
        return 'sec';
      }

      // 알려진 단위 패턴이 아니면(예: 'Etc', 'mm/s') 정규화하지 않고 원본 대소문자를
      // 그대로 살린다. 단, '/'나 '.'은 mm/s, kgf.cm처럼 단위 자체의 의미있는
      // 표기이므로 지우지 않고, 공백·괄호·쉼표 같은 장식성 문자만 제거한다.
      return original.trim().replace(/[\s\-_(),\\]/g, '');
    }

    function stripUnitFromSpecStr(specStr) {
      if (!specStr) return '';
      let s = String(specStr);
      s = s.replace(/kgf?\/cm[2²]/gi, '');
      s = s.replace(/kgf?\/㎠/gi, '');
      s = s.replace(/m[3³]\/h/gi, '');
      s = s.replace(/mm[2²]/gi, '');
      s = s.replace(/cm[2²]/gi, '');
      s = s.replace(/m[2²]/gi, '');
      s = s.replace(/kgf?\.cm/gi, '');
      s = s.replace(/bar|℃|°c|%|m\/s|m³|m3|l\/min|rpm|sec|초/gi, '');
      return s;
    }

    function parseIndexedKeyword(keyStr) {
      if (!keyStr) return { baseKey: '', cpIndex: 1, isIndexed: false };
      const m = String(keyStr).trim().match(/^(.*?)\s*(\d+)$/);
      if (m) {
        return { baseKey: m[1].trim(), cpIndex: parseInt(m[2], 10), isIndexed: true };
      }
      return { baseKey: String(keyStr).trim(), cpIndex: 1, isIndexed: false };
    }

    // 키워드 문자열에 "(Front)" / "(Rear)" 표기가 있으면 해당 라벨을 반환한다.
    function extractFrontRearLabelFromKeyword(text) {
      if (!text) return null;
      const m = String(text).match(/\(\s*(front|rear)\s*\)/i);
      return m ? m[1].toLowerCase() : null;
    }

    // 대상문서가 같은 항목을 "키워드 (Front)" / "키워드 (Rear)" 두 개의 행으로
    // 나눠 기록한 경우, 나머지 한쪽 행을 찾아 규격을 하나로 합쳐 반환한다.
    // (관리계획서 규격이 Front/Rear로 함께 표기돼 있을 때, 대상문서 쪽도
    //  Front/Rear가 둘 다 보이도록 짝을 맞춰주기 위함. 짝을 못 찾으면 null.)
    function mergeFrontRearTargetSpec(candidate, targetItems) {
      const label = extractFrontRearLabelFromKeyword(candidate.keyword || candidate.combinedKeyword);
      if (!label) return null;
      const otherLabel = label === 'front' ? 'rear' : 'front';
      const baseName = normalizeKeyword(String(candidate.keyword || candidate.combinedKeyword || '').replace(/\(\s*(front|rear)\s*\)/i, ''));
      const sibling = targetItems.find(t => {
        if (t === candidate) return false;
        const l = extractFrontRearLabelFromKeyword(t.keyword || t.combinedKeyword);
        if (l !== otherLabel) return false;
        const base2 = normalizeKeyword(String(t.keyword || t.combinedKeyword || '').replace(/\(\s*(front|rear)\s*\)/i, ''));
        return base2 === baseName;
      });
      if (!sibling) return null;
      const frontItem = label === 'front' ? candidate : sibling;
      const rearItem = label === 'front' ? sibling : candidate;
      return {
        keyword: String(candidate.keyword || candidate.combinedKeyword || '').replace(/\(\s*(front|rear)\s*\)/i, '').trim(),
        spec: `Front : ${frontItem.spec || '-'} / Rear : ${rearItem.spec || '-'}`,
        unit: frontItem.unit || rearItem.unit || ''
      };
    }

    function parseMultiLabelSpec(rawStr) {
      if (!rawStr) return [];
      const lines = String(rawStr).split(/[\r\n/]+/).map(s => s.trim()).filter(s => s.length > 0);
      const results = [];

      lines.forEach(line => {
        const m = line.match(/^([a-zA-Z가-힣0-9가-힇\s]+)\s*[:=]\s*(.+)$/);
        if (m) {
          const label = m[1].trim();
          const val = m[2].trim();
          results.push({ label: label, value: val });
        } else {
          results.push({ label: '', value: line });
        }
      });

      return results;
    }

    // Front/Rear처럼 한 셀에 두 개의 값이 "Front : 34/ Rear : 35" 형태로
    // 합쳐져 있는 경우, 각 라벨의 숫자를 분리해서 뽑아낸다.
    function parseFrontRearParts(str) {
      if (!str || isDashOrEmpty(str)) return null;
      const s = String(str);
      const frontMatch = s.match(/front\s*[:：]?\s*([-+]?\d+(?:\.\d+)?)/i);
      const rearMatch = s.match(/rear\s*[:：]?\s*([-+]?\d+(?:\.\d+)?)/i);
      if (!frontMatch && !rearMatch) return null;
      return {
        front: frontMatch ? parseFloat(frontMatch[1]) : null,
        rear: rearMatch ? parseFloat(rearMatch[1]) : null
      };
    }

    function formatCleanRangeSpec(rawLower, rawNominal, rawUpper) {
      // Front/Rear 복합 표기 감지: 하한/Nominal/상한 중 하나라도 "Front : n/ Rear : n"
      // 형태이면, Front와 Rear를 각각 별도의 하한~상한 범위로 조합해서
      // "Front : 34 ~ 44 / Rear : 35 ~ 45"처럼 두 값 모두가 보이도록 만든다.
      const frLower = parseFrontRearParts(rawLower);
      const frNominal = parseFrontRearParts(rawNominal);
      const frUpper = parseFrontRearParts(rawUpper);
      if (frLower || frNominal || frUpper) {
        const buildSide = (label, lo, nom, up) => {
          if (lo == null && nom == null && up == null) return '';
          const rangeStr = formatCleanRangeSpec(
            lo != null ? String(lo) : '',
            nom != null ? String(nom) : '',
            up != null ? String(up) : ''
          );
          return `${label} : ${rangeStr}`;
        };
        const frontStr = buildSide('Front', frLower ? frLower.front : null, frNominal ? frNominal.front : null, frUpper ? frUpper.front : null);
        const rearStr = buildSide('Rear', frLower ? frLower.rear : null, frNominal ? frNominal.rear : null, frUpper ? frUpper.rear : null);
        return [frontStr, rearStr].filter(Boolean).join(' / ') || '-';
      }

      const numLower = Number(rawLower);
      const numNominal = Number(rawNominal);
      const numUpper = Number(rawUpper);

      const hasNumLower = rawLower !== '' && !isDashOrEmpty(rawLower) && !isNaN(numLower);
      const hasNumNominal = rawNominal !== '' && !isDashOrEmpty(rawNominal) && !isNaN(numNominal);
      const hasNumUpper = rawUpper !== '' && !isDashOrEmpty(rawUpper) && !isNaN(numUpper);

      if (hasNumLower && hasNumUpper) {
        return `${rawLower} ~ ${rawUpper}`;
      } else if (hasNumLower && hasNumNominal) {
        return `${rawLower} ~ ${rawNominal}`;
      } else if (hasNumNominal && hasNumUpper) {
        return `${rawNominal} ~ ${rawUpper}`;
      } else if (hasNumNominal) {
        return rawNominal;
      } else if (hasNumUpper) {
        return rawUpper;
      } else if (hasNumLower) {
        return rawLower;
      }
      return rawNominal || rawLower || rawUpper || '-';
    }

    function formatCpSpecWithUnit(specStr, unitStr) {
      if (!specStr || isDashOrEmpty(specStr)) return '-';
      if (!unitStr || isDashOrEmpty(unitStr)) return specStr;
      const cleanU = cleanUnit(unitStr);
      if (!cleanU) return specStr;
      // 단순 포함(includes) 비교는 'kg/cm2' vs 'kg/㎠'처럼 표기만 다른
      // 동일 단위를 다르다고 오판해 단위가 중복 표기되는 문제가 있었음.
      // → 정규화된 단위끼리 비교해서 실제로 같은 단위인지 판단한다.
      const specUnitInText = normalizeUnitForComp(extractUnitFromText(specStr));
      const normCleanU = normalizeUnitForComp(cleanU);
      const specAlreadyHasUnit = specUnitInText && normCleanU && specUnitInText === normCleanU;
      if (!specAlreadyHasUnit) {
        return `${specStr} ${cleanU}`;
      }
      return specStr;
    }

    // "보압"(번호 없음, 암묵적 index=1)과 "보압2"(index=2)처럼 관리계획서에
    // 진짜로 짝을 이루는 인덱스 항목이 존재하는지 확인한다.
    // 짝이 있을 때만 대상문서의 "600 / 500" 같은 값을 인덱스에 맞춰 잘라내야 하며,
    // 짝 없는 단독 항목(예: Front/Rear 라벨이 규격 안에 들어있는 경우)은 자르면 안 된다.
    function hasIndexedSibling(fieldGetter, keyStr, cpParsedList) {
      const { baseKey } = parseIndexedKeyword(keyStr);
      if (!baseKey) return false;
      const normBase = normalizeKeyword(baseKey);
      let count = 0;
      cpParsedList.forEach(item => {
        const v = fieldGetter(item);
        if (!v || isDashOrEmpty(v)) return;
        const { baseKey: b } = parseIndexedKeyword(v);
        if (normalizeKeyword(b) === normBase) count++;
      });
      return count >= 2;
    }

    function extractTargetSpecForIndex(targetSpec, cpIndex) {
      if (!targetSpec) return targetSpec;
      const idx = (cpIndex && cpIndex > 0) ? cpIndex : 1;

      let specStr = String(targetSpec).trim();

      let tolStr = '';
      const tolMatch = specStr.match(/([±+-]{1,2}\s*\d+(\.\d+)?)/);
      if (tolMatch) {
        tolStr = tolMatch[1];
        specStr = specStr.replace(tolMatch[0], '').trim();
      }

      let unitStr = '';
      const unitRegex = /(kgf?\/cm[2²]|kgf?\/㎠|m[3³]\/h|mm\/s|l\/min|kgf?\.cm|bar|℃|°c|%|sec|초|kg|g|mm|cm|m)$/i;
      const unitMatch = specStr.match(unitRegex);
      if (unitMatch) {
        unitStr = unitMatch[1];
        specStr = specStr.replace(unitMatch[0], '').trim();
      }

      if (specStr.includes('/')) {
        const parts = specStr.split('/').map(p => p.trim()).filter(p => p.length > 0);
        if (idx <= parts.length) {
          let chosenVal = parts[idx - 1];
          chosenVal = chosenVal.replace(/^([a-zA-Z가-힣0-9\s]+)[:=]/, '').trim();

          let res = chosenVal;
          if (tolStr) res += ` ${tolStr}`;
          if (unitStr) res += ` ${unitStr}`;
          return res;
        }
      }

      return targetSpec;
    }

    function normalizeText(val) {
      if (val === null || val === undefined) return '';
      let s = String(val).normalize('NFKC');
      s = s.replace(/[★☆■●◆◇▲▼]/g, '');
      s = s.replace(/[\r\n\t]+/g, ' ');
      s = s.replace(/\s*\(\s*/g, '(').replace(/\s*\)\s*/g, ')');
      s = s.replace(/\s+/g, ' ');
      return s.trim().toLowerCase();
    }

    function normalizeKeyword(str) {
      return normalizeText(str);
    }

    function normalizeProductFeature(str) {
      if (!str) return '';
      let s = normalizeText(str);
      s = s.replace(/[\[\]()]/g, '');
      s = s.replace(/\s+/g, '');
      return s;
    }

    function getTargetDisplayKeyword(tItem) {
      if (!tItem) return '-';
      const cat = (tItem.category || '').trim();
      const key = (tItem.keyword || '').trim();

      if (key && key !== cat && cleanString(key) !== cleanString(cat)) {
        return key;
      }
      return key || cat || '-';
    }

    function checkExactKeywordMatch(cpKey, tItem, cpIdx) {
      if (!cpKey || !tItem) return false;
      const { baseKey } = parseIndexedKeyword(cpKey);
      const rawCp = baseKey || cpKey;
      const normCp = normalizeText(rawCp);
      if (!normCp) return false;

      // 대상문서 항목이 실제로 인덱스별로 나뉘어 있는 경우(targetIndex > 1)에만 인덱스 불일치를 이유로 거른다.
      // 대상문서가 단일 통합 항목(targetIndex 기본값 1)인 경우엔 키워드(베이스명)만으로 매칭을 허용하고,
      // 규격 값은 추후 extractTargetSpecForIndex()로 인덱스에 맞게 분리해서 비교한다.
      if (tItem.targetIndex && tItem.targetIndex > 1 && cpIdx && tItem.targetIndex !== cpIdx) {
        return false;
      }

      const normKey = normalizeText(tItem.keyword);
      const normCat = normalizeText(tItem.category);
      const normComb = normalizeText(tItem.combinedKeyword);

      if (normCp === normKey || normCp === normCat || normCp === normComb) {
        return true;
      }

      const stripCp = normCp.replace(/\s+/g, '');
      if (!stripCp) return false;

      const stripKey = normKey.replace(/\s+/g, '');
      const stripCat = normCat.replace(/\s+/g, '');
      const stripComb = normComb.replace(/\s+/g, '');

      if (stripCp === stripKey || stripCp === stripCat || stripCp === stripComb) {
        return true;
      }

      return false;
    }

    function calculateKeywordMatchScore(cpKey, targetStr) {
      if (!cpKey || !targetStr) return 0;

      const { baseKey } = parseIndexedKeyword(cpKey);
      const rawCpKey = baseKey || cpKey;

      const cleanCp = cleanString(rawCpKey);
      const cleanTarget = cleanString(targetStr);

      if (!cleanCp || !cleanTarget) return 0;
      if (cleanCp === cleanTarget) return 1.0;

      const rawCp = String(rawCpKey).toLowerCase().trim();
      const rawTarget = String(targetStr).toLowerCase().trim();
      if (rawCp === rawTarget) return 1.0;

      if (cleanTarget.includes(cleanCp) || cleanCp.includes(cleanTarget)) {
        const minLen = Math.min(cleanCp.length, cleanTarget.length);
        const maxLen = Math.max(cleanCp.length, cleanTarget.length);
        const ratio = minLen / maxLen;
        return Math.min(0.88, Math.max(0.70, ratio * 0.90));
      }

      const cpTokens = String(rawCpKey).toLowerCase().split(/[\s\-_(),./\\]+/).filter(t => t.length > 1);
      const targetTokens = String(targetStr).toLowerCase().split(/[\s\-_(),./\\]+/).filter(t => t.length > 1);

      if (cpTokens.length > 0 && targetTokens.length > 0) {
        const matchedTokens = targetTokens.filter(t =>
          cpTokens.some(c => cleanString(c) === cleanString(t) || cleanString(c).includes(cleanString(t)) || cleanString(t).includes(cleanString(c)))
        );

        const isOnlyGenericSuffix = matchedTokens.length === 1 && /^(거리|온도|압력|시간|속도|치수|위치|상태|점검|모니터링)$/i.test(cleanString(matchedTokens[0]));

        if (isOnlyGenericSuffix && targetTokens.length > 1) {
          return 0.20;
        }

        const targetRatio = matchedTokens.length / targetTokens.length;
        const cpRatio = matchedTokens.length / cpTokens.length;

        if (targetRatio >= 0.70 || cpRatio >= 0.70) {
          return Math.min(0.88, Math.max(targetRatio, cpRatio) * 0.90);
        }
      }

      return 0;
    }

    function compareStrings(s1, s2) {
      const n1 = normalizeText(s1);
      const n2 = normalizeText(s2);
      if (!n1 && !n2) return true;
      if (n1 === n2) return true;
      return n1.replace(/\s+/g, '') === n2.replace(/\s+/g, '');
    }

    function compareNominal(n1, n2) {
      const c1 = normalizeText(n1);
      const c2 = normalizeText(n2);
      if (!c1 && !c2) return true;
      if (c1 === c2) return true;
      // 띄어쓰기 차이만 있는 경우(예: "없을 것" vs "없을것")는 동일 문자로 처리
      if (c1.replace(/\s+/g, '') === c2.replace(/\s+/g, '')) return true;

      const num1 = c1.match(/\d+(\.\d+)?/);
      const num2 = c2.match(/\d+(\.\d+)?/);
      if (num1 && num2 && Math.abs(Number(num1[0]) - Number(num2[0])) < 0.01) {
        return true;
      }
      return false;
    }

    function isBlankValue(val) {
      if (val === null || val === undefined) return true;
      const s = String(val).trim();
      if (s === '' || s === '-' || s === '--' || s === 'None' || s === 'NaN' || s === 'N/A' || s === '없음' || s === '미기재') return true;
      return false;
    }

    function normalizeValueForComp(val) {
      if (isBlankValue(val)) return '';
      let s = String(val).trim();
      // 숫자 정규화 (11.9 == 11.90, 8 == 8.0)
      const numMatch = s.match(/^[-+]?\d+(\.\d+)?$/);
      if (numMatch) {
        return String(parseFloat(s));
      }
      // 텍스트 값은 띄어쓰기/대소문자 차이를 무시하고 비교
      // (예: "없을 것" == "없을것", "V/CO" == "v/co")
      return normalizeText(s).replace(/\s+/g, '');
    }

    function normalizeUnitForComp(unitStr) {
      if (!unitStr || isBlankValue(unitStr)) return '';
      let u = String(unitStr).trim().toLowerCase();
      // 위첨자 ³·² 표기와 일반 숫자 3·2 표기(m³/h ↔ m3/h, cm²  ↔ cm2 등)를
      // 같은 단위로 인식하도록 먼저 통일한다.
      u = u.replace(/³/g, '3').replace(/²/g, '2');
      // 관리계획서 단위 셀에 "10shot"처럼 수량이 단위 앞에 실수로 붙어 입력된
      // 경우, 앞의 숫자를 떼어내고 순수 단위만 남긴다("10shot" → "shot").
      u = u.replace(/^\d+(\.\d+)?\s*/, '');
      if (u === '㎜' || u === 'mm') return 'mm';
      if (u === '℃' || u === '°c' || u === 'degc') return '℃';
      if (u.includes('kg') && (u.includes('cm') || u.includes('㎠'))) return 'kg/cm2';
      if (u === 'mpa') return 'mpa';
      if (u === 'shot' || u === 'shots') return 'shot';
      return u.replace(/[\s\-_(),./\\]/g, '');
    }

    // 키워드가 일치한 "이후" 규격/단위가 실제로 일치하는지 검증하는 함수
    // (검사표준서 외 문서: 설비일상점검표/스크류점검일지/작업조건기록지/퍼징 작업지도서 등 범용 규격 비교용)
    function extractUnitFromText(text) {
      if (!text) return '';
      const match = String(text).match(/(kgf?\/cm[2²]|kgf?\/㎠|kgf?\.cm|kg\/cm[2²]|kg\/㎠|bar|MPa|Pa|Hz|m³\/h|m3\/h|㎥\/h|m³|m3|㎥|l\/min|mm\/s|cm\/s|m\/s|shot|mm|cm|m|sec|초|s|%|rpm|ea|℃|°c|degc|V|A)/i);
      return match ? match[0] : '';
    }

    // Front/Rear 등으로 나뉜 복합 규격 텍스트("Front : 34 ~ 44 / Rear : 35 ~ 45",
    // "Front : 35 / Rear : 40 ± 5" 등)에서 Front·Rear 각각의 허용 범위를 추출한다.
    // Front/Rear 패턴이 없으면 null을 반환해 기존 단일 범위 비교 로직으로 넘어간다.
    function extractFrontRearRange(text) {
      if (!text) return null;
      const s = String(text);

      // 전체 문자열에 공통으로 적용되는 공차(± n)를 먼저 찾는다.
      // (예: "Front : 35 / Rear : 40 ± 5" → Front·Rear 양쪽 모두에 ±5 적용)
      let globalTol = null;
      const tolMatch = s.match(/(?:±|\+\/-|\+-)\s*(\d+(?:\.\d+)?)/);
      if (tolMatch) globalTol = parseFloat(tolMatch[1]);

      const parseSide = (label) => {
        const re = new RegExp(label + '\\s*[:：]?\\s*([-+]?\\d+(?:\\.\\d+)?)(?:\\s*~\\s*([-+]?\\d+(?:\\.\\d+)?))?', 'i');
        const m = s.match(re);
        if (!m) return null;
        const v1 = parseFloat(m[1]);
        if (m[2] !== undefined) {
          const v2 = parseFloat(m[2]);
          return { min: Math.min(v1, v2), max: Math.max(v1, v2) };
        }
        if (globalTol !== null) {
          return { min: v1 - globalTol, max: v1 + globalTol };
        }
        return { min: v1, max: v1 };
      };

      const front = parseSide('front');
      const rear = parseSide('rear');
      if (!front && !rear) return null;
      return { front, rear };
    }

    function extractNumericRange(text) {
      if (!text) return null;
      const str = String(text);

      // "±" 표기(예: 250 ± 5, 22.6±1) → 중심값 ± 공차를 실제 범위로 환산
      // ※ 반드시 단위 텍스트(Kg/cm2 등)에 포함된 숫자보다 먼저 매칭되도록 별도 처리
      const pmMatch = str.match(/([-+]?\d+(?:\.\d+)?)\s*(?:±|\+\/-|\+-)\s*(\d+(?:\.\d+)?)/);
      if (pmMatch) {
        const nominal = parseFloat(pmMatch[1]);
        const tol = parseFloat(pmMatch[2]);
        if (!isNaN(nominal) && !isNaN(tol)) {
          return {
            min: Math.min(nominal - tol, nominal + tol),
            max: Math.max(nominal - tol, nominal + tol)
          };
        }
      }

      const nums = str.match(/[-+]?\d+(\.\d+)?/g);
      if (!nums) return null;
      const parsed = nums.map(Number).filter(n => !isNaN(n));
      if (parsed.length === 0) return null;
      return {
        min: Math.min(...parsed),
        max: Math.max(...parsed)
      };
    }

    function verifySpecAndUnitMatch(cpItem, tItem) {
      const cpSpecStr = cpItem.spec || '';
      const tSpecStr = tItem.spec || tItem.specification || '';

      const cpUnit = (!isDashOrEmpty(cpItem.unit)) ? cpItem.unit : extractUnitFromText(cpSpecStr);
      const tUnit = (!isDashOrEmpty(tItem.unit)) ? tItem.unit : extractUnitFromText(tSpecStr);

      const normCpUnit = normalizeUnitForComp(cpUnit);
      const normTUnit = normalizeUnitForComp(tUnit);

      const cpNums = extractNumericRange(cpSpecStr);
      const tNums = extractNumericRange(tSpecStr);

      // Front/Rear처럼 한 항목에 두 개의 값이 같이 들어있는 경우,
      // 두 값을 뒤섞어 하나의 범위로 비교하면 엉뚱한 결과가 나오므로
      // Front·Rear 각각을 독립적으로 비교한다.
      const cpFR = extractFrontRearRange(cpSpecStr);
      const tFR = extractFrontRearRange(tSpecStr);

      let numMatch = false;
      let frDetailNote = null;
      if (cpFR && (cpFR.front || cpFR.rear)) {
        const EPS = 0.01;
        const sideResults = [];
        let allSidesOk = true;
        ['front', 'rear'].forEach(sideKey => {
          const cpRange = cpFR[sideKey];
          if (!cpRange) return; // 관리계획서에 해당 항목 없으면 비교 생략
          const tRange = tFR ? tFR[sideKey] : null;
          const label = sideKey === 'front' ? 'Front' : 'Rear';
          if (!tRange) {
            allSidesOk = false;
            sideResults.push(`${label} - 관리계획서 [${cpRange.min}~${cpRange.max}] vs 대상문서 [미기재] (불일치)`);
            return;
          }
          const ok = (tRange.min >= cpRange.min - EPS) && (tRange.max <= cpRange.max + EPS);
          if (!ok) allSidesOk = false;
          sideResults.push(`${label} - 관리계획서 [${cpRange.min}~${cpRange.max}] vs 대상문서 [${tRange.min}~${tRange.max}] (${ok ? '일치' : '불일치'})`);
        });
        numMatch = allSidesOk;
        frDetailNote = sideResults.join(' / ');
      } else if (cpNums && tNums) {
        const EPS = 0.01;
        // 대상문서의 실제 규격(min~max)이 관리계획서 허용범위(min~max) 안에 포함되면 일치로 판정.
        // (예: 관리계획서 240~260, 대상문서 250±5=245~255 → 허용범위 내에 있으므로 정상)
        numMatch = (tNums.min >= cpNums.min - EPS) && (tNums.max <= cpNums.max + EPS);
      } else if (!cpNums && !tNums) {
        numMatch = compareStrings(cpSpecStr, tSpecStr);
      } else {
        numMatch = compareNominal(cpSpecStr, tSpecStr);
      }

      const hasCpUnit = Boolean(normCpUnit);
      const hasTUnit = Boolean(normTUnit);
      const unitMatch = (!hasCpUnit && !hasTUnit) || (normCpUnit === normTUnit);

      if (numMatch && !unitMatch) {
        return {
          status: 'MISMATCH (단위)',
          detailNote: `⚠️ [단위 불일치] 키워드는 일치했으나 단위가 다릅니다. (관리계획서: '${cpUnit || '미기재'}' vs 대상문서: '${tUnit || '미기재'}')`
        };
      }

      if (!numMatch) {
        return {
          status: 'MISMATCH',
          detailNote: frDetailNote
            ? `❌ [규격 불일치] 키워드는 일치했으나 규격이 다릅니다. ${frDetailNote}`
            : `❌ [규격 불일치] 키워드는 일치했으나 규격이 다릅니다. 관리계획서 [${cpSpecStr || '-'}] vs 대상문서 [${tSpecStr || '-'}]`
        };
      }

      return {
        status: 'MATCH',
        detailNote: '키워드 및 규격/단위 100% 일치 (Pass)'
      };
    }

    // 1. 표시 기호 판정 함수 (extractCycleFlags 바로 위에 추가)
    function isMarkedSymbol(val) {
      if (!val || isBlankValue(val)) return false;
      const clean = String(val).trim().toUpperCase();
      const markedSigns = ['X', 'ⓧ', 'Ⓧ', 'O', 'V', '1', 'TRUE', '표시'];
      return markedSigns.includes(clean) || markedSigns.some(sign => clean.includes(sign));
    }

    // 2. 주기 추출 함수
    function extractCycleFlags(row, freqCols, mainFreqText) {
      const cycle = { S1: false, S2: false, C: false, I: false, E: false, etc: false };

      let checkedInCols = false;
      if (freqCols) {
        ['S1', 'S2', 'C', 'I', 'E', 'etc'].forEach(k => {
          const c = freqCols[k];
          if (c !== undefined && c !== -1 && Array.isArray(row) && c < row.length) {
            const val = String(row[c] || '').trim();

            // 👈 요 부분만 수정됨!
            if (isMarkedSymbol(val)) {
              cycle[k] = true;
              checkedInCols = true;
            }

          }
        });
      }

      if (!checkedInCols && mainFreqText) {
        const clean = String(mainFreqText).toUpperCase();
        if (/\bS1\b|S1/i.test(clean)) cycle.S1 = true;
        if (/\bS2\b|S2/i.test(clean)) cycle.S2 = true;
        if (/\bC\b|C\b/i.test(clean)) cycle.C = true;
        if (/\bI\b|I\b/i.test(clean)) cycle.I = true;
        if (/\bE\b|E\b/i.test(clean)) cycle.E = true;
        if (/\bETC\b|기타/i.test(clean)) cycle.etc = true;
      }

      return cycle;
    }

    function formatCycleDisplayText(freqObj) {
      if (!freqObj) return '-';
      const active = [];
      if (freqObj.S1) active.push('S1');
      if (freqObj.S2) active.push('S2');
      if (freqObj.C) active.push('C');
      if (freqObj.I) active.push('I');
      if (freqObj.E) active.push('E');
      if (freqObj.etc) active.push('etc');

      return active.length > 0 ? active.join(', ') : '-';
    }

    function verifyInspectionStandardMatch(cpItem, tItem) {
      const paramResults = [];

      function checkParam(name, cpVal, tVal, compType = 'text') {
        let isMatch = false;
        if (compType === 'number') {
          const normCp = normalizeValueForComp(cpVal);
          const normT = normalizeValueForComp(tVal);
          isMatch = (normCp === normT);
        } else if (compType === 'unit') {
          const normCp = normalizeUnitForComp(cpVal);
          const normT = normalizeUnitForComp(tVal);
          isMatch = (normCp === normT);
        } else if (compType === 'boolean') {
          isMatch = (Boolean(cpVal) === Boolean(tVal));
        } else {
          const normCp = normalizeValueForComp(cpVal);
          const normT = normalizeValueForComp(tVal);
          isMatch = (normCp === normT);
        }

        const cpDisp = isBlankValue(cpVal) ? '-' : String(cpVal).trim();
        const tDisp = isBlankValue(tVal) ? '-' : String(tVal).trim();

        paramResults.push({
          param: name,
          cpVal: cpDisp,
          tVal: tDisp,
          status: isMatch ? 'MATCH' : 'MISMATCH'
        });

        return isMatch;
      }

      checkParam('제품특성', cpItem.productChar, tItem.productChar || tItem.keyword);
      checkParam('검사구분', cpItem.inspectionClass, tItem.inspectionClass);
      checkParam('규격하한', cpItem.lower, tItem.lower, 'number');
      checkParam('Nominal', cpItem.nominal, tItem.nominal, 'number');
      checkParam('규격상한', cpItem.upper, tItem.upper, 'number');
      checkParam('단위', cpItem.unit, tItem.unit, 'unit');
      checkParam('평가/측정방법', cpItem.evalMethod, tItem.evalMethod);
      checkParam('크기', cpItem.sampleSize, tItem.sampleSize, 'number');

      const cpCycle = cpItem.freqObj || { S1: false, S2: false, C: false, I: false, E: false, etc: false };
      const tCycle = tItem.freqObj || { S1: false, S2: false, C: false, I: false, E: false, etc: false };

      ['S1', 'S2', 'C', 'I', 'E', 'etc'].forEach(k => {
        const cpFlag = Boolean(cpCycle[k]);
        const tFlag = Boolean(tCycle[k]);
        const isMatch = (cpFlag === tFlag);
        paramResults.push({
          param: `${k} 주기`,
          cpVal: cpFlag ? '표시' : '미표시',
          tVal: tFlag ? '표시' : '미표시',
          status: isMatch ? 'MATCH' : 'MISMATCH'
        });
      });

      const overallMatch = paramResults.every(p => p.status === 'MATCH');

      const cpProduct = cpItem.productChar || cpItem.processChar || '';
      const notes = [`[검사표준서] 제품특성 '${cpProduct}' 매칭 성공`];
      paramResults.forEach(p => {
        if (p.status === 'MATCH') {
          notes.push(`→ ${p.param} 일치`);
        } else {
          notes.push(`→ ${p.param} 불일치 (관리계획서: ${p.cpVal} / 검사표준서: ${p.tVal})`);
        }
      });
      notes.push(`\n최종 판정: ${overallMatch ? 'MATCH' : 'MISMATCH'}`);

      const targetSpecSummary = `${tItem.productChar || tItem.keyword}
검사구분: ${isBlankValue(tItem.inspectionClass) ? '-' : tItem.inspectionClass}
규격: ${formatCleanRangeSpec(tItem.lower, tItem.nominal, tItem.upper)} ${tItem.unit || ''}
Nominal: ${isBlankValue(tItem.nominal) ? '-' : tItem.nominal}
평가방법: ${isBlankValue(tItem.evalMethod) ? '-' : tItem.evalMethod}
크기: ${isBlankValue(tItem.sampleSize) ? '-' : tItem.sampleSize}
주기: ${formatCycleDisplayText(tItem.freqObj)}`.trim();

      return {
        isMatch: overallMatch,
        paramResults: paramResults,
        detailNote: notes.join('\n'),
        targetDisplaySpec: targetSpecSummary
      };
    }

    function extractKeywordAndSpecFromOcrLine(lineStr) {
      let line = String(lineStr || '').trim();
      if (!line || /^---\s*Page|^Uploaded File/i.test(line)) {
        return { keyword: '', spec: '', unit: '' };
      }

      line = line.replace(/^(?:\d+[\.\)]|\[\d+\]|\*|-)\s*/, '');

      let keyword = '';
      let spec = '';
      let unit = '';

      const colonIdx = line.search(/[:;=]/);
      if (colonIdx > 0 && colonIdx < line.length - 1) {
        keyword = line.substring(0, colonIdx).trim();
        spec = line.substring(colonIdx + 1).trim();
      } else {
        const specRegex = /((?:MAX|MIN|약)?\s*[\d.]+\s*(?:[~:~-]|±|~|\+\/-)?\s*[\d.]*\s*(?:℃|도|C|c|bar|kgf?\/cm[2²]?|kg|g|mm|cm|m|sec|초|s|%|RPM|rpm|EA|ea|MPa|Pa|V|A|Hz)?)/i;
        const match = line.match(specRegex);
        if (match && match.index > 0) {
          keyword = line.substring(0, match.index).trim();
          spec = line.substring(match.index).trim();
        } else {
          keyword = line;
          spec = '-';
        }
      }

      keyword = keyword.replace(/^[\d.\s\-_()]+/, '').replace(/[:;=-]+$/, '').trim();

      const unitMatch = spec.match(/(℃|도|bar|kgf?\/cm[2²]?|kg|g|mm|cm|m|sec|초|s|%|RPM|rpm|EA|ea|MPa|Pa|V|A|Hz)/i);
      if (unitMatch) {
        unit = unitMatch[0];
      }

      return { keyword: keyword || line, spec: spec || '-', unit: unit };
    }

    function parseInspectionStandardDoc(matrix) {
      if (!matrix || matrix.length === 0) return [];

      // 1. 백엔드 공통 문서 구조(객체 배열) 수신 시 처리
      if (typeof matrix[0] === 'object' && !Array.isArray(matrix[0]) && matrix[0].keyword !== undefined) {
        return matrix.map(item => ({
          productChar: item.keyword || '',
          keyword: item.keyword || '',
          category: '',
          combinedKeyword: item.keyword || '',
          inspectionClass: '',
          nominal: item.specification || '-',
          evalMethod: '',
          sampleSize: '',
          freqObj: { is100Percent: false, frequencyText: '-' },
          spec: item.specification || '-',
          unit: item.unit || '',
          targetIndex: 1
        }));
      }

      // 2. Excel 및 구조화된 테이블 2D Matrix 파싱
      const maxColsInMatrix = Math.max(...matrix.map(r => Array.isArray(r) ? r.length : 0));

      let headerIdx = -1;
      let colProdChar = -1, colInspectionClass = -1, colNominal = -1, colEvalMethod = -1, colSampleSize = -1, colLowerIdx = -1, colUpperIdx = -1, colUnitIdx = -1;
      let freqCols = { S1: -1, S2: -1, C: -1, I: -1, E: -1, etc: -1 };

      for (let r = 0; r < Math.min(20, matrix.length); r++) {
        const row = matrix[r];
        if (!Array.isArray(row)) continue;
        row.forEach((cell, c) => {
          const val = String(cell).replace(/\s+/g, '').toLowerCase();

          if ((val.includes('제품특성') || val.includes('검사항목') || val.includes('점검항목')) && colProdChar === -1) {
            colProdChar = c;
            headerIdx = r;
          }
          if ((val.includes('검사구분') || val.includes('공시구분') || val.includes('특성구분') || val.includes('특별특성')) && colInspectionClass === -1) {
            colInspectionClass = c;
          }

          if ((val.includes('규격하한') || val === '하한' || val === 'min') && colLowerIdx === -1) {
            colLowerIdx = c;
          }
          if ((val === 'nominal' || val.includes('nominal') || val.includes('norminal') || val.includes('노미널') || val.includes('노미날') || val === '기준치') && colNominal === -1) {
            colNominal = c;
          }
          if ((val.includes('규격상한') || val === '상한' || val === 'max') && colUpperIdx === -1) {
            colUpperIdx = c;
          }
          if ((val === '단위' || val.includes('단위')) && colUnitIdx === -1) {
            colUnitIdx = c;
          }

          if ((val.includes('평가/측정방법') || val.includes('측정방법') || val.includes('평가방법') || val.includes('검사방법')) && colEvalMethod === -1) {
            colEvalMethod = c;
          }
          if ((val.includes('크기') || val.includes('샘플크기') || val.includes('샘플링')) && colSampleSize === -1) {
            colSampleSize = c;
          }

          // 👇 이 영역(주기 헤더 열 매핑)을 추가하세요
          if (val === 's1' && freqCols.S1 === -1) freqCols.S1 = c;
          if (val === 's2' && freqCols.S2 === -1) freqCols.S2 = c;
          if (val === 'c' && freqCols.C === -1) freqCols.C = c;
          if (val === 'i' && freqCols.I === -1) freqCols.I = c;
          if (val === 'e' && freqCols.E === -1) freqCols.E = c;
          if ((val === 'etc' || val === '기타') && freqCols.etc === -1) freqCols.etc = c;
        });
      }

      const items = [];

      // 2-A. 단일 열/비구조화 OCR 텍스트 라인 파싱 Fallback
      if (maxColsInMatrix <= 2 && colProdChar === -1 && colNominal === -1) {
        matrix.forEach((row) => {
          if (!Array.isArray(row)) return;
          const fullLine = row.join(' ').trim();
          if (!fullLine || fullLine.length < 2) return;
          if (/^---\s*Page|^Uploaded File|GMT\+|한국\s*표준시|Moelx|Molex|Ansan/i.test(fullLine)) return;

          const parsed = extractKeywordAndSpecFromOcrLine(fullLine);
          if (parsed.keyword) {
            items.push({
              productChar: parsed.keyword,
              keyword: parsed.keyword,
              category: 'OCR',
              combinedKeyword: parsed.keyword,
              inspectionClass: '',
              nominal: parsed.spec,
              evalMethod: '',
              sampleSize: '',
              freqObj: { is100Percent: false, frequencyText: '-' },
              spec: parsed.spec,
              unit: parsed.unit,
              targetIndex: 1
            });
          }
        });
        return items;
      }

      if (headerIdx === -1) headerIdx = 0;
      if (colProdChar === -1) colProdChar = 0;

      for (let r = headerIdx + 1; r < matrix.length; r++) {
        const row = matrix[r];
        if (!Array.isArray(row) || row.length === 0) continue;

        const prodChar = String(row[colProdChar] || '').trim();
        if (isDashOrEmpty(prodChar) || /제품특성|검사항목|점검항목|구분|규격|Nominal|Page|GMT\+|한국\s*표준시|Molex|Ansan|Duraclik/i.test(prodChar)) {
          continue;
        }

        const inspectionClass = (colInspectionClass !== -1 && row[colInspectionClass] !== undefined) ? String(row[colInspectionClass]).trim() : '';
        const nominal = (colNominal !== -1 && row[colNominal] !== undefined) ? String(row[colNominal]).trim() : '';
        const evalMethod = (colEvalMethod !== -1 && row[colEvalMethod] !== undefined) ? String(row[colEvalMethod]).trim() : '';
        const sampleSize = (colSampleSize !== -1 && row[colSampleSize] !== undefined) ? String(row[colSampleSize]).trim() : '';
        const lower = (colLowerIdx !== -1 && row[colLowerIdx] !== undefined) ? String(row[colLowerIdx]).trim() : '';
        const upper = (colUpperIdx !== -1 && row[colUpperIdx] !== undefined) ? String(row[colUpperIdx]).trim() : '';
        const unit = (colUnitIdx !== -1 && row[colUnitIdx] !== undefined) ? String(row[colUnitIdx]).trim() : '';

        const freqFlags = extractCycleFlags(row, freqCols, '');

        items.push({
          productChar: prodChar,
          keyword: prodChar,
          category: '',
          combinedKeyword: prodChar,
          inspectionClass: inspectionClass,
          lower: lower,
          nominal: nominal,
          upper: upper,
          unit: unit,
          evalMethod: evalMethod,
          sampleSize: sampleSize,
          freqObj: freqFlags,
          spec: formatCleanRangeSpec(lower, nominal, upper),
          targetIndex: 1,
          // "키워드 텍스트 재검색" 없이 원본 셀 위치를 바로 짚어내기 위한 좌표 정보.
          __rowMeta: matrix.__rowMeta ? matrix.__rowMeta[r] : { fileIdx: 0, localRow: r },
          __colKey: colProdChar,
          __colLower: colLowerIdx,
          __colNominal: colNominal,
          __colUpper: colUpperIdx
        });
      }

      return items;
    }

    function getMatrixFromDocData(key) {
      const item = docData[key];
      if (!item) return [];

      const filesList = (item.filesList && item.filesList.length > 0) ? item.filesList : [];
      if (filesList.length === 0) return [];

      const combinedMatrix = [];
      // 각 행이 실제로 어느 파일의 몇 번째 행에서 왔는지 추적한다.
      // (여러 파일이 합쳐질 때, "키워드 재검색" 없이 원본 셀 위치를 정확히 되짚기 위함)
      const rowMeta = [];
      filesList.forEach((fileItem, fileIdx) => {
        if (fileItem.fileType === 'excel' && fileItem.workbook && fileItem.activeSheet) {
          const sheet = fileItem.workbook.Sheets[fileItem.activeSheet];
          const m = sheetToMatrix(sheet);
          if (m && m.length > 0) {
            m.forEach((row, localRow) => {
              combinedMatrix.push(row);
              rowMeta.push({ fileIdx, localRow });
            });
          }
        }
      });
      combinedMatrix.__rowMeta = rowMeta;

      return combinedMatrix;
    }

    const REQUIRED_DOCS = [
      { key: 'cp', name: '관리계획서' },
      { key: 'is', name: '검사표준서' },
      { key: 'eq', name: '설비일상점검표' },
      { key: 'sc', name: '스크류 점검일지' },
      { key: 'wc', name: '작업조건기록지' },
      { key: 'pg', name: '퍼징 작업지도서' },
      { key: 'dd', name: '제습건조기 사용 관리 기준서' }
    ];

    function isDocUploaded(key) {
      const item = docData[key];
      if (!item) return false;
      if (item.filesList && item.filesList.length > 0) return true;
      if (item.fileName || item.workbook) return true;
      return false;
    }

    function parseControlPlan(matrix) {
      if (!matrix || matrix.length === 0) return [];

      // 백엔드 공통 문서 구조(객체 배열) 수신 시 예외 처리
      if (typeof matrix[0] === 'object' && !Array.isArray(matrix[0]) && matrix[0].keyword !== undefined) {
        return matrix.map(item => ({
          processName: '공정',
          productChar: item.keyword || '',
          processChar: item.keyword || '',
          workElem: '',
          spec: item.specification || '-',
          lower: item.lower || '',
          nominal: item.nominal || '',
          upper: item.upper || '',
          unit: item.unit || '',
          rawMethod: '검사표준서',
          inspectionClass: '',
          evalMethod: '',
          sampleSize: '',
          freqObj: { is100Percent: false, frequencyText: '-' }
        }));
      }

      let headerIdx = -1;
      let colProcess = -1, colProdChar = -1, colK1 = -1, colK2 = -1;
      let colLower = -1, colNominal = -1, colUpper = -1, colUnit = -1, colMethod = -1, colStandard = -1;
      let colInspectionClass = -1, colEvalMethod = -1, colSampleSize = -1;
      let freqCols = { S1: -1, S2: -1, C: -1, I: -1, E: -1, etc: -1, mainFreq: -1 };
      let colSpecHeader = -1;

      for (let r = 0; r < Math.min(20, matrix.length); r++) {
        const row = matrix[r];
        if (!Array.isArray(row)) continue;

        // 이 행을 처리하기 "전" 상태를 스냅샷 떠둔다. 관리계획서 헤더는 보통 2~3줄에
        // 걸쳐 있고(예: 8행=상위 라벨, 9행=하위 라벨, 10행=S1/S2/... 라벨), 각 줄마다
        // 서로 다른 헤더 필드가 새로 발견된다. "이 행에서 뭔가 새로 발견됐는지"를
        // 전/후 비교로 판단해야, 헤더가 몇 줄짜리든 정확히 마지막 헤더 행까지만
        // headerIdx로 잡을 수 있다.
        const beforeSnapshot = JSON.stringify([
          colProcess, colProdChar, colK1, colK2, colInspectionClass, colEvalMethod, colSampleSize,
          colSpecHeader, colLower, colNominal, colUpper, colUnit, colMethod, colStandard,
          freqCols.S1, freqCols.S2, freqCols.C, freqCols.I, freqCols.E, freqCols.etc, freqCols.mainFreq
        ]);

        row.forEach((cell, c) => {
          const val = String(cell).replace(/\s+/g, '').toLowerCase();

          if ((/공정단계명|작업설명|공정명/i.test(val) || val === '공정') && colProcess === -1) colProcess = c;
          if (val.includes('제품특성') && colProdChar === -1) colProdChar = c;
          if (val.includes('공정특성') && colK1 === -1) colK1 = c;
          if (val.includes('작업요소') && colK2 === -1) colK2 = c;

