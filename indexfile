            <td class="p-3 font-medium text-slate-200">${displayTargetDoc}</td>
            <td class="p-3">
              <div class="font-semibold text-blue-300">${r.chosenKeyword}</div>
              <div class="text-[10px] text-slate-500">${typePrefix} ${displayChosenType} (${r.simPercent}%)</div>
            </td>
            <td class="p-3 font-mono text-slate-200 bg-slate-900/30 rounded">${r.cpSpec || '-'}</td>
            <td class="p-3">
              <div class="text-slate-300 font-medium">${r.targetKeyword}</div>
              <div class="font-mono text-amber-300/90 text-[11px] bg-slate-900/30 rounded leading-relaxed">${formattedTargetSpec}</div>
            </td>
            <td class="p-3 text-slate-400 text-[11px] leading-relaxed">
              <div>${formattedDetailNote}</div>
              ${paramTableHtml}
            </td>
