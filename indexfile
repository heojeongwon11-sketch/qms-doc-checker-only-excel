          upper: item.upper || '',
          unit: item.unit || '',
          inspectionCycle: item.inspection_cycle || '-',
          sourcePage: item.source_page || 1,
          confidence: item.confidence || 1.0,
          targetIndex: 1
        }));
      }

      const items = [];
      let headerIdx = -1;
      let colCat = -1, colKey = -1, colSpec = -1, colTol = -1, colUnit = -1;

      // 헤더 탐색 (해당 행에서 헤더를 처음 발견했을 때만 headerIdx 지정)
      for (let r = 0; r < Math.min(20, matrix.length); r++) {
        const row = matrix[r];
        if (!row) continue;

        let matchedInThisRow = false;
        row.forEach((cell, c) => {
          const val = String(cell).replace(/\s+/g, '').toLowerCase();
          if ((val.includes('구분') || val.includes('분류') || val.includes('공정명')) && colCat === -1) colCat = c;
          if ((val.includes('점검항목') || val.includes('검사항목') || val.includes('작업조건') || val.includes('항목명') || val.includes('점검내용') || val.includes('점검사항')) && colKey === -1) {
            colKey = c;
            matchedInThisRow = true;
          }
          if ((val.includes('규격') || val.includes('관리기준') || val.includes('점검기준')) && colSpec === -1) {
            colSpec = c;
            matchedInThisRow = true;
          }
          if ((val.includes('공차') || val.includes('허용차')) && colTol === -1) colTol = c;
          if ((val.includes('단위') || val.includes('unit')) && colUnit === -1) colUnit = c;
        });

        //  처음 매칭된 헤더 행 위치만 저장하도록 수정
        if (matchedInThisRow && headerIdx === -1) {
          headerIdx = r;
        }
      }

      if (headerIdx === -1) headerIdx = 0;

      // 데이터 행 읽기
      for (let r = headerIdx + 1; r < matrix.length; r++) {
        const row = matrix[r];
        if (!row || row.length === 0) continue;

        let keyword = (colKey !== -1 && colKey < row.length && row[colKey]) ? String(row[colKey]).trim() : '';
        let spec = (colSpec !== -1 && colSpec < row.length && row[colSpec]) ? String(row[colSpec]).trim() : '';
        let tol = (colTol !== -1 && colTol < row.length && row[colTol]) ? String(row[colTol]).trim() : '';
        let unit = (colUnit !== -1 && colUnit < row.length && row[colUnit]) ? String(row[colUnit]).trim() : '';
        let category = (colCat !== -1 && colCat < row.length && row[colCat]) ? String(row[colCat]).trim() : '';
        let actualKeyCol = colKey; // 이 행에서 실제로 키워드를 가져온 열(헤더 탐색 실패 시 아래에서 갱신)

        if (!keyword || isDashOrEmpty(keyword) || /점검항목|검사항목|작업조건|구분|규격/i.test(keyword)) {
          const endKeyCol = (colSpec !== -1 && colSpec > 0) ? Math.min(colSpec, row.length) : Math.min(4, row.length);
          const cellCandidates = [];
          for (let c = 0; c < endKeyCol; c++) {
            if (c === colTol || c === colUnit || c === colSpec) continue;
            const val = (row[c] || '').trim();
            if (!isDashOrEmpty(val) && !/점검항목|검사항목|작업조건|구분|점검|특이사항|No|번호|규격|공차|단위/i.test(val) && !/^\d+$/.test(val) && val.length > 1) {
              cellCandidates.push({ val, col: c });
            }
          }
          if (cellCandidates.length > 0) {
            keyword = cellCandidates[cellCandidates.length - 1].val;
            actualKeyCol = cellCandidates[cellCandidates.length - 1].col;
            if (!category && cellCandidates.length >= 2) category = cellCandidates[0].val;
          }
        }

        if (keyword && !isDashOrEmpty(keyword) && !/점검항목|검사항목|작업조건|구분|규격|No|번호/i.test(keyword)) {
          if (spec && !isDashOrEmpty(tol) && !spec.includes('±') && !spec.includes('+')) {
            const cleanTol = tol.includes('±') ? tol : `± ${tol}`;
            spec = `${spec} ${cleanTol}`;
          }

          if (!isDashOrEmpty(unit) && spec) {
            // 단순 문자열 포함 여부(includes)로는 'kg/cm2' vs 'kg/㎠'처럼
            // 표기만 다른 동일 단위를 다르다고 오판해 단위가 중복 표기되는 문제가 있었음.
            // → 정규화된 단위끼리 비교해서 실제로 같은 단위인지 판단한다.
            const specUnitInText = normalizeUnitForComp(extractUnitFromText(spec));
            const normUnit = normalizeUnitForComp(unit);
            const specAlreadyHasUnit = specUnitInText && normUnit && specUnitInText === normUnit;
            if (!specAlreadyHasUnit) {
              spec = `${spec} ${unit}`;
            }
          }

          items.push({
            category: category,
            keyword: keyword,
            combinedKeyword: category ? `${category} ${keyword}` : keyword,
            spec: spec || '-',
            unit: unit,
            targetIndex: 1,
            // "키워드 텍스트 재검색" 없이 원본 셀 위치를 바로 짚어내기 위한 좌표 정보.
            __rowMeta: matrix.__rowMeta ? matrix.__rowMeta[r] : { fileIdx: 0, localRow: r },
            __colKey: actualKeyCol,
            __colSpec: colSpec
          });
        }
      }
      return items;
    }

    // ===================== 퍼징 작업지도서 전용 정합성 검사 =====================
    // 다른 4대 문서는 "관리계획서의 관리기록방법 칸에 적힌 문서명"을 보고 검사 대상을
    // 정하지만, 퍼징 작업지도서는 검사 방향이 반대다. 퍼징 작업지도서 안에 이미 서식으로
    // 정해져 있는 항목(3번 제품 정보 / 4번 생산 설비 및 금형 정보)만 뽑아서, 그 값이
    // 관리계획서와 일치하는지를 확인한다. 그래서 normalizeTargetDoc 라우팅을 타지 않고
    // 별도의 패스(runPurgingGuideAnalysis)로 처리한다.
    //
    // 규칙 요약
    //  - 단위는 비교하지 않는다(숫자/코드 값만 본다).
    //  - 3번 제품 정보: 제품번호 / 제품 중량 Min(g) / 제품 중량 Max(g) 만 비교. 품명은 제외.
    //    · 제품번호는 하이픈 유무를 무시한다 (511151611 == 51115-1611)
    //    · 중량 Min/Max는 관리계획서 "제품특성"이 '제품 중량 검사'인 행의 하한/상한을 읽는다.
    //  - 4번 생산 설비 및 금형 정보: 설비번호 / Tonnage / 금형 No 만 비교. CAV 수량은 제외.
    //    · 설비번호는 접두 M과 하이픈을 무시한다 (대상설비 135 == 설비번호 M-135)
    //    · Tonnage는 관리계획서 "작업요소"의 '사출성형장치(F-100ton)' 괄호 안 값과 비교한다.
    //    · 금형 No는 관리계획서 'Tool 번호' 항목 아래의 값과 비교한다.
    //  - 5번 퍼징 조건 정보는 알고리즘 미확정이므로 일절 손대지 않는다.

    const PG_DOC_NAME = '퍼징 작업지도서';

    // 하이픈/공백/밑줄을 무시한 코드 비교용 정규화 (예: 511151611 == 51115-1611)
    function normalizeIdCode(val) {
      if (isDashOrEmpty(val)) return '';
      return String(val).normalize('NFKC').replace(/[\s\-_]/g, '').toLowerCase();
    }

    // 설비번호 비교용: 하이픈/공백에 더해 접두 M까지 무시 (대상설비 135 == 설비번호 M-135)
    function normalizeEquipNo(val) {
      const base = normalizeIdCode(val);
      if (!base) return '';
      return base.replace(/m/g, '');
    }

    // Tonnage 비교용: 공백/하이픈 제거 + 소문자 (예: "F-100ton" == "F-100 Ton")
    function normalizeTonnage(val) {
      if (isDashOrEmpty(val)) return '';
      return String(val).normalize('NFKC').toLowerCase()
        .replace(/[\s\-_]/g, '')
        .replace(/tons$/, 'ton');
    }

    // 단위를 무시하고 숫자만 뽑는다 ("12.5 g" → 12.5, "100 Ton" → 100)
    // ⚠️ "F-100ton"처럼 접두 문자 뒤에 오는 하이픈을 음수 부호로 읽으면 -100이 되어
    //    관리계획서(F-100ton)와 퍼징 작업지도서(100 Ton)의 숫자가 다르다고 잘못
    //    판정된다. 문자 바로 뒤에 붙은 하이픈은 먼저 제거한다.
    function toNumberLoose(val) {
      if (isDashOrEmpty(val)) return null;
      const s = String(val).normalize('NFKC').replace(/,/g, '')
        .replace(/([A-Za-z가-힣])-(?=\d)/g, '$1');
      const m = s.match(/-?\d+(?:\.\d+)?/);
      return m ? parseFloat(m[0]) : null;
    }

    // 라벨/헤더 셀 텍스트 비교용 정규화 (공백 제거 + 소문자)
    function pgNorm(val) {
      return normalizeText(val).replace(/\s+/g, '');
    }

    // 퍼징 작업지도서에서 찾아야 할 항목 정의.
    // patterns 안의 정규식은 "모두" 만족해야 그 셀을 해당 항목의 라벨로 인정한다.
    // (예: 제품 중량 Min → '중량'도 있고 'min'도 있어야 함)
    const PG_FIELD_DEFS = [
      { id: 'productNo', section: 3, label: '제품번호', patterns: [/제품번호|품번|part\.?no|제품no/] },
      { id: 'weightMin', section: 3, label: '제품 중량 Min', patterns: [/제품중량|중량/, /min|최소|하한/] },
      { id: 'weightMax', section: 3, label: '제품 중량 Max', patterns: [/제품중량|중량/, /max|최대|상한/] },
      { id: 'equipNo', section: 4, label: '설비번호', patterns: [/설비번호|설비no|호기/] },
      { id: 'tonnage', section: 4, label: 'Tonnage', patterns: [/tonnage|톤수|형체력/] },
      { id: 'moldNo', section: 4, label: '금형 No', patterns: [/금형no|금형번호|moldno/] },
      // 아래 둘은 값을 비교하지 않지만, 검토표시본에 SKIPPED(회색)로 표시해야 하므로
      // 셀 좌표를 알아내기 위해 함께 찾아둔다.
      // 라벨로만 인식되도록 앞머리를 고정한다. /cav/처럼 느슨하게 두면 "2CAV" 같은
      // 값까지 라벨로 오인해 값 칸 탐색에서 건너뛰어 버린다.
      { id: 'partName', section: 3, label: '품명', patterns: [/^품명|^제품명/] },
      { id: 'cavQty', section: 4, label: 'CAV 수량', patterns: [/^cav/] }
    ];

    // 어떤 셀이 (다른) 항목 라벨처럼 생겼는지 판단한다. 값 칸을 찾아 내려가거나
    // 오른쪽으로 이동할 때, 옆/아래에 붙어 있는 다른 항목의 라벨을 값으로 잘못
    // 읽어오는 것을 막기 위해 쓴다.
    function isPgLabelLike(val) {
      const s = pgNorm(val);
      if (!s || s.length > 40) return false;
      // 퍼징 작업지도서(3·4·5번)와 제습건조기 기준서(3~6번)에서 쓰는 모든 항목 라벨을
      // 대상으로 본다. 한쪽 문서의 라벨만 알고 있으면, 값이 비었을 때 옆 칸의 다른
      // 항목 라벨(예: '표준 수분 함습율')을 값으로 잘못 읽어온다.
      const all = PG_FIELD_DEFS
        .concat(PG_S5_SKIP_DEFS)
        .concat(PG_S5_COMPARE_DEFS)
        .concat(DD_COMPARE_DEFS);
      return all.some(def => def.patterns.every(p => p.test(s)))
        || /^cav|cav수량|품명|제품명/.test(s);
    }

    // 섹션 제목 셀("3. 제품 정보", "4. 생산 설비 및 금형 정보", "5. 퍼징 조건 정보")인지 판단한다.
    // 값 칸을 찾아 이동하다가 이 셀을 만나면 그 자리에서 멈춰야 한다. 그러지 않으면
    // 값이 비어 있을 때 다음 섹션의 제목을 값으로 잘못 읽어온다.
    // ※ "12.5" 같은 값도 /^\d+[.]/에 걸리므로, 반드시 섹션 이름 키워드까지 함께 본다.
    function isPgSectionTitle(val) {
      const s = pgNorm(val);
      if (!s || s.length > 40) return false;
      // "3.제품정보", "4.원재료정보및수분함습율"처럼 숫자+구두점 뒤에 글자가 이어지는
      // 형태를 섹션 제목으로 본다. "12.5" 같은 값은 구두점 뒤가 숫자라 걸리지 않는다.
      if (/^\d+[.)]\s*[가-힣a-z]/.test(s) && s.length >= 4) return true;
      return /^\d+[.)]?\s*(제품정보|생산설비|설비및금형|퍼징조건|원재료)/.test(s)
        || /^제품정보$|^생산설비.*금형.*정보$|^설비및금형정보$|^퍼징조건(정보)?$/.test(s);
    }

    // 주어진 행 범위 안에서 patterns를 모두 만족하는 라벨 셀을 찾는다.
    function findPgLabelCell(matrix, startRow, endRow, patterns) {
      const from = Math.max(0, startRow);
      const to = Math.min(matrix.length, endRow);
      for (let r = from; r < to; r++) {
        const row = matrix[r];
        if (!Array.isArray(row)) continue;
        for (let c = 0; c < row.length; c++) {
          const s = pgNorm(row[c]);
          if (!s || s.length > 40) continue;
          // 섹션 제목은 항목 라벨이 아니다. 제목에 항목명과 같은 단어가 들어있는
          // 경우가 많아(예: "4. 원재료 정보 및 수분 함습율") 반드시 걸러내야 한다.
          if (isPgSectionTitle(row[c])) continue;
          if (patterns.every(p => p.test(s))) {
            return { row: r, col: c, label: String(row[c]).trim() };
          }
        }
      }
      return null;
    }

    // 섹션 제목 행(예: "3. 제품 정보")의 행 번호를 찾는다.
    function findPgSectionRow(matrix, pattern, fromRow) {
      for (let r = Math.max(0, fromRow || 0); r < matrix.length; r++) {
        const row = matrix[r];
        if (!Array.isArray(row)) continue;
        for (let c = 0; c < row.length; c++) {
          const s = pgNorm(row[c]);
          if (!s || s.length > 40) continue;
          if (pattern.test(s)) return r;
        }
      }
      return -1;
    }

    // 라벨 셀 기준으로 실제 값이 들어있는 칸을 찾는다.
    // 퍼징 작업지도서의 3·4번 항목은 "헤더 행 아래에 값 행"이 오는 표 형태이므로
    // 아래쪽을 먼저 보고, 그다음 "라벨 : 값" 형태를 고려해 오른쪽을 본다.
    // ※ sheetToMatrix는 병합 셀 값을 병합 범위 전체에 복제해두므로, 라벨과 똑같은
    //   값이 나오면 그건 병합된 라벨 칸이라 건너뛴다.
    // 값이 비어 있어도 "값이 있어야 할 자리"의 좌표는 반환한다(노란색 표시용).
    function readPgValueCell(matrix, labelCell, boundaryRow) {
      const labelNorm = pgNorm(labelCell.label);
      const limit = (typeof boundaryRow === 'number' && boundaryRow > labelCell.row) ? boundaryRow : matrix.length;
      // 병합된 라벨 칸(sheetToMatrix가 병합 범위에 값을 복제함)은 그냥 지나친다.
      const isMergedLabelCopy = (v) => {
        if (v === undefined || v === null) return false;
        const t = pgNorm(v);
        return !!t && t === labelNorm;
      };
      // 다른 항목의 라벨을 만나면 그 방향에는 이 항목의 값이 없다는 뜻이므로 멈춘다.
      // (지나쳐서 계속 훑으면 옆 칸 헤더나 그 옆 헤더를 값으로 잘못 집어온다)
      const isOtherLabel = (v) => {
        if (v === undefined || v === null) return false;
        const t = pgNorm(v);
        if (!t || t === labelNorm) return false;
        return isPgLabelLike(v);
      };

      // 1) 표 형태: 헤더 행 바로 아래의 값 행
      for (let r = labelCell.row + 1; r <= labelCell.row + 2 && r < matrix.length && r < limit; r++) {
        const v = matrix[r] ? matrix[r][labelCell.col] : undefined;
        if (isPgSectionTitle(v) || isOtherLabel(v)) break;
        if (isMergedLabelCopy(v)) continue;
        if (!isDashOrEmpty(v)) return { value: String(v).trim(), row: r, col: labelCell.col, found: true, labelFound: true };
      }

      // 2) 키-값 형태: 라벨 오른쪽 칸
      const row = matrix[labelCell.row] || [];
      for (let c = labelCell.col + 1; c <= labelCell.col + 5 && c < row.length; c++) {
        const v = row[c];
        if (isPgSectionTitle(v) || isOtherLabel(v)) break;
        if (isMergedLabelCopy(v)) continue;
        if (!isDashOrEmpty(v)) return { value: String(v).trim(), row: labelCell.row, col: c, found: true, labelFound: true };
      }

      // 3) 값이 비어 있음 → "값이 있어야 할 자리"의 좌표를 반환한다(노란색 표시용).
      const fallbackRow = Math.min(labelCell.row + 1, Math.max(0, matrix.length - 1));
      return { value: '', row: fallbackRow, col: labelCell.col, found: false, labelFound: true };
    }

    // ---------- 5번 퍼징 조건 정보 ----------
    // 3·4번과 달리 값 밑에 ± 공차가 따로 적혀 있는 항목들이라, 값 + 공차를 합쳐
    // 실제 허용범위로 환산한 뒤 관리계획서 규격과 비교한다.
    // 판정 기준은 나머지 문서와 동일하게 "퍼징 작업지도서의 범위가 관리계획서
    // 허용범위 안에 들어오면 일치"로 본다.

    // 비교하지 않고 검토표시본에 회색(SKIPPED)으로만 남기는 항목
    const PG_S5_SKIP_DEFS = [
      { id: 's5_mc', label: 'MC', patterns: [/^m\/?c$/] },
      { id: 's5_screwDia', label: '스쿠류Φ', patterns: [/스쿠류|스크류/, /φ|ø|dia|경/] },
      { id: 's5_baseCount', label: '기준설정(횟수)', patterns: [/기준설정/] },
      { id: 's5_shotAmt', label: '1shot 퍼징량', patterns: [/shot퍼징량/] },
      { id: 's5_totalAmt', label: '퍼징량 합계', patterns: [/퍼징량합계|퍼징량총/] },
      { id: 's5_condition', label: '조건', patterns: [/^조건$/] },
      { id: 's5_nozzleBore', label: '노즐 내경', patterns: [/노즐내경/] }
    ];

    // 관리계획서와 실제로 대조하는 항목
    //  - mode 'single'    : 값 하나 대 규격 하나
    //  - mode 'multi'     : 퍼징 지도서 값이 "a / b / c"로 나뉘어 있고
    //                       관리계획서에는 항목1·2·3으로 분리되어 있는 경우
    //  - mode 'frontrear' : 규격 안에 Front/Rear가 함께 들어있어 각각 판단
    const PG_S5_COMPARE_DEFS = [
      {
        id: 's5_nozzleTemp', label: '노즐부 온도', mode: 'single',
        patterns: [/노즐부온도|노즐온도/],
        cpDisplay: '노즐부 히터 온도', cpNames: [['노즐부히터온도', '노즐히터온도', '노즐부온도']]
      },
      {
        id: 's5_cylFront', label: '실린더 전단부 온도', mode: 'single',
        patterns: [/전단부온도/],
        cpDisplay: '전단부 히터 온도', cpNames: [['전단부히터온도', '전단부온도']]
      },
      {
        id: 's5_cylMid', label: '실린더 중반부 온도', mode: 'single',
        patterns: [/중반부온도/],
        cpDisplay: '중반부 히터 온도', cpNames: [['중반부히터온도', '중반부온도']]
      },
      {
        id: 's5_cylRear', label: '실린더 후반부 온도', mode: 'single',
        patterns: [/후반부온도/],
        cpDisplay: '후반부 히터 온도', cpNames: [['후반부히터온도', '후반부온도']]
      },
      {
        id: 's5_feedTemp', label: '투입부 온도', mode: 'single',
        patterns: [/투입부온도/],
        cpDisplay: '투입부 히터온도', cpNames: [['투입부히터온도', '투입부온도']]
      },
      {
        id: 's5_meteringRpm', label: '계량 RPM', mode: 'single',
        patterns: [/계량rpm|계량회전|계량속도/],
        cpDisplay: '스크류 회전속도', cpNames: [['스크류회전속도', '스쿠류회전속도', '스크류회전']]
      },
      {
        id: 's5_injSpeed', label: '사출속도', mode: 'multi',
        patterns: [/^사출속도/],
        cpDisplay: '사출속도1 / 사출속도2 / 사출속도3',
        cpBase: '사출속도', count: 3
      },
      {
        id: 's5_holdPress', label: '보압', mode: 'multi',
        patterns: [/^보압$|^보압압력|^보압\(/],
        cpDisplay: '보압1 / 보압2 / 보압3',
        cpBase: '보압', count: 3
      },
      {
        id: 's5_holdTime', label: '보압시간', mode: 'multi',
        patterns: [/^보압시간/],
        cpDisplay: '보압시간1 / 보압시간2 / 보압시간3',
        cpBase: '보압시간', count: 3
      },
      {
        id: 's5_injTime', label: '사출 시간', mode: 'single',
        patterns: [/^사출시간/],
        cpDisplay: '최대 사출 시간', cpNames: [['최대사출시간', '사출시간']]
      },
      {
        id: 's5_moldTemp', label: '온조기 셋업 온도', mode: 'frontrear',
        patterns: [/온조기/],
        cpDisplay: '금형 온도(FRONT/REAR)', cpNames: [['금형온도']]
      },
      {
        id: 's5_manifoldTemp', label: '매니폴드 셋업 온도', mode: 'single',
        patterns: [/매니폴드/],
        cpDisplay: '핫 런너 매니폴드 온도', cpNames: [['핫런너매니폴드온도', '핫런너매니폴드', '매니폴드온도', '매니폴드']]
      }
    ];

    // 다중 항목들의 기준명 목록. '보압'과 '보압시간'처럼 한쪽이 다른 쪽의
    // 앞부분인 경우를 서로 구분하기 위해 쓴다.
    const MULTI_BASES = PG_S5_COMPARE_DEFS.filter(d => d.mode === 'multi').map(d => d.cpBase);

    // 5번 항목의 값 칸과, 그 바로 아래에 따로 적힌 ± 공차 칸을 함께 읽는다.
    // 값 안에 이미 "250±10"처럼 공차가 포함돼 있으면 아래 칸은 보지 않는다.
    function readPgConditionCell(matrix, labelCell, boundaryRow) {
      const cell = readPgValueCell(matrix, labelCell, boundaryRow);
      cell.tol = '';
      cell.combined = cell.value;

      // 값 칸이 비어 있으면 readPgValueCell이 한 칸 더 내려가 그 아래의 공차 행("±2")을
      // 값으로 집어올 수 있다. 공차만 단독으로 적힌 칸은 값이 아니므로 "값 없음"으로
      // 되돌려 MISSING(노란색)으로 처리한다.
      if (cell.labelFound && /^\s*(?:±|\+\/-|\+-)/.test(String(cell.value))) {
        cell.value = '';
        cell.combined = '';
        cell.found = false;
        cell.row = Math.min(labelCell.row + 1, Math.max(0, matrix.length - 1));
        cell.col = labelCell.col;
        return cell;
      }

      if (!cell.labelFound || isDashOrEmpty(cell.value)) return cell;
      if (/±|\+\/-|\+-/.test(String(cell.value))) return cell;

      const below = matrix[cell.row + 1] ? matrix[cell.row + 1][cell.col] : undefined;
      if (below !== undefined && !isDashOrEmpty(below)) {
        const t = String(below).trim();
        if (/^\s*(?:±|\+\/-|\+-)/.test(t)) {
          cell.tol = t;
          cell.combined = `${cell.value} ${t}`;
        }
      }
      return cell;
    }

    // "30 / 50 / 70" → ['30','50','70']
    function splitSlashParts(text) {
      if (isDashOrEmpty(text)) return [];
      return String(text).split(/[\/／]/).map(v => v.trim()).filter(v => v !== '');
    }

    // 관리계획서 항목의 허용범위를 하한/상한(없으면 Nominal의 ± 표기)에서 계산한다.
    // ※ spec 텍스트에는 단위가 붙어 있어(Kg/cm2 등) 숫자 추출이 오염될 수 있으므로
    //   하한/상한 칸을 우선으로 쓴다.
    function cpRangeOfItem(it) {
      if (!it) return null;
      const lo = toNumberLoose(it.lower);
      const up = toNumberLoose(it.upper);
      if (lo !== null && up !== null) return { min: Math.min(lo, up), max: Math.max(lo, up) };
      const nomRange = extractNumericRange(it.nominal);
      if (nomRange) return nomRange;
      if (lo !== null) return { min: lo, max: lo };
      if (up !== null) return { min: up, max: up };
      return null;
    }

    function fmtRange(r) {
      if (!r) return '-';
      return (r.min === r.max) ? `${r.min}` : `${r.min}~${r.max}`;
    }

    // 사출속도/보압/보압시간처럼 관리계획서에서 1·2·3으로 나뉘는 항목을 한 번에 찾는다.
    //
    // 관리계획서는 첫 번째 항목에 번호를 안 붙이는 경우가 많다(보압1 대신 그냥 '보압').
    // 그래서 번호가 붙은 이름을 먼저 찾고, 못 찾으면 1번에 한해 번호 없는 이름을 받아준다.
    //
    // ⚠️ 이때 '보압'으로 부분 일치를 허용하면 '보압시간'까지 잡혀버린다. 그래서
    //    다른 항목의 기준명이 내 기준명으로 시작하는 경우(보압 ⊂ 보압시간) 그 항목들은
    //    후보에서 아예 제외하고, 번호 없는 이름은 완전 일치로만 받는다.
    //    이미 다른 번호에 배정된 항목도 중복 배정되지 않게 제외한다.
    function resolveCpMultiItems(cpParsed, base, count, allBases) {
      const list = cpParsed || [];
      const nameOf = (it) => pgNorm(it.processChar) || pgNorm(it.productChar);
      const conflicting = (allBases || []).filter(b => b !== base && b.startsWith(base));
      const usable = list.filter(it => {
        const n = nameOf(it);
        if (!n) return false;
        return !conflicting.some(c => n.startsWith(c));
      });

      const used = new Set();
      const pick = (cands, allowPartial) => {
        for (const c of cands) {
          const hit = usable.find(it => !used.has(it) && nameOf(it) === c);
          if (hit) { used.add(hit); return hit; }
        }
        if (allowPartial) {
          for (const c of cands) {
            const hit = usable.find(it => !used.has(it) && nameOf(it).includes(c));
            if (hit) { used.add(hit); return hit; }
          }
        }
        return null;
      };

      const out = [];
      for (let i = 1; i <= count; i++) {
        let hit = pick([`${base}${i}`, `${base}(${i})`, `${i}차${base}`, `${base}${i}차`], true);
        // 번호 없는 이름(예: '보압')은 1번 항목으로 본다.
        if (!hit && i === 1) hit = pick([base], false);
        out.push(hit || null);
      }
      return out;
    }

    // 공정특성명(없으면 제품특성명)으로 관리계획서 항목을 찾는다.
    function findCpItemByCharName(cpParsed, needles) {
      const list = cpParsed || [];
      const fields = ['processChar', 'productChar'];
      for (const f of fields) {
        for (const n of needles) {
          const exact = list.find(it => pgNorm(it[f]) === n);
          if (exact) return exact;
        }
        for (const n of needles) {
          const partial = list.find(it => pgNorm(it[f]).includes(n));
          if (partial) return partial;
        }
      }
      return null;
    }

    // 퍼징 작업지도서에서 3번/4번/5번 섹션의 지정 항목을 뽑아낸다.
    function parsePurgingGuideDoc(matrix) {
      const result = { fields: {}, sections: {} };
      if (!matrix || matrix.length === 0) return result;

      const sec3 = findPgSectionRow(matrix, /제품정보/, 0);
      const sec4 = findPgSectionRow(matrix, /생산설비.*금형.*정보|설비및금형정보|설비.*금형정보/, sec3 >= 0 ? sec3 + 1 : 0);
      const sec5 = findPgSectionRow(matrix, /퍼징조건/, sec4 >= 0 ? sec4 + 1 : 0);
      result.sections = { sec3, sec4, sec5 };

      const end3 = sec4 >= 0 ? sec4 : (sec5 >= 0 ? sec5 : matrix.length);
      const start3 = sec3 >= 0 ? sec3 : 0;
      const end4 = sec5 >= 0 ? sec5 : matrix.length;
      const start4 = sec4 >= 0 ? sec4 : (sec3 >= 0 ? sec3 + 1 : 0);

      // 5번 퍼징 조건 정보 구간. 섹션 제목을 못 찾으면 시트 전체를 대상으로 하되,
      // 5번 항목 라벨 패턴은 3·4번과 겹치지 않게 잡아두어 오탐을 막는다.
      const start5 = sec5 >= 0 ? sec5 : 0;
      const end5 = matrix.length;

      PG_FIELD_DEFS.forEach(def => {
        const [s, e] = def.section === 3 ? [start3, end3] : [start4, end4];
        let labelCell = findPgLabelCell(matrix, s, e, def.patterns);
        // 섹션 제목을 못 찾아 범위가 어긋난 경우를 대비해 시트 전체에서 한 번 더 찾는다.
        if (!labelCell) labelCell = findPgLabelCell(matrix, 0, matrix.length, def.patterns);
        if (!labelCell) {
          result.fields[def.id] = { value: '', row: -1, col: -1, found: false, labelFound: false, label: def.label };
          return;
        }
        const cell = readPgValueCell(matrix, labelCell, e);
        cell.label = def.label;
        cell.labelCell = labelCell;
        result.fields[def.id] = cell;
      });

      // 5번 퍼징 조건 정보: 값 아래에 ± 공차가 따로 적히므로 전용 리더를 쓴다.
      result.s5 = {};
      PG_S5_SKIP_DEFS.concat(PG_S5_COMPARE_DEFS).forEach(def => {
        const labelCell = findPgLabelCell(matrix, start5, end5, def.patterns);
        if (!labelCell) {
          result.s5[def.id] = { value: '', tol: '', combined: '', row: -1, col: -1, found: false, labelFound: false, label: def.label };
          return;
        }
        const cell = readPgConditionCell(matrix, labelCell, end5);
        cell.label = def.label;
        cell.labelCell = labelCell;
        result.s5[def.id] = cell;
      });

      return result;
    }

    // 관리계획서에서 "라벨 아래 칸들"의 값을 모두 수집한다.
    // (대상설비 / Tool 번호처럼 라벨 밑으로 값이 이어지는 항목용)
    // 설비번호·금형번호는 반드시 숫자를 포함하므로, 숫자가 전혀 없는 칸(예: 아래쪽
    // 표의 '공정특성', 'Nominal' 같은 헤더)을 만나면 그 지점에서 수집을 멈춘다.
    // 이렇게 하지 않으면 라벨 아래 열 전체를 훑어서 무관한 헤더/값까지 후보로
    // 삼아버려 엉뚱하게 MATCH가 나는 문제가 생긴다.
    function collectCpColumnValues(matrix, patterns) {
      const loc = findPgLabelCell(matrix, 0, matrix.length, patterns);
      if (!loc) return { values: [], loc: null };
      const labelNorm = pgNorm(loc.label);
      const hasDigit = (v) => /\d/.test(String(v));
      const values = [];
      let emptyRun = 0;

      for (let r = loc.row + 1; r < matrix.length && r <= loc.row + 60; r++) {
        const v = matrix[r] ? matrix[r][loc.col] : undefined;
        if (v === undefined || isDashOrEmpty(v)) {
          emptyRun++;
          if (values.length > 0 && emptyRun >= 2) break;
          continue;
        }
        emptyRun = 0;
        if (pgNorm(v) === labelNorm) continue;   // 세로 병합된 라벨 칸
        if (!hasDigit(v)) break;                 // 다른 표의 헤더를 만난 지점
        const s = String(v).trim();
        if (s.length > 20) break;
        if (!values.includes(s)) values.push(s);
      }

      // 라벨 바로 아래가 비어 있는 표 형태 등으로 아무것도 못 모았으면,
      // 같은 열 전체에서 "숫자를 포함한 짧은 값"만 느슨하게 다시 수집한다.
      if (values.length === 0) {
        for (let r = loc.row + 1; r < matrix.length && values.length < 50; r++) {
          const v = matrix[r] ? matrix[r][loc.col] : undefined;
          if (v === undefined || isDashOrEmpty(v)) continue;
          if (pgNorm(v) === labelNorm) continue;
          const s = String(v).trim();
          if (!hasDigit(s) || s.length > 20) continue;
          if (!values.includes(s)) values.push(s);
        }
      }

      return { values, loc };
    }

    // 관리계획서에서 라벨 하나에 딸린 단일 값을 찾는다(제품번호 등).
    // ⚠️ 관리계획서의 제품번호는 라벨 "아래" 칸에 적히므로 반드시 아래쪽을 먼저 본다.
    //    예전에는 오른쪽 칸을 먼저 읽어서, 라벨 오른편에 붙어 있는 다른 정보(고객사·
    //    개정번호 등)를 제품번호로 잘못 채택하는 문제가 있었다.
    //    아래쪽에서 값을 전혀 못 찾은 경우에 한해서만 "라벨 : 값" 형태를 고려해
    //    오른쪽 칸을 예비로 살펴본다.
    function findCpSingleValue(matrix, patterns) {
      const loc = findPgLabelCell(matrix, 0, matrix.length, patterns);
      if (!loc) return null;
      const labelNorm = pgNorm(loc.label);
      // 라벨과 같은 값(세로/가로로 병합된 라벨 칸)은 건너뛴다.
      const skip = (v) => {
        if (v === undefined || v === null) return true;
        const s = pgNorm(v);
        if (!s) return false;
        return s === labelNorm;
      };

      // 제품번호·금형번호 같은 코드 값은 반드시 숫자를 포함한다. 라벨 아래로 내려가다가
      // 숫자가 전혀 없는 칸(예: 몇 줄 아래에 있는 표의 '공정단계명' 같은 헤더)을 만나면
      // 그 지점에서 멈춘다. 이 방어가 없으면 라벨 밑이 비어 있을 때 한참 아래의
      // 엉뚱한 헤더 텍스트를 값으로 채택해버린다.
      const looksLikeValue = (v) => /\d/.test(String(v));

      // 1) 라벨 바로 아래 칸 (관리계획서 기본 서식)
      for (let r = loc.row + 1; r <= loc.row + 3 && r < matrix.length; r++) {
        const v = matrix[r] ? matrix[r][loc.col] : undefined;
        if (skip(v)) continue;
        if (isDashOrEmpty(v)) continue;
        if (!looksLikeValue(v)) break;
        return { value: String(v).trim(), row: r, col: loc.col, loc };
      }

      // 2) 예비: 아래에 아무 값도 없을 때만 오른쪽 칸
      const row = matrix[loc.row] || [];
      for (let c = loc.col + 1; c <= loc.col + 6 && c < row.length; c++) {
        if (skip(row[c])) continue;
        if (isDashOrEmpty(row[c])) continue;
        if (!looksLikeValue(row[c])) break;
        return { value: String(row[c]).trim(), row: loc.row, col: c, loc };
      }

      return { value: '', row: loc.row, col: loc.col, loc };
    }

    // 관리계획서 "작업요소"에 적힌 사출성형장치(F-100ton)에서 괄호 안 Tonnage를 뽑는다.
    function extractCpTonnage(cpParsed, cpMatrix) {
      const pick = (text) => {
        const s = String(text);
        const m = s.match(/사출성형장치\s*[(（]\s*([^)）]*?)\s*[)）]/);
        if (m && m[1]) return m[1].trim();
        const m2 = s.match(/사출성형장치\s*[:：\-]?\s*([A-Za-z0-9\-\s.]*?(?:ton|톤)[a-z]*)/i);
        if (m2 && m2[1]) return m2[1].trim();
        return null;
      };

      for (const it of (cpParsed || [])) {
        for (const f of [it.workElem, it.processChar, it.productChar, it.processName]) {
          if (f && /사출성형장치/.test(String(f))) {
            const v = pick(f);
            if (v) return { value: v, source: String(f).trim() };
          }
        }
      }
      for (let r = 0; r < cpMatrix.length; r++) {
        const row = cpMatrix[r];
        if (!Array.isArray(row)) continue;
        for (let c = 0; c < row.length; c++) {
          const cell = row[c];
          if (cell && /사출성형장치/.test(String(cell))) {
            const v = pick(cell);
            if (v) return { value: v, source: String(cell).trim() };
          }
        }
      }
      return null;
    }

    // 관리계획서 제품특성이 '제품 중량 검사'인 행의 하한(=Min)/상한(=Max)을 읽는다.
    function findCpProductWeightItem(cpParsed) {
      const list = cpParsed || [];
      const hit = (needle) => list.find(it => {
        const s = pgNorm(it.productChar || '');
        return s && s.includes(needle) && (!isDashOrEmpty(it.lower) || !isDashOrEmpty(it.upper));
      });
      return hit('제품중량검사') || hit('제품중량') || null;
    }

    // 관리계획서 쪽 기준값을 한 번에 모아둔다.
    function extractCpPurgingRefs(cpMatrix, cpParsed) {
      return {
        productNo: findCpSingleValue(cpMatrix, [/제품번호|품번|part\.?no|제품no/]),
        weightItem: findCpProductWeightItem(cpParsed),
        equipNos: collectCpColumnValues(cpMatrix, [/대상설비|해당설비/]),
        moldNos: collectCpColumnValues(cpMatrix, [/tool번호|toolno|금형번호/]),
        tonnage: extractCpTonnage(cpParsed, cpMatrix)
      };
    }

    // 채색용 좌표 정보를 담은 가짜 target item.
    // buildAnnotatedFilesForKey가 __rowMeta로 원본 파일/행을 바로 찾아가고,
    // pickTargetCellCol이 __col*로 열을 고른다.
    function makePgTargetItem(pgMatrix, cell) {
      if (!cell || cell.row < 0 || cell.col < 0) return null;
      const meta = (pgMatrix.__rowMeta && pgMatrix.__rowMeta[cell.row])
        ? pgMatrix.__rowMeta[cell.row]
        : { fileIdx: 0, localRow: cell.row };
      return {
        __rowMeta: meta,
        __colSpec: cell.col,
        __colKey: cell.col,
        __colNominal: cell.col,
        __colLower: cell.col,
        __colUpper: cell.col
      };
    }

    function runPurgingGuideAnalysis(cpMatrix, cpParsed) {
      if (!isDocUploaded('pg')) return;

      const pgMatrix = getMatrixFromDocData('pg');
      if (!pgMatrix || pgMatrix.length === 0) {
        analysisResults.push({
          rawMethod: '(퍼징 작업지도서 직접 대조)',
          targetDoc: PG_DOC_NAME,
          processName: '퍼징 작업지도서 대조',
          chosenKeyword: '-',
          chosenType: '퍼징 지정항목 직접 대조',
          simPercent: 0,
          cpSpec: '-',
          targetKeyword: '퍼징 작업지도서',
          targetSpec: '-',
          status: 'REVIEW',
          detailNote: '🔍 [REVIEW] 퍼징 작업지도서 파일에서 데이터를 읽지 못했습니다. 작업자 직접 확인 필요.',
          _pgDirect: true
        });
        return;
      }

      const pg = parsePurgingGuideDoc(pgMatrix);
      const ref = extractCpPurgingRefs(cpMatrix, cpParsed);

      // 관리계획서 쪽 근거가 된 키워드(라벨/특성명)를 그대로 "채택 키워드" 열에 싣는다.
      // 예전에는 채택 키워드·대상문서 매칭키워드 양쪽 모두에 퍼징 작업지도서의 항목명이
      // 들어가서, 이 값이 관리계획서의 어느 칸에서 온 것인지 표에서 알 수 없었다.
      const cpKeywordOf = (foundLabel, fallbackName) => {
        const v = (foundLabel === undefined || foundLabel === null) ? '' : String(foundLabel).trim();
        return v ? v : `${fallbackName} (관리계획서 미검출)`;
      };

      const push = (o) => {
        analysisResults.push({
          rawMethod: '(퍼징 작업지도서 직접 대조)',
          targetDoc: PG_DOC_NAME,
          processName: '퍼징 작업지도서 대조',
          // 채택 키워드 = 관리계획서 쪽 키워드
          chosenKeyword: o.cpKeyword || '-',
          chosenType: '퍼징 지정항목 직접 대조',
          simPercent: o.status === 'MATCH' ? 100 : 0,
          cpSpec: (o.cpText && String(o.cpText).trim()) || '-',
          // 대상문서 매칭키워드 = 퍼징 작업지도서 쪽 항목명
          targetKeyword: o.pgLabel,
          targetSpec: (o.pgCell && o.pgCell.value) ? o.pgCell.value : '-',
          status: o.status,
          detailNote: o.note,
          _cpItem: null,
          _targetItem: (o.pgCell && o.pgCell.labelFound) ? makePgTargetItem(pgMatrix, o.pgCell) : null,
          _pgDirect: true
        });
      };

      const okNote = (label, cpText, pgText) =>
        `✅ [MATCH] 퍼징 작업지도서 '${label}' 값이 관리계획서와 일치합니다. (관리계획서: ${cpText} / 퍼징 작업지도서: ${pgText})`;
      const ngNote = (label, cpText, pgText) =>
        `❌ [MISMATCH] 퍼징 작업지도서 '${label}' 값이 관리계획서와 다릅니다. (관리계획서: ${cpText} / 퍼징 작업지도서: ${pgText})`;

      // 공통 판정 흐름: 항목 없음 → MISSING / 값 없음 → MISSING / 기준값 없음 → REVIEW
      // 그 외에는 compare()가 돌려주는 판정을 그대로 쓴다.
      const evaluate = (f) => {
        const base = { pgLabel: f.pgLabel, pgCell: f.pgCell, cpText: f.cpText, cpKeyword: f.cpKeyword };
        if (!f.pgCell || !f.pgCell.labelFound) {
          push(Object.assign({}, base, {
            status: 'MISSING',
            note: `⚠️ [MISSING] 퍼징 작업지도서에서 '${f.pgLabel}' 항목 자체를 찾지 못했습니다.`
          }));
          return;
        }
        if (isDashOrEmpty(f.pgCell.value)) {
          push(Object.assign({}, base, {
            status: 'MISSING',
            note: `⚠️ [MISSING] 퍼징 작업지도서에 '${f.pgLabel}' 값이 기재되어 있지 않습니다. (관리계획서: ${f.cpText || '미기재'})`
          }));
          return;
        }
        if (isDashOrEmpty(f.cpText)) {
          push(Object.assign({}, base, {
            status: 'REVIEW',
            note: `🔍 [REVIEW] 관리계획서에서 '${f.cpRefName}' 기준값을 찾지 못했습니다. 작업자 직접 확인 필요. (퍼징 작업지도서: ${f.pgCell.value})`
          }));
          return;
        }
        const { status, note } = f.compare(f.pgCell.value, f.cpText);
        push(Object.assign({}, base, { status, note }));
      };

      // 자동 대조 규칙이 없는 항목은 그냥 넘기지 않고 REVIEW(보라색)로 남겨
      // 작업자가 직접 확인하도록 한다.
      const pushSkipped = (pgLabel, pgCell) => {
        analysisResults.push({
          rawMethod: '(퍼징 작업지도서 직접 대조)',
          targetDoc: PG_DOC_NAME,
          processName: '퍼징 작업지도서 대조',
          chosenKeyword: '-',
          chosenType: '퍼징 지정항목 직접 대조',
          simPercent: 0,
          cpSpec: '-',
          targetKeyword: pgLabel,
          targetSpec: (pgCell && pgCell.value) ? pgCell.value : '-',
          status: 'REVIEW',
          detailNote: `🔍 [REVIEW] '${pgLabel}' 항목은 자동 대조 규칙이 없습니다. 작업자 직접 확인 필요.`,
          _cpItem: null,
          _targetItem: (pgCell && pgCell.labelFound) ? makePgTargetItem(pgMatrix, pgCell) : null,
          _pgDirect: true
        });
      };

      // ---- 3번 제품 정보 ----
      // 제품번호: 하이픈 유무 무시
      evaluate({
        pgLabel: '제품번호',
        pgCell: pg.fields.productNo,
        cpText: ref.productNo ? ref.productNo.value : '',
        cpKeyword: cpKeywordOf(ref.productNo && ref.productNo.loc ? ref.productNo.loc.label : '', '제품번호'),
        cpRefName: '제품번호',
        compare: (pgVal, cpVal) => normalizeIdCode(pgVal) === normalizeIdCode(cpVal)
          ? { status: 'MATCH', note: okNote('제품번호', cpVal, pgVal) }
          : { status: 'MISMATCH', note: ngNote('제품번호', cpVal, pgVal) }
      });

      // 품명은 비교 대상이 아니다.
      pushSkipped('품명', pg.fields.partName);

      // 제품 중량 Min / Max: 관리계획서 '제품 중량 검사' 행의 하한/상한. 단위는 무시.
      const wItem = ref.weightItem;
      const wCharName = (wItem && wItem.productChar) ? String(wItem.productChar).trim() : '제품 중량 검사';
      const compareNumeric = (label) => (pgVal, cpVal) => {
        const a = toNumberLoose(pgVal);
        const b = toNumberLoose(cpVal);
        if (a === null || b === null) {
          return normalizeIdCode(pgVal) === normalizeIdCode(cpVal)
            ? { status: 'MATCH', note: okNote(label, cpVal, pgVal) }
            : {
              status: 'REVIEW',
              note: `🔍 [REVIEW] 숫자 값으로 읽을 수 없어 직접 대조가 불가합니다. 작업자 직접 확인 필요. (관리계획서: ${cpVal} / 퍼징 작업지도서: ${pgVal})`
            };
        }
        return Math.abs(a - b) < 1e-9
          ? { status: 'MATCH', note: okNote(label, cpVal, pgVal) }
          : { status: 'MISMATCH', note: ngNote(label, cpVal, pgVal) };
      };

      evaluate({
        pgLabel: '제품 중량 Min',
        pgCell: pg.fields.weightMin,
        cpText: wItem ? wItem.lower : '',
        cpKeyword: wItem ? `${wCharName} (규격 하한)` : cpKeywordOf('', '제품 중량 검사 (규격 하한)'),
        cpRefName: '제품 중량 검사 (규격 하한)',
        compare: compareNumeric('제품 중량 Min')
      });
      evaluate({
        pgLabel: '제품 중량 Max',
        pgCell: pg.fields.weightMax,
        cpText: wItem ? wItem.upper : '',
        cpKeyword: wItem ? `${wCharName} (규격 상한)` : cpKeywordOf('', '제품 중량 검사 (규격 상한)'),
        cpRefName: '제품 중량 검사 (규격 상한)',
        compare: compareNumeric('제품 중량 Max')
      });

      // ---- 4번 생산 설비 및 금형 정보 ----
      // 설비번호: 접두 M과 하이픈 무시. 관리계획서 '대상설비' 열의 값 중 하나와 맞으면 일치.
      const equipList = ref.equipNos.values;
      const equipText = equipList.length > 0 ? equipList.slice(0, 5).join(', ') + (equipList.length > 5 ? ` 외 ${equipList.length - 5}건` : '') : '';
      evaluate({
        pgLabel: '설비번호',
        pgCell: pg.fields.equipNo,
        cpText: equipText,
        cpKeyword: cpKeywordOf(ref.equipNos.loc ? ref.equipNos.loc.label : '', '대상설비'),
        cpRefName: '대상설비',
        compare: (pgVal) => equipList.some(v => normalizeEquipNo(v) === normalizeEquipNo(pgVal))
          ? { status: 'MATCH', note: okNote('설비번호', equipText, pgVal) }
          : { status: 'MISMATCH', note: ngNote('설비번호', equipText, pgVal) }
      });

      // Tonnage: 관리계획서 작업요소 '사출성형장치(F-100ton)' 괄호 안 값과 비교.
      const tonText = ref.tonnage ? ref.tonnage.value : '';
      evaluate({
        pgLabel: 'Tonnage',
        pgCell: pg.fields.tonnage,
        cpText: tonText,
        cpKeyword: cpKeywordOf(ref.tonnage ? `작업요소: ${ref.tonnage.source}` : '', '작업요소 - 사출성형장치'),
        cpRefName: '작업요소 - 사출성형장치',
        compare: (pgVal, cpVal) => {
          if (normalizeTonnage(pgVal) === normalizeTonnage(cpVal)) {
            return { status: 'MATCH', note: okNote('Tonnage', cpVal, pgVal) };
          }
          const a = toNumberLoose(pgVal);
          const b = toNumberLoose(cpVal);
          if (a !== null && b !== null && Math.abs(a - b) < 1e-9) {
            return {
              status: 'REVIEW',
              note: `🔍 [REVIEW] 숫자 값은 같으나 표기가 다릅니다. 작업자 직접 확인 필요. (관리계획서: ${cpVal} / 퍼징 작업지도서: ${pgVal})`
            };
          }
          return { status: 'MISMATCH', note: ngNote('Tonnage', cpVal, pgVal) };
        }
      });

      // 금형 No: 관리계획서 'Tool 번호' 열의 값 중 하나와 맞으면 일치. 하이픈 무시.
      const moldList = ref.moldNos.values;
      const moldText = moldList.length > 0 ? moldList.slice(0, 5).join(', ') + (moldList.length > 5 ? ` 외 ${moldList.length - 5}건` : '') : '';
      evaluate({
        pgLabel: '금형 No',
        pgCell: pg.fields.moldNo,
        cpText: moldText,
        cpKeyword: cpKeywordOf(ref.moldNos.loc ? ref.moldNos.loc.label : '', 'Tool 번호'),
        cpRefName: 'Tool 번호',
        compare: (pgVal) => moldList.some(v => normalizeIdCode(v) === normalizeIdCode(pgVal))
          ? { status: 'MATCH', note: okNote('금형 No', moldText, pgVal) }
          : { status: 'MISMATCH', note: ngNote('금형 No', moldText, pgVal) }
      });

      // CAV 수량은 읽지 않는다.
      pushSkipped('CAV 수량', pg.fields.cavQty);

      // ---- 5번 퍼징 조건 정보 ----
      // 비교 대상이 아닌 항목: 회색(SKIPPED) 표시만
      PG_S5_SKIP_DEFS.forEach(def => pushSkipped(def.label, pg.s5[def.id]));

      // 값 + 아래에 적힌 ± 공차를 합쳐 실제 범위로 환산한 뒤 관리계획서 규격과 대조한다.
      const compareRange = (pgLabel, cpItem) => (pgVal, cpText) => {
        const cpRange = cpRangeOfItem(cpItem);
        const pgRange = extractNumericRange(pgVal);
        if (!cpRange || !pgRange) {
          return {
            status: 'REVIEW',
            note: `🔍 [REVIEW] 숫자 값으로 읽을 수 없어 직접 대조가 불가합니다. 작업자 직접 확인 필요. (관리계획서: ${cpText} / 퍼징 작업지도서: ${pgVal})`
          };
        }
        const EPS = 0.01;
        const ok = (pgRange.min >= cpRange.min - EPS) && (pgRange.max <= cpRange.max + EPS);
        const cpShown = `${cpText} → ${fmtRange(cpRange)}`;
        const pgShown = `${pgVal} → ${fmtRange(pgRange)}`;
        return ok
          ? { status: 'MATCH', note: okNote(pgLabel, cpShown, pgShown) }
          : { status: 'MISMATCH', note: ngNote(pgLabel, cpShown, pgShown) };
      };

      PG_S5_COMPARE_DEFS.forEach(def => {
        const pgCell = pg.s5[def.id];

        // 값이 "a / b / c"로 나뉘고 관리계획서에는 항목1·2·3으로 분리된 경우
        if (def.mode === 'multi') {
          const cpItems = resolveCpMultiItems(cpParsed, def.cpBase, def.count, MULTI_BASES);

          // 퍼징 작업지도서에 항목 자체가 없으면 1·2·3으로 쪼개 세 줄을 내는 대신
          // 항목 하나가 통째로 없다는 한 줄만 남긴다.
          if (!pgCell || !pgCell.labelFound) {
            evaluate({
              pgLabel: def.label,
              pgCell: pgCell,
              cpText: '',
              cpKeyword: cpKeywordOf('', def.cpDisplay),
              cpRefName: def.cpDisplay,
              compare: compareRange(def.label, null)
            });
            return;
          }

          const valParts = splitSlashParts(pgCell.value);
          const tolParts = splitSlashParts(pgCell.tol);
          for (let i = 0; i < def.count; i++) {
            const cpItem = cpItems[i];
            const hasPgPart = !!valParts[i];
            // 관리계획서에도 없고 퍼징 작업지도서에도 없는 번호는 검사 대상이 아니다.
            // (관리계획서가 보압/보압2 두 개만 운용하는데 보압3까지 MISSING으로
            //  띄우던 문제를 막는다.)
            if (!cpItem && !hasPgPart) continue;

            // 공차가 하나만 적혀 있으면 값 전체에 동일하게 적용한다.
            const tol = tolParts.length > 1 ? (tolParts[i] || '') : (tolParts[0] || '');
            let partVal = valParts[i] || '';
            if (partVal && tol && !/±|\+\/-|\+-/.test(partVal)) partVal = `${partVal} ${tol}`;
            const partCell = Object.assign({}, pgCell, { value: partVal });
            const label = `${def.label} ${i + 1}`;
            const refName = `${def.cpBase}${i + 1}`;
            evaluate({
              pgLabel: label,
              pgCell: partCell,
              cpText: cpItem ? cpItem.spec : '',
              cpKeyword: cpKeywordOf(cpItem ? cpItem.processChar || cpItem.productChar : '', refName),
              cpRefName: refName,
              compare: compareRange(label, cpItem)
            });
          }
          return;
        }

        // 규격에 Front/Rear가 함께 들어있어 각각 따로 판단해야 하는 경우
        if (def.mode === 'frontrear') {
          const cpItem = findCpItemByCharName(cpParsed, def.cpNames[0]);
          const cpFR = cpItem ? extractFrontRearRange(cpItem.spec) : null;
          const pgText = pgCell ? (pgCell.combined || pgCell.value) : '';
          let pgFR = extractFrontRearRange(pgText);
          if (!pgFR) {
            // "60 / 70"처럼 Front/Rear 표기 없이 슬래시로만 나뉜 경우 앞을 Front로 본다.
            // ⚠️ 합성 문자열("60/70 ±5")을 그대로 쪼개면 공차가 뒤쪽 조각에만 붙어
            //    Front가 공차 없이 계산되므로, 값과 공차를 따로 나눠 양쪽에 적용한다.
            const valParts = splitSlashParts(pgCell ? pgCell.value : '');
            const tolParts = splitSlashParts(pgCell ? pgCell.tol : '');
            if (valParts.length >= 2) {
              const sideRange = (i) => {
                const tol = tolParts.length > 1 ? (tolParts[i] || '') : (tolParts[0] || '');
                let v = valParts[i];
                if (v && tol && !/±|\+\/-|\+-/.test(v)) v = `${v} ${tol}`;
                return extractNumericRange(v);
              };
              pgFR = { front: sideRange(0), rear: sideRange(1) };
            }
          }
          [['front', 'Front'], ['rear', 'Rear']].forEach(([key, sideName]) => {
            const label = `${def.label} (${sideName})`;
            const cpSide = cpFR ? cpFR[key] : null;
            const pgSide = pgFR ? pgFR[key] : null;
            const sideCell = pgCell
              ? Object.assign({}, pgCell, { value: pgSide ? fmtRange(pgSide) : '' })
              : pgCell;
            evaluate({
              pgLabel: label,
              pgCell: sideCell,
              cpText: cpSide ? fmtRange(cpSide) : '',
              cpKeyword: cpKeywordOf(cpItem ? `${cpItem.processChar || cpItem.productChar} - ${sideName}` : '', `${def.cpDisplay} - ${sideName}`),
              cpRefName: `${def.cpDisplay} - ${sideName}`,
              compare: (pgVal, cpText) => {
                if (!cpSide || !pgSide) {
                  return {
                    status: 'REVIEW',
                    note: `🔍 [REVIEW] 숫자 값으로 읽을 수 없어 직접 대조가 불가합니다. 작업자 직접 확인 필요. (관리계획서: ${cpText} / 퍼징 작업지도서: ${pgVal})`
                  };
                }
                const EPS = 0.01;
                const ok = (pgSide.min >= cpSide.min - EPS) && (pgSide.max <= cpSide.max + EPS);
                return ok
                  ? { status: 'MATCH', note: okNote(label, cpText, pgVal) }
                  : { status: 'MISMATCH', note: ngNote(label, cpText, pgVal) };
              }
            });
          });
          return;
        }

        // 단일 값 대 단일 규격
        const cpItem = findCpItemByCharName(cpParsed, def.cpNames[0]);
        const singleCell = pgCell
          ? Object.assign({}, pgCell, { value: pgCell.combined || pgCell.value })
          : pgCell;
        evaluate({
          pgLabel: def.label,
          pgCell: singleCell,
          cpText: cpItem ? cpItem.spec : '',
          cpKeyword: cpKeywordOf(cpItem ? cpItem.processChar || cpItem.productChar : '', def.cpDisplay),
          cpRefName: def.cpDisplay,
          compare: compareRange(def.label, cpItem)
        });
      });


    }

    // 관리계획서 쪽 근거 키워드를 "채택 키워드" 열에 싣기 위한 공용 헬퍼.
    function cpKeywordOfDd(foundLabel, fallbackName) {
      const v = (foundLabel === undefined || foundLabel === null) ? '' : String(foundLabel).trim();
      return v ? v : `${fallbackName} (관리계획서 미검출)`;
    }

    // ===================== 제습건조기 사용 관리 기준서 전용 정합성 검사 =====================
    // 퍼징 작업지도서와 같은 "역방향 대조" 방식이다. 기준서 안에 서식으로 정해져 있는
    // 항목을 뽑아 관리계획서와 맞춰본다. 3·4·5·6번 섹션만 검사하고, 각 섹션에서
    // 규칙이 정해진 항목만 자동 대조하며 나머지 항목은 전부 REVIEW(보라색)로 남긴다.

    const DD_DOC_NAME = '제습건조기 사용 관리 기준서';

    // '#'까지 무시하는 코드 비교(원재료 번호용). 예) #12345-67 == 1234567
    function normalizeMaterialNo(val) {
      if (isDashOrEmpty(val)) return '';
      return String(val).normalize('NFKC').replace(/[\s\-_#]/g, '').toLowerCase();
    }

    // 관리계획서 한 칸 안에 여러 항목이 몰려 있는 경우가 많다. 예:
    //   Part No. : #89992-0872
    //   Trade Name : LUPOX GP-1000M
    //   난연등급 : UL94HB
    //   Halogen등급 : Low Halogen
    // 여기서 요청한 라벨의 값만 정확히 끊어낸다. 예전에는 줄바꿈을 공백으로 바꾸고
    // 끝까지 읽어버려서 Trade Name 값에 난연등급·Halogen등급까지 딸려왔다.
    //
    // 값의 끝을 판단하는 기준:
    //   ① 줄바꿈 / "/" / ";" / "|" 구분자
    //   ② 뒤따라 나오는 다른 항목의 라벨(Trade Name, Part No 같은 명시적 라벨)
    //   ③ 뒤에 콜론이 또 나오면, 그 콜론 앞 단어부터가 다음 라벨이므로 그 앞에서 자름
    function cutInlineValue(v) {
      let s = String(v).split(/[\/;|]/)[0];

      const cuts = [];
      // ② 우리가 아는 명시적 라벨이 뒤에 또 나오는 경우
      [/trade\s*name/i, /part\s*n[o0]\b/i, /part\s*no\./i].forEach(re => {
        const m = s.match(re);
        if (m && m.index > 0) cuts.push(m.index);
      });
      // ③ 다음 콜론 앞의 라벨 토큰을 떼어낸다
      const ci = s.search(/[:：]/);
      if (ci > 0) {
        const head = s.slice(0, ci);
        const lastSpace = head.replace(/\s+$/, '').lastIndexOf(' ');
        cuts.push(lastSpace > 0 ? lastSpace : 0);
      }

      if (cuts.length > 0) s = s.slice(0, Math.min.apply(null, cuts));
      return s.trim().replace(/[.,;]+$/, '').trim();
    }

    function extractInlineLabeledValue(text, labelPattern) {
      if (!text) return '';
      const raw = String(text);
      // 줄 단위로 먼저 훑는다(실제 서식은 항목마다 줄이 나뉘어 있다).
      const lines = raw.split(/\r?\n/);
      const re = new RegExp(labelPattern.source + '\\s*[:：=]\\s*(.*)$', 'i');
      for (const line of lines) {
        const m = line.match(re);
        if (m && m[1] !== undefined) {
          const v = cutInlineValue(m[1]);
          if (v) return v;
        }
      }
      // 줄바꿈 없이 한 줄에 몰려 있는 경우
      const m2 = raw.replace(/\r?\n/g, ' ').match(re);
      if (m2 && m2[1] !== undefined) {
        const v = cutInlineValue(m2[1]);
        if (v) return v;
      }
      return '';
    }

    // 관리계획서에서 Trade Name / Part No가 적힌 칸을 찾아 값을 뽑는다.
    // 사용자 규칙상 "특성 No.1 항목의 공정특성"에 들어 있지만, 번호 열을 신뢰하기보다
    // 라벨 텍스트로 직접 찾는 편이 서식 변화에 강하다. 파싱된 항목에서 먼저 찾고,
    // 없으면 관리계획서 시트 전체를 훑는다.
    // 근거로 쓴 "그 한 줄"만 뽑아 채택 키워드에 싣는다. 칸 전체를 그대로 넣으면
    // 난연등급·Halogen등급까지 딸려와 표가 읽기 어려워진다.
    function pickInlineSourceLine(text, labelPattern) {
      const lines = String(text).split(/\r?\n/);
      const re = new RegExp(labelPattern.source, 'i');
      const hit = lines.find(l => re.test(l));
      const out = (hit || String(text)).replace(/\s+/g, ' ').trim();
      return out.length > 60 ? out.slice(0, 60) + '…' : out;
    }

    function extractCpInlineField(cpParsed, cpMatrix, labelPattern) {
      for (const it of (cpParsed || [])) {
        for (const f of [it.processChar, it.productChar, it.workElem]) {
          if (!f) continue;
          const v = extractInlineLabeledValue(f, labelPattern);
          if (v) return { value: v, source: pickInlineSourceLine(f, labelPattern) };
        }
      }
      for (let r = 0; r < cpMatrix.length; r++) {
        const row = cpMatrix[r];
        if (!Array.isArray(row)) continue;
        for (let c = 0; c < row.length; c++) {
          if (row[c] === undefined || row[c] === null) continue;
          const v = extractInlineLabeledValue(row[c], labelPattern);
          if (v) return { value: v, source: pickInlineSourceLine(row[c], labelPattern) };
        }
      }
      return null;
    }

    // 관리계획서 작업요소 칸에서 이름으로 항목을 찾는다(건조기 설정 온도 등).
    function findCpItemByWorkElem(cpParsed, needles) {
      const list = cpParsed || [];
      for (const n of needles) {
        const hit = list.find(it => pgNorm(it.workElem) === n);
        if (hit) return hit;
      }
      for (const n of needles) {
        const hit = list.find(it => pgNorm(it.workElem).includes(n));
        if (hit) return hit;
      }
      return null;
    }

    // ---------- 기준서에서 자동 대조하는 항목 정의 ----------
    // section: 문서상의 섹션 번호 / cpRef: 관리계획서 쪽 근거를 어떻게 찾을지
    const DD_COMPARE_DEFS = [
      // 3번 제품 정보 - 제품번호만 대조
      { id: 'dd_productNo', section: 3, label: '제품번호', patterns: [/제품번호|품번|part\.?no|제품no/], cpRef: 'productNo', kind: 'idCode' },

      // 4번 원재료 정보 및 수분 함습율
      { id: 'dd_matName', section: 4, label: '원재료 명', patterns: [/원재료명|원재료품명|재료명|material.*name/], cpRef: 'tradeName', kind: 'idCode' },
      { id: 'dd_matNo', section: 4, label: '원재료 번호', patterns: [/원재료번호|재료번호|material.*no/], cpRef: 'partNo', kind: 'materialNo' },
      { id: 'dd_stdMoisture', section: 4, label: '표준 수분 함습율', patterns: [/수분/, /함습율|함습률|함유율|함유률/], cpRef: 'moisture', kind: 'range' },

      // 5번 생산 설비 및 금형 정보, 제품 정보 (퍼징 작업지도서와 동일 알고리즘)
      { id: 'dd_equipNo', section: 5, label: '설비번호', patterns: [/설비번호|설비no|호기/], cpRef: 'equipNos', kind: 'equipList' },
      { id: 'dd_tonnage', section: 5, label: 'Tonnage', patterns: [/tonnage|톤수|형체력/], cpRef: 'tonnage', kind: 'tonnage' },
      { id: 'dd_moldNo', section: 5, label: '금형 No', patterns: [/금형no|금형번호|moldno/], cpRef: 'moldNos', kind: 'idList' },
      { id: 'dd_weightMin', section: 5, label: '제품 중량 Min', patterns: [/제품중량|중량/, /min|최소|하한/], cpRef: 'weightMin', kind: 'numeric' },
      { id: 'dd_weightMax', section: 5, label: '제품 중량 Max', patterns: [/제품중량|중량/, /max|최대|상한/], cpRef: 'weightMax', kind: 'numeric' },

      // 6번 원재료 사용 건조 시간 및 온도, 수분 함습율
      { id: 'dd_dryTemp', section: 6, label: '건조 온도', patterns: [/^건조온도|^건조기온도/], cpRef: 'dryTemp', kind: 'range' },
      { id: 'dd_moisture', section: 6, label: '수분 함습율', patterns: [/수분/, /함습율|함습률|함유율|함유률/], cpRef: 'moisture', kind: 'range' }
    ];

    // 6번 섹션에서 대조는 하지 않지만 REVIEW로 남길 항목.
    // 6번은 여기 정의된 것과 자동 대조 항목(건조 온도·수분 함습율) 외에는
    // 아예 검사 대상에서 뺀다(REVIEW도 SKIPPED도 만들지 않는다).
    const DD_S6_REVIEW_DEFS = [
      { id: 'dd_dryTime', label: '건조 시간', patterns: [/건조시간/] },
      { id: 'dd_setDryTemp', label: '설정 건조온도', patterns: [/설정건조온도|설정온도|건조기설정온도/] }
    ];

    // 자동 대조 대상 라벨인지 판단(나머지 항목을 REVIEW로 돌릴 때 제외하기 위함)
    function isDdComparedLabel(cellVal, section) {
      const t = pgNorm(cellVal);
      if (!t) return false;
      return DD_COMPARE_DEFS.some(def => def.section === section && def.patterns.every(p => p.test(t)));
    }

    // 섹션 구간 안에서 "헤더 행"에 적힌 라벨들을 모두 수집한다.
    // 이 서식은 헤더 행 아래에 값 행이 오는 구조라, 헤더로 판정된 행의 바로 다음 행은
    // 값 행으로 보고 건너뛴다. 그러지 않으면 값(예: 'PP-1234')까지 라벨로 오인한다.
    function enumerateDdLabels(matrix, startRow, endRow) {
      const out = [];
      const seen = new Set();
      // 숫자/공차로 시작하지 않는 칸을 "글자 칸"으로 본다.
      const isTextish = (v) => {
        const t = pgNorm(v);
        if (!t) return false;
        return !/^[±+\-]?\d/.test(t);
      };

      for (let r = Math.max(0, startRow); r < Math.min(matrix.length, endRow); r++) {
        const row = matrix[r];
        if (!Array.isArray(row)) continue;
        const textCells = [];
        for (let c = 0; c < row.length; c++) {
          const v = row[c];
          if (v === undefined || isDashOrEmpty(v)) continue;
          if (isPgSectionTitle(v)) { textCells.length = 0; break; }
          if (isTextish(v)) textCells.push({ c, v });
        }
        // 글자 칸이 2개 이상이어야 헤더 행으로 본다.
        if (textCells.length < 2) continue;

        textCells.forEach(({ c, v }) => {
          const key = pgNorm(v);
          if (!key || seen.has(key)) return;
          seen.add(key);
          out.push({ row: r, col: c, label: String(v).trim() });
        });
        r++; // 바로 아래 행은 값 행이므로 건너뛴다
      }
      return out;
    }

    // 기준서에서 3·4·5·6번 섹션 구간과 각 지정 항목을 뽑아낸다.
    function parseDryerGuideDoc(matrix) {
      const result = { fields: {}, sections: {}, otherLabels: {} };
      if (!matrix || matrix.length === 0) return result;

      const sec3 = findPgSectionRow(matrix, /제품정보/, 0);
      const sec4 = findPgSectionRow(matrix, /원재료정보|원재료.*함습|원재료정보및수분/, sec3 >= 0 ? sec3 + 1 : 0);
      const sec5 = findPgSectionRow(matrix, /생산설비.*금형|설비및금형/, sec4 >= 0 ? sec4 + 1 : 0);
      const sec6 = findPgSectionRow(matrix, /건조시간|건조.*온도.*함습|원재료사용건조/, sec5 >= 0 ? sec5 + 1 : 0);
      result.sections = { sec3, sec4, sec5, sec6 };

      const bounds = {
        3: [sec3 >= 0 ? sec3 : 0, sec4 >= 0 ? sec4 : (sec5 >= 0 ? sec5 : matrix.length)],
        4: [sec4 >= 0 ? sec4 : 0, sec5 >= 0 ? sec5 : (sec6 >= 0 ? sec6 : matrix.length)],
        5: [sec5 >= 0 ? sec5 : 0, sec6 >= 0 ? sec6 : matrix.length],
        6: [sec6 >= 0 ? sec6 : 0, matrix.length]
      };

      DD_COMPARE_DEFS.forEach(def => {
        const [s, e] = bounds[def.section];
        const labelCell = findPgLabelCell(matrix, s, e, def.patterns);
        if (!labelCell) {
          result.fields[def.id] = { value: '', tol: '', combined: '', row: -1, col: -1, found: false, labelFound: false, label: def.label };
          return;
        }
        const cell = readPgConditionCell(matrix, labelCell, e);
        cell.label = def.label;
        cell.labelCell = labelCell;
        result.fields[def.id] = cell;
      });

      // 6번의 REVIEW 전용 항목(건조 시간 / 설정 건조온도)
      result.s6Review = {};
      DD_S6_REVIEW_DEFS.forEach(def => {
        const [s6s, s6e] = bounds[6];
        const labelCell = findPgLabelCell(matrix, s6s, s6e, def.patterns);
        if (!labelCell) {
          result.s6Review[def.id] = null;
          return;
        }
        const cell = readPgValueCell(matrix, labelCell, s6e);
        cell.label = def.label;
        result.s6Review[def.id] = cell;
      });

      // 자동 대조 규칙이 없는 나머지 항목들 → REVIEW 대상.
      // 6번은 제외한다. 6번은 건조 온도·수분 함습율만 대조하고, 건조 시간·설정
      // 건조온도만 REVIEW로 남기며, 그 외 항목은 아예 검사하지 않는다.
      [3, 4, 5].forEach(sec => {
        const [s, e] = bounds[sec];
        result.otherLabels[sec] = enumerateDdLabels(matrix, s, e)
          .filter(l => !isDdComparedLabel(l.label, sec));
      });

      return result;
    }

    function runDryerGuideAnalysis(cpMatrix, cpParsed) {
      if (!isDocUploaded('dd')) return;

      const ddMatrix = getMatrixFromDocData('dd');
      const pushRow = (o) => {
        analysisResults.push({
          rawMethod: '(제습건조기 사용 관리 기준서 직접 대조)',
          targetDoc: DD_DOC_NAME,
          processName: '제습건조기 기준서 대조',
          chosenKeyword: o.cpKeyword || '-',
          chosenType: '제습건조기 지정항목 직접 대조',
          simPercent: o.status === 'MATCH' ? 100 : 0,
          cpSpec: (o.cpText && String(o.cpText).trim()) || '-',
          targetKeyword: o.ddLabel,
          targetSpec: (o.ddCell && o.ddCell.value) ? o.ddCell.value : '-',
          status: o.status,
          detailNote: o.note,
          _cpItem: null,
          _targetItem: (o.ddCell && o.ddCell.labelFound) ? makePgTargetItem(ddMatrix, o.ddCell) : null,
          _pgDirect: true
        });
      };

      if (!ddMatrix || ddMatrix.length === 0) {
        pushRow({
          ddLabel: DD_DOC_NAME, ddCell: null, cpText: '', cpKeyword: '-', status: 'REVIEW',
          note: '🔍 [REVIEW] 제습건조기 사용 관리 기준서 파일에서 데이터를 읽지 못했습니다. 작업자 직접 확인 필요.'
        });
        return;
      }

      const dd = parseDryerGuideDoc(ddMatrix);
      const ref = extractCpPurgingRefs(cpMatrix, cpParsed);
      const tradeName = extractCpInlineField(cpParsed, cpMatrix, /trade\s*name/);
      const partNo = extractCpInlineField(cpParsed, cpMatrix, /part\s*n[o0]\.?/);
      const moistureItem = findCpItemByCharName(cpParsed, ['수분함유율', '수분함유률', '수분함습율', '수분율']);
      const dryTempItem = findCpItemByWorkElem(cpParsed, ['건조기설정온도', '건조기온도', '건조설정온도'])
        || findCpItemByCharName(cpParsed, ['건조기설정온도', '건조기온도']);

      const okNoteDd = (label, cpText, ddText) =>
        `✅ [MATCH] 제습건조기 기준서 '${label}' 값이 관리계획서와 일치합니다. (관리계획서: ${cpText} / 제습건조기 기준서: ${ddText})`;
      const ngNoteDd = (label, cpText, ddText) =>
        `❌ [MISMATCH] 제습건조기 기준서 '${label}' 값이 관리계획서와 다릅니다. (관리계획서: ${cpText} / 제습건조기 기준서: ${ddText})`;

      // 퍼징 쪽 evaluate와 같은 판정 흐름
      const evaluateDd = (f) => {
        const base = { ddLabel: f.ddLabel, ddCell: f.ddCell, cpText: f.cpText, cpKeyword: f.cpKeyword };
        if (!f.ddCell || !f.ddCell.labelFound) {
          pushRow(Object.assign({}, base, {
            status: 'MISSING',
            note: `⚠️ [MISSING] 제습건조기 기준서에서 '${f.ddLabel}' 항목 자체를 찾지 못했습니다.`
          }));
          return;
        }
        if (isDashOrEmpty(f.ddCell.value)) {
          pushRow(Object.assign({}, base, {
            status: 'MISSING',
            note: `⚠️ [MISSING] 제습건조기 기준서에 '${f.ddLabel}' 값이 기재되어 있지 않습니다. (관리계획서: ${f.cpText || '미기재'})`
          }));
          return;
        }
        if (isDashOrEmpty(f.cpText)) {
          pushRow(Object.assign({}, base, {
            status: 'REVIEW',
            note: `🔍 [REVIEW] 관리계획서에서 '${f.cpRefName}' 기준값을 찾지 못했습니다. 작업자 직접 확인 필요. (제습건조기 기준서: ${f.ddCell.value})`
          }));
          return;
        }
        const { status, note } = f.compare(f.ddCell.value, f.cpText);
        pushRow(Object.assign({}, base, { status, note }));
      };

      // 값 ± 공차 → 범위로 환산해 관리계획서 규격 범위와 대조
      const compareRangeDd = (label, cpItem) => (ddVal, cpText) => {
        const cpRange = cpRangeOfItem(cpItem);
        const ddRange = extractNumericRange(ddVal);
        if (!cpRange || !ddRange) {
          return {
            status: 'REVIEW',
            note: `🔍 [REVIEW] 숫자 값으로 읽을 수 없어 직접 대조가 불가합니다. 작업자 직접 확인 필요. (관리계획서: ${cpText} / 제습건조기 기준서: ${ddVal})`
          };
        }
        const EPS = 0.01;
        const ok = (ddRange.min >= cpRange.min - EPS) && (ddRange.max <= cpRange.max + EPS);
        return ok
          ? { status: 'MATCH', note: okNoteDd(label, `${cpText} → ${fmtRange(cpRange)}`, `${ddVal} → ${fmtRange(ddRange)}`) }
          : { status: 'MISMATCH', note: ngNoteDd(label, `${cpText} → ${fmtRange(cpRange)}`, `${ddVal} → ${fmtRange(ddRange)}`) };
      };

      const compareNumericDd = (label) => (ddVal, cpVal) => {
        const a = toNumberLoose(ddVal);
        const b = toNumberLoose(cpVal);
        if (a === null || b === null) {
          return normalizeIdCode(ddVal) === normalizeIdCode(cpVal)
            ? { status: 'MATCH', note: okNoteDd(label, cpVal, ddVal) }
            : {
              status: 'REVIEW',
              note: `🔍 [REVIEW] 숫자 값으로 읽을 수 없어 직접 대조가 불가합니다. 작업자 직접 확인 필요. (관리계획서: ${cpVal} / 제습건조기 기준서: ${ddVal})`
            };
        }
        return Math.abs(a - b) < 1e-9
          ? { status: 'MATCH', note: okNoteDd(label, cpVal, ddVal) }
          : { status: 'MISMATCH', note: ngNoteDd(label, cpVal, ddVal) };
      };

      const equipList = ref.equipNos.values;
      const equipText = equipList.length > 0 ? equipList.slice(0, 5).join(', ') + (equipList.length > 5 ? ` 외 ${equipList.length - 5}건` : '') : '';
      const moldList = ref.moldNos.values;
      const moldText = moldList.length > 0 ? moldList.slice(0, 5).join(', ') + (moldList.length > 5 ? ` 외 ${moldList.length - 5}건` : '') : '';
      const wItem = ref.weightItem;

      // cpRef 종류별로 "관리계획서 기준값 / 채택 키워드 / 비교 함수"를 정한다.
      const cpRefResolvers = {
        productNo: (def) => ({
          cpText: ref.productNo ? ref.productNo.value : '',
          cpKeyword: cpKeywordOfDd(ref.productNo && ref.productNo.loc ? ref.productNo.loc.label : '', '제품번호'),
          cpRefName: '제품번호',
          compare: (ddVal, cpVal) => normalizeIdCode(ddVal) === normalizeIdCode(cpVal)
            ? { status: 'MATCH', note: okNoteDd(def.label, cpVal, ddVal) }
            : { status: 'MISMATCH', note: ngNoteDd(def.label, cpVal, ddVal) }
        }),
        tradeName: (def) => ({
          cpText: tradeName ? tradeName.value : '',
          cpKeyword: cpKeywordOfDd(tradeName ? `공정특성: ${tradeName.source}` : '', '공정특성 - Trade Name'),
          cpRefName: '공정특성 - Trade Name',
          compare: (ddVal, cpVal) => normalizeIdCode(ddVal) === normalizeIdCode(cpVal)
            ? { status: 'MATCH', note: okNoteDd(def.label, cpVal, ddVal) }
            : { status: 'MISMATCH', note: ngNoteDd(def.label, cpVal, ddVal) }
        }),
        partNo: (def) => ({
          cpText: partNo ? partNo.value : '',
          cpKeyword: cpKeywordOfDd(partNo ? `공정특성: ${partNo.source}` : '', '공정특성 - Part No'),
          cpRefName: '공정특성 - Part No',
          // 원재료 번호는 '#'까지 무시하고 비교한다.
          compare: (ddVal, cpVal) => normalizeMaterialNo(ddVal) === normalizeMaterialNo(cpVal)
            ? { status: 'MATCH', note: okNoteDd(def.label, cpVal, ddVal) }
            : { status: 'MISMATCH', note: ngNoteDd(def.label, cpVal, ddVal) }
        }),
        moisture: (def) => ({
          cpText: moistureItem ? moistureItem.spec : '',
          cpKeyword: cpKeywordOfDd(moistureItem ? moistureItem.processChar || moistureItem.productChar : '', '수분 함유율'),
          cpRefName: '수분 함유율',
          compare: compareRangeDd(def.label, moistureItem)
        }),
        dryTemp: (def) => ({
          cpText: dryTempItem ? dryTempItem.spec : '',
          cpKeyword: cpKeywordOfDd(dryTempItem ? `작업요소: ${dryTempItem.workElem || dryTempItem.processChar}` : '', '작업요소 - 건조기 설정 온도'),
          cpRefName: '작업요소 - 건조기 설정 온도',
          compare: compareRangeDd(def.label, dryTempItem)
        }),
        equipNos: (def) => ({
          cpText: equipText,
          cpKeyword: cpKeywordOfDd(ref.equipNos.loc ? ref.equipNos.loc.label : '', '대상설비'),
          cpRefName: '대상설비',
          compare: (ddVal) => equipList.some(v => normalizeEquipNo(v) === normalizeEquipNo(ddVal))
            ? { status: 'MATCH', note: okNoteDd(def.label, equipText, ddVal) }
            : { status: 'MISMATCH', note: ngNoteDd(def.label, equipText, ddVal) }
        }),
        idList: null,
        moldNos: (def) => ({
          cpText: moldText,
          cpKeyword: cpKeywordOfDd(ref.moldNos.loc ? ref.moldNos.loc.label : '', 'Tool 번호'),
          cpRefName: 'Tool 번호',
          compare: (ddVal) => moldList.some(v => normalizeIdCode(v) === normalizeIdCode(ddVal))
            ? { status: 'MATCH', note: okNoteDd(def.label, moldText, ddVal) }
            : { status: 'MISMATCH', note: ngNoteDd(def.label, moldText, ddVal) }
        }),
        tonnage: (def) => ({
          cpText: ref.tonnage ? ref.tonnage.value : '',
          cpKeyword: cpKeywordOfDd(ref.tonnage ? `작업요소: ${ref.tonnage.source}` : '', '작업요소 - 사출성형장치'),
          cpRefName: '작업요소 - 사출성형장치',
          compare: (ddVal, cpVal) => {
            if (normalizeTonnage(ddVal) === normalizeTonnage(cpVal)) {
              return { status: 'MATCH', note: okNoteDd(def.label, cpVal, ddVal) };
            }
            const a = toNumberLoose(ddVal);
            const b = toNumberLoose(cpVal);
            if (a !== null && b !== null && Math.abs(a - b) < 1e-9) {
              return {
                status: 'REVIEW',
                note: `🔍 [REVIEW] 숫자 값은 같으나 표기가 다릅니다. 작업자 직접 확인 필요. (관리계획서: ${cpVal} / 제습건조기 기준서: ${ddVal})`
              };
            }
            return { status: 'MISMATCH', note: ngNoteDd(def.label, cpVal, ddVal) };
          }
        }),
        weightMin: (def) => ({
          cpText: wItem ? wItem.lower : '',
          cpKeyword: cpKeywordOfDd(wItem ? `${wItem.productChar} (규격 하한)` : '', '제품 중량 검사 (규격 하한)'),
          cpRefName: '제품 중량 검사 (규격 하한)',
          compare: compareNumericDd(def.label)
        }),
        weightMax: (def) => ({
          cpText: wItem ? wItem.upper : '',
          cpKeyword: cpKeywordOfDd(wItem ? `${wItem.productChar} (규격 상한)` : '', '제품 중량 검사 (규격 상한)'),
          cpRefName: '제품 중량 검사 (규격 상한)',
          compare: compareNumericDd(def.label)
        })
      };

      DD_COMPARE_DEFS.forEach(def => {
        const resolver = cpRefResolvers[def.cpRef];
        if (!resolver) return;
        const r = resolver(def);
        const cell = dd.fields[def.id];
        // 범위 비교 항목은 값 + 공차를 합쳐서 넘긴다.
        const useCell = (def.kind === 'range' && cell)
          ? Object.assign({}, cell, { value: cell.combined || cell.value })
          : cell;
        evaluateDd({
          ddLabel: def.label,
          ddCell: useCell,
          cpText: r.cpText,
          cpKeyword: r.cpKeyword,
          cpRefName: r.cpRefName,
          compare: r.compare
        });
      });

      // 6번: 건조 시간 / 설정 건조온도는 대조하지 않고 REVIEW로만 남긴다.
      DD_S6_REVIEW_DEFS.forEach(def => {
        const cell = dd.s6Review ? dd.s6Review[def.id] : null;
        if (!cell || !cell.labelFound) return;   // 문서에 없으면 아무 것도 만들지 않는다
        pushRow({
          ddLabel: def.label,
          ddCell: cell,
          cpText: '',
          cpKeyword: '-',
          status: 'REVIEW',
          note: `🔍 [REVIEW] '${def.label}' 항목은 자동 대조 규칙이 없습니다. 작업자 직접 확인 필요.`
        });
      });

      // 자동 대조 규칙이 없는 나머지 항목은 REVIEW로 남겨 작업자가 확인하게 한다.
      // (3·4·5번 한정. 6번은 위에서 지정한 두 항목만 다룬다.)
      [3, 4, 5].forEach(sec => {
        (dd.otherLabels[sec] || []).forEach(l => {
          const cell = readPgValueCell(ddMatrix, l, ddMatrix.length);
          pushRow({
            ddLabel: l.label,
            ddCell: cell,
            cpText: '',
            cpKeyword: '-',
            status: 'REVIEW',
            note: `🔍 [REVIEW] '${l.label}' 항목은 자동 대조 규칙이 없습니다. 작업자 직접 확인 필요.`
          });
        });
      });
    }

    function runAnalysis() {
      try {
        // 여러 시트가 있는 파일 중 사용자가 아직 확인하지 않은(자동 추정값을 그대로 쓰는) 파일이
        // 있으면 분석을 막는다. 확인 없이 진행하면 "51115-1611#3"처럼 실제로 채워 넣은 시트가
        // 아니라 "OO 수정" 같은 작업용 사본 시트가 조용히 검사·표시 대상이 될 수 있다.
        const unconfirmed = getUnconfirmedMultiSheetFiles();
        if (unconfirmed.length > 0) {
          const names = unconfirmed.map(u => `${u.fileName} (${bi('현재 선택', 'currently')}: ${u.activeSheet})`).join('\n');
          showToast(bi(
            `⚠️ 시트가 여러 개인 파일이 있습니다. 시트 선택 드롭다운에서 확인 버튼을 눌러주세요: ${unconfirmed.map(u => u.fileName).join(', ')}`,
            `⚠️ Some files have multiple sheets. Please confirm the sheet selection: ${unconfirmed.map(u => u.fileName).join(', ')}`
          ), 'error');
          alert(bi(
            `⚠️ 다음 파일은 시트가 여러 개인데 아직 확인되지 않았습니다.\n자동으로 고른 시트가 실제로 맞는 시트인지 확인 후 분석을 다시 시작해 주세요.\n\n${names}`,
            `⚠️ The following files have multiple sheets and have not been confirmed yet.\nPlease verify the auto-selected sheet is correct, then restart the analysis.\n\n${names}`
          ));
          return;
        }

        if (!isDocUploaded('cp')) {
          showToast(bi(
            '⚠️ [관리계획서 (Control Plan)] 파일을 먼저 업로드해 주세요.',
            '⚠️ Please upload the [Control Plan] file first.'
          ), 'error');
          alert(bi(
            '⚠️ 상위 기준 문서인 [관리계획서 (Control Plan)] 파일(필수)을 선택해 주세요.',
            '⚠️ Please select the master reference document, [Control Plan] (required).'
          ));
          return;
        }

        const cpMatrix = getMatrixFromDocData('cp');
        if (!cpMatrix || cpMatrix.length === 0) {
          showToast(bi(
            '⚠️ [관리계획서] 파일에서 파싱된 데이터가 없습니다. 파일 업로드가 완료되었는지 확인해 주세요.',
            '⚠️ No parsed data found in the [Control Plan] file. Please confirm the upload finished successfully.'
          ), 'error');
          alert(bi(
            '⚠️ [관리계획서] 파일에서 데이터를 읽지 못했습니다. 파일 파싱 완료 후 다시 시도해 주세요.',
            '⚠️ Could not read data from the [Control Plan] file. Please wait for parsing to finish and try again.'
          ));
          return;
        }

        analysisResults = [];
        const cpParsed = parseControlPlan(cpMatrix);
        if (!cpParsed || cpParsed.length === 0) {
          showToast(bi(
            '⚠️ 관리계획서 시트에서 공정/특성 행을 찾지 못했습니다. 시트 선택 상태를 확인해 주세요.',
            '⚠️ Could not find process/characteristic rows in the Control Plan sheet. Please check the selected sheet.'
          ), 'error');
        }

        const targetDocs = {};
        const uploadedDocNames = [];

        ['is', 'eq', 'sc', 'wc'].forEach(key => {
          if (isDocUploaded(key)) {
            const matrix = getMatrixFromDocData(key);
            const docName = DOC_KEYS[key];
            if (key === 'is') {
              targetDocs[docName] = parseInspectionStandardDoc(matrix);
            } else if (key === 'sc') {
              targetDocs[docName] = parseScrewLogDoc(matrix);
            } else {
              targetDocs[docName] = parseGenericDoc(matrix, docName);
            }
            uploadedDocNames.push(docName);
          }
        });

        cpParsed.forEach(cpItem => {
          const rawMethod = cpItem.rawMethod;
          const normalizedTargetDoc = normalizeTargetDoc(rawMethod);

          if (!normalizedTargetDoc) {
            analysisResults.push({
              rawMethod: rawMethod || '(미기재)',
              targetDoc: '비대상 문서',
              processName: cpItem.processName,
              chosenKeyword: cpItem.productChar || cpItem.processChar || cpItem.workElem || '-',
              chosenType: '비대상 (SKIP)',
              simPercent: 0,
              cpSpec: formatCpSpecWithUnit(cpItem.spec, cpItem.unit),
              targetKeyword: '-',
              targetSpec: '-',
              status: 'SKIPPED',
              detailNote: `관리표준/기록방법 [${rawMethod || '미기재'}] 이(가) 4대 검사 대상 문서에 해당하지 않아 검사 패스(SKIPPED) 처리`
            });
            return;
          }

          const isFileUploaded = uploadedDocNames.includes(normalizedTargetDoc);
          if (!isFileUploaded) {
            analysisResults.push({
              rawMethod: rawMethod,
              targetDoc: normalizedTargetDoc,
              processName: cpItem.processName,
              chosenKeyword: cpItem.productChar || cpItem.processChar || cpItem.workElem || '-',
              chosenType: '미검사',
              simPercent: 0,
              cpSpec: cpItem.spec,
              targetKeyword: '-',
              targetSpec: '-',
              status: 'SKIPPED',
              detailNote: `지정 문서 [${normalizedTargetDoc}] 파일이 업로드되지 않아 검사 패스`
            });
            return;
          }

          const targetItems = targetDocs[normalizedTargetDoc] || [];

          if (normalizedTargetDoc === '검사표준서') {
            const rawCpProduct = cpItem.productChar || cpItem.processChar || '';
            const normCpProduct = normalizeProductFeature(rawCpProduct);

            if (!normCpProduct || isDashOrEmpty(rawCpProduct)) return;

            const exactTItem = targetItems.find(tItem => {
              const normTargetProduct = normalizeProductFeature(tItem.productChar || tItem.keyword || '');
              return normTargetProduct === normCpProduct;
            });

            if (exactTItem) {
              const isVerification = verifyInspectionStandardMatch(cpItem, exactTItem);
              const status = isVerification.isMatch ? 'MATCH' : 'MISMATCH';
              analysisResults.push({
                rawMethod: rawMethod,
                targetDoc: normalizedTargetDoc,
                processName: cpItem.processName,
                chosenKeyword: cpItem.productChar || rawCpProduct || '-',
                chosenType: '제품특성 Exact Match',
                simPercent: 100,
                cpSpec: formatCpSpecWithUnit(cpItem.spec, cpItem.unit),
                targetKeyword: exactTItem.productChar || exactTItem.keyword || '-',
                targetSpec: isVerification.targetDisplaySpec || exactTItem.spec || '-',
                status: status,
                detailNote: isVerification.detailNote,
                paramResults: isVerification.paramResults,
                _cpItem: cpItem,
                _targetItem: exactTItem
              });

              return;
            }

            let maxSim = 0;
            let bestFuzzyCandidate = null;
            targetItems.forEach(tItem => {
              const tProd = tItem.productChar || tItem.keyword || '';
              const sim = calculateKeywordMatchScore(rawCpProduct, tProd);
              if (sim > maxSim) {
                maxSim = sim;
                bestFuzzyCandidate = tItem;
              }
            });

            const simPct = Math.round(maxSim * 100);
            if (maxSim >= 0.70 && bestFuzzyCandidate) {
              const candText = bestFuzzyCandidate.productChar || bestFuzzyCandidate.keyword || '-';
              const isVerification = verifyInspectionStandardMatch(cpItem, bestFuzzyCandidate);
              analysisResults.push({
                rawMethod: rawMethod,
                targetDoc: normalizedTargetDoc,
                processName: cpItem.processName,
                chosenKeyword: cpItem.productChar || rawCpProduct || '-',
                chosenType: `제품특성 유사도 ${simPct}% (검토필요)`,
                simPercent: simPct,
                cpSpec: formatCpSpecWithUnit(cpItem.spec, cpItem.unit),
                targetKeyword: candText,
                targetSpec: isVerification.targetDisplaySpec || bestFuzzyCandidate.spec || '-',
                status: 'REVIEW',
                detailNote: `🔍 [REVIEW - 유사도 ${simPct}%] 검사표준서 제품특성 '${rawCpProduct}' Exact Match 없음. 가장 유사한 후보 발견: '${candText}'.\n` + isVerification.detailNote,
                paramResults: isVerification.paramResults,
                _cpItem: cpItem,
                _targetItem: bestFuzzyCandidate
              });
            } else {
              analysisResults.push({
                rawMethod: rawMethod,
                targetDoc: normalizedTargetDoc,
                processName: cpItem.processName,
                chosenKeyword: cpItem.productChar || rawCpProduct || '-',
                chosenType: '제품특성 미존재',
                simPercent: simPct,
                cpSpec: formatCpSpecWithUnit(cpItem.spec, cpItem.unit),
                targetKeyword: bestFuzzyCandidate ? (bestFuzzyCandidate.productChar || bestFuzzyCandidate.keyword) : '-',
                targetSpec: bestFuzzyCandidate ? (bestFuzzyCandidate.nominal || bestFuzzyCandidate.spec) : '-',
                status: 'MISSING',
                detailNote: `❌ [MISSING] 검사표준서 제품특성 '${rawCpProduct}' 일치 항목 없음.`,
                _cpItem: cpItem
              });
            }
            return;
          }

          let k1 = cpItem.processChar;
          let k2 = cpItem.workElem;

          const hasK1 = k1 && !isDashOrEmpty(k1);
          let hasK2 = k2 && !isDashOrEmpty(k2);

          if (!hasK1 && !hasK2) return;

          // [1단계] 관리계획서의 공정특성에 있는 항목이 대상문서 항목에 100% 일치하는 항목이 있을 경우 채택 후 규격 비교로 판정
          if (hasK1) {
            const { cpIndex: cpIdx1, isIndexed: isIndexed1 } = parseIndexedKeyword(k1);
            const exactTItem1 = targetItems.find(tItem => checkExactKeywordMatch(k1, tItem, cpIdx1));
            if (exactTItem1) {
              // 사출속도1/사출속도2, 보압/보압2처럼 관리계획서에 실제로 짝이 되는 인덱스
              // 항목이 존재할 때만, 대상문서엔 "85/45±10" 같은 단일 통합 항목으로
              // 표기된 값에서 인덱스에 맞는 값만 잘라낸다.
              // 짝이 없는 단독 항목(예: "Front : 35 / Rear : 40"처럼 규격 자체가 라벨로
              // 합쳐진 경우)은 자르지 않고 원본 그대로 비교해야 Front/Rear 비교 로직이 동작한다.
              const shouldSlice1 = isIndexed1 || hasIndexedSibling(item => item.processChar, k1, cpParsed);
              const slicedSpec1 = shouldSlice1 ? extractTargetSpecForIndex(exactTItem1.spec, cpIdx1) : exactTItem1.spec;
              const tItemForCompare1 = (slicedSpec1 !== exactTItem1.spec)
                ? Object.assign({}, exactTItem1, { spec: slicedSpec1 })
                : exactTItem1;
              const specCheck1 = verifySpecAndUnitMatch(cpItem, tItemForCompare1);
              analysisResults.push({
                rawMethod: rawMethod,
                targetDoc: normalizedTargetDoc,
                processName: cpItem.processName,
                chosenKeyword: k1,
                chosenType: '공정특성명 (100% Exact Match)',
                simPercent: 100,
                cpSpec: cpItem.spec,
                targetKeyword: getTargetDisplayKeyword(exactTItem1),
                targetSpec: formatCpSpecWithUnit(slicedSpec1, exactTItem1.unit) || '-',
                status: specCheck1.status,
                detailNote: specCheck1.detailNote,
                _cpItem: cpItem,
                _targetItem: exactTItem1
              });
              return;
            }
          }

          // [2단계] 1의 경우가 없을 경우 관리계획서의 작업요소에 있는 항목이 대상문서 항목에 100% 일치하는 항목이 있을 경우 채택 후 규격 비교로 판정
          if (hasK2) {
            const { cpIndex: cpIdx2, isIndexed: isIndexed2 } = parseIndexedKeyword(k2);
            const exactTItem2 = targetItems.find(tItem => checkExactKeywordMatch(k2, tItem, cpIdx2));
            if (exactTItem2) {
              const shouldSlice2 = isIndexed2 || hasIndexedSibling(item => item.workElem, k2, cpParsed);
              const slicedSpec2 = shouldSlice2 ? extractTargetSpecForIndex(exactTItem2.spec, cpIdx2) : exactTItem2.spec;
              const tItemForCompare2 = (slicedSpec2 !== exactTItem2.spec)
                ? Object.assign({}, exactTItem2, { spec: slicedSpec2 })
                : exactTItem2;
              const specCheck2 = verifySpecAndUnitMatch(cpItem, tItemForCompare2);
              analysisResults.push({
                rawMethod: rawMethod,
                targetDoc: normalizedTargetDoc,
                processName: cpItem.processName,
                chosenKeyword: k2,
                chosenType: '작업요소명 (100% Exact Match)',
                simPercent: 100,
                cpSpec: cpItem.spec,
                targetKeyword: getTargetDisplayKeyword(exactTItem2),
                targetSpec: formatCpSpecWithUnit(slicedSpec2, exactTItem2.unit) || '-',
                status: specCheck2.status,
                detailNote: specCheck2.detailNote,
                _cpItem: cpItem,
                _targetItem: exactTItem2
              });
              return;
            }
          }

          // [3단계] 2의 경우가 없을 경우 관리계획서의 공정특성에 있는 항목이 대상문서 항목에 유사도 70% 이상 만족하는 경우가 있을 경우 채택 후 판정결과는 REVIEW
          if (hasK1) {
            let maxSim1 = 0;
            let bestCandidate1 = null;
            targetItems.forEach(tItem => {
              const targetText = tItem.keyword || tItem.combinedKeyword || '';
              const sim = calculateKeywordMatchScore(k1, targetText);
              if (sim > maxSim1) {
                maxSim1 = sim;
                bestCandidate1 = tItem;
              }
            });

            if (maxSim1 >= 0.70 && bestCandidate1) {
              const simPct = Math.round(maxSim1 * 100);
              const candText = getTargetDisplayKeyword(bestCandidate1);
              const { cpIndex: cpIdx1r, isIndexed: isIndexed1r } = parseIndexedKeyword(k1);
              const shouldSlice1r = isIndexed1r || hasIndexedSibling(item => item.processChar, k1, cpParsed);
              const slicedSpec1r = shouldSlice1r ? extractTargetSpecForIndex(bestCandidate1.spec, cpIdx1r) : bestCandidate1.spec;
              // 대상문서에 "키워드 (Front)"/"키워드 (Rear)"로 나뉜 짝이 있으면 합쳐서 함께 보여준다.
              const merged1 = mergeFrontRearTargetSpec(bestCandidate1, targetItems);
              const displayTargetKeyword1 = merged1 ? merged1.keyword : candText;
              const displayTargetSpec1 = merged1
                ? formatCpSpecWithUnit(merged1.spec, merged1.unit)
                : (formatCpSpecWithUnit(slicedSpec1r, bestCandidate1.unit) || '-');
              analysisResults.push({
                rawMethod: rawMethod,
                targetDoc: normalizedTargetDoc,
                processName: cpItem.processName,
                chosenKeyword: k1,
                chosenType: `공정특성 유사도 ${simPct}% (검토필요)`,
                simPercent: simPct,
                cpSpec: cpItem.spec,
                targetKeyword: displayTargetKeyword1,
                targetSpec: displayTargetSpec1,
                status: 'REVIEW',
                detailNote: `🔍 [REVIEW - 유사도 ${simPct}%] 공정특성 Exact Match 없음. 가장 유사한 후보 발견: '${candText}'.${merged1 ? ' (Front/Rear 짝을 찾아 함께 표기함)' : ''} 작업자 직접 동일 여부 확인 필요.`,
                _cpItem: cpItem,
                // Front/Rear 짝을 합친 경우엔 원본 셀 좌표를 가진 실제 항목이 아니라
                // 합성된 객체이므로, 이때만 예전 방식(키워드 재검색)으로 대체한다.
                _targetItem: merged1 ? null : bestCandidate1
              });
              return;
            }
          }

          // [4단계] 3의 경우가 없을 경우 관리계획서의 작업요소에 있는 항목이 대상문서 항목에 유사도 70% 이상 만족하는 경우가 있을 경우 채택 후 판정결과는 REVIEW
          if (hasK2) {
            let maxSim2 = 0;
            let bestCandidate2 = null;
            targetItems.forEach(tItem => {
              const targetText = tItem.keyword || tItem.combinedKeyword || '';
              const sim = calculateKeywordMatchScore(k2, targetText);
              if (sim > maxSim2) {
                maxSim2 = sim;
                bestCandidate2 = tItem;
              }
            });

            if (maxSim2 >= 0.70 && bestCandidate2) {
              const simPct = Math.round(maxSim2 * 100);
              const candText = getTargetDisplayKeyword(bestCandidate2);
              const { cpIndex: cpIdx2r, isIndexed: isIndexed2r } = parseIndexedKeyword(k2);
              const shouldSlice2r = isIndexed2r || hasIndexedSibling(item => item.workElem, k2, cpParsed);
              const slicedSpec2r = shouldSlice2r ? extractTargetSpecForIndex(bestCandidate2.spec, cpIdx2r) : bestCandidate2.spec;
              const merged2 = mergeFrontRearTargetSpec(bestCandidate2, targetItems);
              const displayTargetKeyword2 = merged2 ? merged2.keyword : candText;
              const displayTargetSpec2 = merged2
                ? formatCpSpecWithUnit(merged2.spec, merged2.unit)
                : (formatCpSpecWithUnit(slicedSpec2r, bestCandidate2.unit) || '-');
              analysisResults.push({
                rawMethod: rawMethod,
                targetDoc: normalizedTargetDoc,
                processName: cpItem.processName,
                chosenKeyword: k2,
                chosenType: `작업요소 유사도 ${simPct}% (검토필요)`,
                simPercent: simPct,
                cpSpec: cpItem.spec,
                targetKeyword: displayTargetKeyword2,
                targetSpec: displayTargetSpec2,
                status: 'REVIEW',
                detailNote: `🔍 [REVIEW - 유사도 ${simPct}%] 작업요소 Exact Match 없음. 가장 유사한 후보 발견: '${candText}'.${merged2 ? ' (Front/Rear 짝을 찾아 함께 표기함)' : ''} 작업자 직접 동일 여부 확인 필요.`,
                _cpItem: cpItem,
                _targetItem: merged2 ? null : bestCandidate2
              });
              return;
            }
          }

          // [5단계] 4의 경우가 없을 경우 유사도 70% 미만이므로 MISSING으로 판별
          analysisResults.push({
            rawMethod: rawMethod,
            targetDoc: normalizedTargetDoc,
            processName: cpItem.processName,
            chosenKeyword: k1 || k2 || '-',
            chosenType: 'Exact Match 및 유사도 기준 미달',
            simPercent: 0,
            cpSpec: cpItem.spec,
            targetKeyword: '-',
            targetSpec: '-',
            status: 'MISSING',
            detailNote: `❌ [MISSING] 공정특성/작업요소 Exact Match 없음 및 최고 유사도 70% 미만.`,
            _cpItem: cpItem
          });
        });

        // 퍼징 작업지도서는 관리기록방법 라우팅과 무관하게, 지도서 안의 지정 항목을
        // 관리계획서와 직접 대조하는 별도 패스로 검사한다.
        runPurgingGuideAnalysis(cpMatrix, cpParsed);

        // 제습건조기 사용 관리 기준서도 같은 역방향 대조 방식으로 검사한다.
        runDryerGuideAnalysis(cpMatrix, cpParsed);

        renderDashboard();
        const dashEl = document.getElementById('dashboard-section');
        if (dashEl) {
          dashEl.scrollIntoView({ behavior: 'smooth' });
        }
        showToast(bi('정합성 검사가 성공적으로 완료되었습니다!', 'Consistency audit completed successfully!'), 'success');
      } catch (err) {
        console.error('runAnalysis 실행 중 오류 발생:', err);
        showToast(bi(
          `❌ 정합성 검사 중 오류가 발생했습니다: ${err.message}`,
          `❌ An error occurred during the consistency audit: ${err.message}`
        ), 'error');
        alert(`❌ 정합성 검사 실행 오류: ${err.message}`);
      }
    }

    function renderDashboard() {
      document.getElementById('dashboard-section').classList.remove('hidden');

      const grandTotal = analysisResults.length;
      const total = analysisResults.filter(r => r.status !== 'SKIPPED').length;
      const match = analysisResults.filter(r => r.status === 'MATCH').length;
      const mismatch = analysisResults.filter(r => r.status === 'MISMATCH').length;
      const unitMismatch = analysisResults.filter(r => r.status === 'MISMATCH (단위)').length;
      const missing = analysisResults.filter(r => r.status === 'MISSING').length;
      const review = analysisResults.filter(r => r.status === 'REVIEW').length;
      const skipped = analysisResults.filter(r => r.status === 'SKIPPED').length;

      document.getElementById('metric-grand-total').innerText = grandTotal;
      document.getElementById('metric-total').innerText = total;
      document.getElementById('metric-match').innerText = match;
      document.getElementById('metric-mismatch').innerText = mismatch;
      document.getElementById('metric-unit-mismatch').innerText = unitMismatch;
      document.getElementById('metric-missing').innerText = missing;
      document.getElementById('metric-review').innerText = review;
      document.getElementById('metric-skipped').innerText = skipped;

      applyFilters();
    }

    function applyFilters() {
      const docFilter = document.getElementById('filter-doc').value;
      const statusFilter = document.getElementById('filter-status').value;
      const searchKey = document.getElementById('search-keyword').value.toLowerCase();

      const filtered = analysisResults.filter(r => {
        const matchDoc = docFilter === 'ALL' || r.targetDoc === docFilter;
        const matchStatus = statusFilter === 'ALL' || r.status === statusFilter;
        const matchSearch = !searchKey ||
          r.chosenKeyword.toLowerCase().includes(searchKey) ||
          r.processName.toLowerCase().includes(searchKey) ||
          r.cpSpec.toLowerCase().includes(searchKey) ||
          r.rawMethod.toLowerCase().includes(searchKey) ||
          r.targetDoc.toLowerCase().includes(searchKey);

        return matchDoc && matchStatus && matchSearch;
      });

      const tbody = document.getElementById('result-tbody');
      if (filtered.length === 0) {
        const emptyMsg = currentLang === 'eng' ? 'No inspection result items match the selected filter criteria.' : '조건에 일치하는 결과 항목이 없습니다.';
        tbody.innerHTML = `<tr><td colspan="7" class="p-8 text-center text-slate-500">${emptyMsg}</td></tr>`;
        return;
      }

      const t = i18n[currentLang] || i18n.kor;

      tbody.innerHTML = filtered.map(r => {
        let statusBadge = '';
        if (r.status === 'MATCH') {
          statusBadge = `
            <div class="px-3 py-1.5 rounded-lg bg-emerald-950/90 text-emerald-300 border border-emerald-700/80 font-bold text-center flex flex-col items-center justify-center min-w-[110px] shadow-sm">
              <span class="text-xs leading-tight tracking-wider">MATCH</span>
              <span class="text-[11px] font-normal text-emerald-400/90 mt-0.5">${t.badgeMatchSub}</span>
            </div>`;
        } else if (r.status === 'MISMATCH (단위)') {
          statusBadge = `
            <div class="px-3 py-1.5 rounded-lg bg-orange-950/90 text-orange-300 border border-orange-700/80 font-bold text-center flex flex-col items-center justify-center min-w-[110px] shadow-sm">
              <span class="text-xs leading-tight tracking-wider">MISMATCH</span>
              <span class="text-[11px] font-normal text-orange-400/90 mt-0.5">${t.badgeUnitMismatchSub}</span>
            </div>`;
        } else if (r.status === 'MISMATCH') {
          statusBadge = `
            <div class="px-3 py-1.5 rounded-lg bg-rose-950/90 text-rose-300 border border-rose-700/80 font-bold text-center flex flex-col items-center justify-center min-w-[110px] shadow-sm">
              <span class="text-xs leading-tight tracking-wider">MISMATCH</span>
              <span class="text-[11px] font-normal text-rose-400/90 mt-0.5">${t.badgeMismatchSub}</span>
            </div>`;
        } else if (r.status === 'MISSING') {
          statusBadge = `
            <div class="px-3 py-1.5 rounded-lg bg-amber-950/90 text-amber-300 border border-amber-700/80 font-bold text-center flex flex-col items-center justify-center min-w-[110px] shadow-sm">
              <span class="text-xs leading-tight tracking-wider">MISSING</span>
              <span class="text-[11px] font-normal text-amber-400/90 mt-0.5">${t.badgeMissingSub}</span>
            </div>`;
        } else if (r.status === 'REVIEW') {
          statusBadge = `
            <div class="px-3 py-1.5 rounded-lg bg-purple-950/90 text-purple-300 border border-purple-700/80 font-bold text-center flex flex-col items-center justify-center min-w-[110px] shadow-sm">
              <span class="text-xs leading-tight tracking-wider">REVIEW</span>
              <span class="text-[11px] font-normal text-purple-400/90 mt-0.5">${t.badgeReviewSub}</span>
            </div>`;
        } else {
          statusBadge = `
            <div class="px-3 py-1.5 rounded-lg bg-slate-800 text-slate-300 border border-slate-700 font-bold text-center flex flex-col items-center justify-center min-w-[110px] shadow-sm">
              <span class="text-xs leading-tight tracking-wider">SKIPPED</span>
              <span class="text-[11px] font-normal text-slate-400 mt-0.5">${t.badgeSkippedSub}</span>
            </div>`;
        }

        const displayTargetDoc = currentLang === 'eng' ? translateTextToEng(r.targetDoc) : r.targetDoc;
        const displayChosenType = currentLang === 'eng' ? translateTextToEng(r.chosenType) : r.chosenType;
        const displayDetailNote = currentLang === 'eng' ? translateTextToEng(r.detailNote) : r.detailNote;
        const typePrefix = currentLang === 'eng' ? 'Category:' : '채택구분:';

        const formattedTargetSpec = String(r.targetSpec || '-').replace(/\n/g, '<br>');
        const formattedDetailNote = String(displayDetailNote || '-').replace(/\n/g, '<br>');

        let paramTableHtml = '';
        if (r.paramResults && Array.isArray(r.paramResults) && r.paramResults.length > 0) {
          paramTableHtml = `
            <details class="mt-2.5 bg-slate-900/90 rounded-xl p-3 border border-slate-700/80 shadow-lg">
              <summary class="cursor-pointer text-xs font-bold text-blue-300 hover:text-blue-200 flex items-center justify-between select-none">
                <span class="flex items-center space-x-1.5">
                  <i data-lucide="table-properties" class="w-4 h-4 text-cyan-400"></i>
                  <span>제품특성 '${r.chosenKeyword}' 항목별 14개 상세 비교 표 보기</span>
                </span>
                <span class="text-[10px] px-2 py-0.5 rounded font-mono font-bold ${r.status === 'MATCH' ? 'bg-emerald-950 text-emerald-300 border border-emerald-700' : 'bg-rose-950 text-rose-300 border border-rose-700'}">${r.status}</span>
              </summary>
              <div class="mt-2.5 overflow-x-auto rounded-lg border border-slate-800">
                <table class="w-full text-xs text-left border-collapse">
                  <thead>
                    <tr class="bg-slate-800/90 text-slate-300 font-semibold border-b border-slate-700">
                      <th class="p-2 w-1/4">비교 항목</th>
                      <th class="p-2 w-1/3">관리계획서 (CP)</th>
                      <th class="p-2 w-1/3">검사표준서 (IS)</th>
                      <th class="p-2 text-center w-1/6">결과</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-800/80">
                    ${r.paramResults.map(p => `
                      <tr class="${p.status === 'MATCH' ? 'hover:bg-slate-800/40 text-slate-300' : 'bg-rose-950/60 text-rose-200 font-semibold'}">
                        <td class="p-2 font-medium">${p.param}</td>
                        <td class="p-2 font-mono text-slate-200">${p.cpVal}</td>
                        <td class="p-2 font-mono text-slate-200">${p.tVal}</td>
                        <td class="p-2 text-center">
                          <span class="px-2 py-0.5 rounded text-[10px] font-bold ${p.status === 'MATCH' ? 'bg-emerald-950 text-emerald-300 border border-emerald-800' : 'bg-rose-900 text-rose-200 border border-rose-600 shadow-sm'}">${p.status}</span>
