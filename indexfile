        `;
      }).join('');

      if (window.lucide) {
        lucide.createIcons();
      }
    }

    async function buildReportWorkbookBuffer() {
      const wb = new ExcelJS.Workbook();
      const ws = wb.addWorksheet(currentLang === 'eng' ? 'QMS_Audit_Result_Highlight' : 'QMS정합성검사결과_형광펜');

      ws.columns = currentLang === 'eng' ? [
        { header: '#', key: 'index', width: 8 },
        { header: 'Verdict', key: 'status', width: 16 },
        { header: 'Control Method (Raw Text)', key: 'rawMethod', width: 22 },
        { header: 'Target Document', key: 'targetDoc', width: 18 },
        { header: 'Selected Keyword', key: 'chosenKeyword', width: 24 },
        { header: 'Keyword Category', key: 'chosenType', width: 22 },
        { header: 'Similarity (%)', key: 'simPercent', width: 12 },
        { header: 'Control Plan Spec (CP)', key: 'cpSpec', width: 25 },
        { header: 'Target Doc Matched Keyword', key: 'targetKeyword', width: 24 },
        { header: 'Target Doc Spec', key: 'targetSpec', width: 25 },
        { header: 'Audit Result Note', key: 'detailNote', width: 45 },
        { header: 'User Check', key: 'usercheck', width: 12 }
      ] : [
        { header: '번호', key: 'index', width: 8 },
        { header: '판정상태', key: 'status', width: 16 },
        { header: '관리기록방법 (원본)', key: 'rawMethod', width: 22 },
        { header: '대상 문서명', key: 'targetDoc', width: 18 },
        { header: '채택 검색키워드', key: 'chosenKeyword', width: 24 },
        { header: '키워드 구분', key: 'chosenType', width: 22 },
        { header: '유사도(%)', key: 'simPercent', width: 12 },
        { header: '관리계획서 규격 (CP)', key: 'cpSpec', width: 25 },
        { header: '대상문서 매칭키워드', key: 'targetKeyword', width: 24 },
        { header: '대상문서 규격', key: 'targetSpec', width: 25 },
        { header: '상세 분석 사유', key: 'detailNote', width: 45 },
        { header: 'User 확인란', key: 'usercheck', width: 12 }
      ];

      const headerRow = ws.getRow(1);
      headerRow.font = { bold: true, color: { argb: 'FFFFFFFF' } };
      headerRow.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF1E293B' } };
      headerRow.alignment = { vertical: 'middle', horizontal: 'center' };

      analysisResults.forEach((r, index) => {
        const displayStatus = currentLang === 'eng' ? r.status.replace('(단위)', '(Unit)') : r.status;
        const row = ws.addRow({
          index: index + 1,
          status: displayStatus,
          rawMethod: r.rawMethod,
          targetDoc: currentLang === 'eng' ? translateTextToEng(r.targetDoc) : r.targetDoc,
          chosenKeyword: r.chosenKeyword,
          chosenType: currentLang === 'eng' ? translateTextToEng(r.chosenType) : r.chosenType,
          simPercent: r.simPercent,
          cpSpec: r.cpSpec,
          targetKeyword: r.targetKeyword,
          targetSpec: r.targetSpec,
          detailNote: currentLang === 'eng' ? translateTextToEng(r.detailNote) : r.detailNote
        });

        let fillColor = 'FFFFFFFF';
        let fontColor = 'FF000000';

        if (r.status === 'MISMATCH') {
          fillColor = 'FFFFC7CE';
          fontColor = 'FF9C0006';
        } else if (r.status === 'MISMATCH (단위)') {
          fillColor = 'FFFFEDD5';
          fontColor = 'FFC2410C';
        } else if (r.status === 'MISSING') {
          fillColor = 'FFFEF08A';
          fontColor = 'FF854D0E';
        } else if (r.status === 'REVIEW') {
          fillColor = 'FFE9D5FF';
          fontColor = 'FF581C87';
        } else if (r.status === 'MATCH') {
          fillColor = 'FFDCFCE7';
          fontColor = 'FF14532D';
        } else if (r.status === 'SKIPPED') {
          fillColor = 'FFF1F5F9';
          fontColor = 'FF475569';
        }

        row.eachCell((cell, colNumber) => {
          cell.fill = {
            type: 'pattern',
            pattern: 'solid',
            fgColor: { argb: fillColor }
          };
          cell.font = { name: '맑은 고딕', size: 10, color: { argb: fontColor }, bold: r.status !== 'MATCH' };
          cell.border = {
            top: { style: 'thin', color: { argb: 'FFE2E8F0' } },
            left: { style: 'thin', color: { argb: 'FFE2E8F0' } },
            bottom: { style: 'thin', color: { argb: 'FFE2E8F0' } },
            right: { style: 'thin', color: { argb: 'FFE2E8F0' } }
          };
          // K열(detailNote, 11번째 컬럼)만 wrap text 적용
          if (colNumber === 11) {
            cell.alignment = { wrapText: true, vertical: 'top', horizontal: 'left' };
          }
        });
      });

      const buffer = await wb.xlsx.writeBuffer();
      return buffer;
    }

    // 판정 상태별 강조 색상 (리포트/원본 표시본 공통으로 재사용)
    function getStatusColors(status) {
      let fillColor = 'FFFFFFFF';
      let fontColor = 'FF000000';
      if (status === 'MISMATCH') {
        fillColor = 'FFFFC7CE'; fontColor = 'FF9C0006';
      } else if (status === 'MISMATCH (단위)') {
        fillColor = 'FFFFEDD5'; fontColor = 'FFC2410C';
      } else if (status === 'MISSING') {
        fillColor = 'FFFEF08A'; fontColor = 'FF854D0E';
      } else if (status === 'REVIEW') {
        fillColor = 'FFE9D5FF'; fontColor = 'FF581C87';
      } else if (status === 'MATCH') {
        fillColor = 'FFDCFCE7'; fontColor = 'FF14532D';
      } else if (status === 'SKIPPED') {
        fillColor = 'FFF1F5F9'; fontColor = 'FF475569';
      }
      return { fillColor, fontColor };
    }

    // 대상문서명(예: '작업조건기록지') → 업로드 슬롯 키(예: 'wc') 역매핑
    const DOC_NAME_TO_KEY = Object.fromEntries(Object.entries(DOC_KEYS).map(([k, v]) => [v, k]));

    // "정합성 검사 결과 다운로드"에서 원본 사본에 표시할, MISMATCH/MISMATCH(단위)/
    // REVIEW/MISSING 4가지 판정만 모아서 관리계획서 쪽/대상 서브문서 쪽으로 분류한다.
    // sourceItem: 파싱 단계에서 기록해둔 원본 좌표(__rowMeta/__col*)를 가진 실제 항목
    // 객체. 이게 있으면 텍스트 재검색 없이 정확한 셀로 바로 찾아갈 수 있다.
    // (Front/Rear 병합처럼 합성된 항목 등, 좌표가 없는 경우에만 specText/keyword로
    // 재검색하는 예전 방식으로 대체한다.)
    function collectAnnotationsByDoc() {
      const NOTEWORTHY = ['MISMATCH', 'MISMATCH (단위)', 'REVIEW', 'MISSING'];
      const cpAnnotations = [];
      const byDocKey = {};

      analysisResults.forEach(r => {
        // 문제 있는 4가지 판정(MISMATCH/MISMATCH(단위)/REVIEW/MISSING)만 표시한다.
        // 자동 대조 규칙이 없는 항목도 REVIEW로 올라오므로 여기서 함께 걸린다.
        const isPgDirect = r._pgDirect === true;
        if (!NOTEWORTHY.includes(r.status)) return;

        // 퍼징 대조 결과는 관리계획서 쪽 좌표를 특정하기 어렵다(대상설비/Tool 번호는
        // 후보 값이 여러 개일 수 있음). 엉뚱한 셀이 칠해지는 것을 막기 위해
        // 관리계획서 사본에는 표시하지 않고, 퍼징 작업지도서 사본에만 표시한다.
        if (!isPgDirect && r.chosenKeyword && r.chosenKeyword !== '-') {
          cpAnnotations.push({ keyword: r.chosenKeyword, specText: r.cpSpec || '', status: r.status, note: r.detailNote || '', sourceItem: r._cpItem || null });
        }

        const docKey = DOC_NAME_TO_KEY[r.targetDoc];
        // 퍼징 항목 라벨 자체를 못 찾은 경우(_targetItem 없음)는 칠할 셀이 없다.
        // 이때 키워드 텍스트로 재검색하면 엉뚱한 셀이 칠해지므로 아예 건너뛴다.
        if (isPgDirect && !r._targetItem) return;
        if (docKey && r.targetKeyword && r.targetKeyword !== '-') {
          if (!byDocKey[docKey]) byDocKey[docKey] = [];
          byDocKey[docKey].push({ keyword: r.targetKeyword, specText: r.targetSpec || '', status: r.status, note: r.detailNote || '', sourceItem: r._targetItem || null });
        }
      });

      return { cpAnnotations, byDocKey };
    }

    // 파싱 시 기록해둔 좌표 힌트(__colSpec/__colNominal/__colLower/__colUpper/
    // __colKey/__colK1/__colK2/__colProdChar) 중, 그 행에서 실제로 값이 들어있는
    // 첫 번째 칸을 규격/키워드 셀로 채택한다.
    // status에 따라 "어느 칸에 표시할지" 우선순위를 다르게 잡는다.
    // - REVIEW/MISSING: 문제의 원인이 "키워드/항목명이 불확실함"이므로 키워드 칸(__colKey 등)을 먼저 찾는다.
    // - MISMATCH/MISMATCH(단위): 문제의 원인이 "규격 값/단위가 다름"이므로 규격 칸(__colSpec 등)을 먼저 찾는다.
    // (예전에는 status와 무관하게 항상 규격 칸을 먼저 찾아서, REVIEW 항목까지 규격 칸에 표시되는 오류가 있었다.)
    function pickTargetCellCol(item, fileMatrixRow, status) {
      if (!item) return -1;
      const specCols = [item.__colSpec, item.__colNominal, item.__colLower, item.__colUpper];
      const keyCols = [item.__colKey, item.__colK1, item.__colK2, item.__colProdChar];
      const isReviewLike = status === 'REVIEW' || status === 'MISSING';
      const orderedCols = isReviewLike ? keyCols.concat(specCols) : specCols.concat(keyCols);
      const candidates = orderedCols.filter(c => c !== undefined && c !== null && c !== -1);
      for (const c of candidates) {
        if (fileMatrixRow && fileMatrixRow[c] !== undefined && !isDashOrEmpty(fileMatrixRow[c])) return c;
      }
      return candidates.length > 0 ? candidates[0] : -1;
    }

    // 특정 파일의 행렬(fileMatrix)에서 키워드 텍스트와 일치/유사한 셀의 위치({row, col})를 찾는다.
    // 1순위: 완전 일치, 2순위: 기존 매칭 로직(calculateKeywordMatchScore) 재사용한 유사도 매칭.
    function locateKeywordCell(fileMatrix, keywordText) {
      if (!keywordText || !fileMatrix) return null;
      const target = normalizeKeyword(keywordText);
      if (!target) return null;

      for (let r = 0; r < fileMatrix.length; r++) {
        const row = fileMatrix[r];
        if (!Array.isArray(row)) continue;
        for (let c = 0; c < row.length; c++) {
          if (normalizeKeyword(row[c]) === target) return { row: r, col: c };
        }
      }

      let best = null, bestScore = 0;
      for (let r = 0; r < fileMatrix.length; r++) {
        const row = fileMatrix[r];
        if (!Array.isArray(row)) continue;
        for (let c = 0; c < row.length; c++) {
          const cellVal = row[c];
          if (!cellVal) continue;
          const score = calculateKeywordMatchScore(keywordText, cellVal);
          if (score > bestScore) { bestScore = score; best = { row: r, col: c }; }
        }
      }
      return bestScore >= 0.6 ? best : null;
    }

    // 셀(absR, absC)이 "2행 이상에 걸친" 병합 범위(주로 작업요소명 같은 라벨 칸이
    // 여러 세부 항목에 걸쳐 병합된 경우)에 속하는지 확인한다. 이런 셀에 배경색을
    // 칠하면 관련 없는 다른 행까지 전부 칠해지므로 하이라이트 대상에서 제외해야 한다.
    function isCellInMultiRowMerge(sheet, absR, absC) {
      if (!sheet['!merges']) return false;
      return sheet['!merges'].some(m =>
        m.e.r > m.s.r && absR >= m.s.r && absR <= m.e.r && absC >= m.s.c && absC <= m.e.c
      );
    }

    // 키워드 셀이 위치한 행(row) 안에서, 실제 규격 값(specText)과 가장 유사한 셀을 찾는다.
    // (예: "정상 이송 확인 할것" 같은 규격 텍스트가 들어있는 정확한 셀 위치)
    // 관리계획서처럼 규격이 하한/Nominal/상한 3칸으로 나뉜 경우, 합쳐진 전체 문자열과
    // 정확히 일치하는 칸이 없을 수 있으므로 숫자 등 개별 토큰 단위로도 재시도한다.
    // 여러 행에 걸쳐 병합된 라벨 칸(sheet/absRow/colOffset으로 판별)은 후보에서 제외한다.
    // 못 찾으면 -1을 반환하며, 이 경우 호출부에서 키워드 셀 자체에 표시하는 것으로 대체한다.
    function findSpecColInRow(row, specText, excludeCol, sheet, absRow, colOffset) {
      if (!specText || !Array.isArray(row)) return -1;
      const target = normalizeKeyword(specText);
      if (!target) return -1;

      const isExcludedCell = (c) => c === excludeCol || (sheet && isCellInMultiRowMerge(sheet, absRow, c + colOffset));

      let bestCol = -1, bestScore = 0;
      row.forEach((cellVal, c) => {
        if (isExcludedCell(c) || !cellVal) return;
        const cellNorm = normalizeKeyword(cellVal);
        if (!cellNorm) return;
        let score = 0;
        if (cellNorm === target) {
          score = 1;
        } else if (target.includes(cellNorm) || cellNorm.includes(target)) {
          score = Math.min(cellNorm.length, target.length) / Math.max(cellNorm.length, target.length);
        } else {
          score = calculateKeywordMatchScore(cellVal, specText);
        }
        if (score > bestScore) { bestScore = score; bestCol = c; }
      });
      if (bestScore >= 0.3) return bestCol;

      // 전체 문자열이 안 맞으면, specText 안의 숫자 토큰(하한/Nominal/상한 등 개별 값)이
      // 그대로 들어있는 칸을 찾는다. (예: "0.6~1.4 bar" → "0.6" 또는 "1.4"가 그대로 있는 칸)
      const tokens = (String(specText).match(/-?\d+(\.\d+)?/g) || []).filter(t => t.length > 0);
      for (const tok of tokens) {
        for (let c = 0; c < row.length; c++) {
          if (isExcludedCell(c)) continue;
          if (String(row[c] || '').trim() === tok) return c;
        }
      }
      return -1;
    }

    function buildAnnotatedCopyFileName(originalName) {
      const dotIdx = originalName.lastIndexOf('.');
      const base = dotIdx !== -1 ? originalName.slice(0, dotIdx) : originalName;
      // 원본 서식을 최대한 보존하기 위해 ExcelJS로 다시 저장하므로 확장자는 항상 .xlsx로 통일한다.
      return `${base}_검토표시본.xlsx`;
    }

    // 제습건조기 기록서에는 Excel 도형/연결선/텍스트 상자처럼 ExcelJS가 다시 저장할 때
    // 누락할 수 있는 DrawingML 객체가 포함돼 있다. 이 문서는 원본 xlsx ZIP 패키지를
    // 재작성하지 않고, 선택된 워크시트 XML의 검사 셀 스타일 번호와 styles.xml에 새
    // 채우기 스타일만 추가한다. 그 밖의 XML/도형/이미지/수식/값은 원본 바이트 그대로다.
    function getXmlElements(root, localName) {
      return Array.from(root.getElementsByTagNameNS('*', localName));
    }

    function resolveOoxmlPartPath(basePart, target) {
      if (!target) return '';
      if (target.startsWith('/')) return target.slice(1);
      const parts = basePart.split('/');
      parts.pop();
      target.split('/').forEach(part => {
        if (!part || part === '.') return;
        if (part === '..') parts.pop();
        else parts.push(part);
      });
      return parts.join('/');
    }

    function parseOoxmlXml(text, partName) {
      const doc = new DOMParser().parseFromString(text, 'application/xml');
      if (doc.getElementsByTagName('parsererror').length > 0) {
        throw new Error(`${partName} XML을 읽을 수 없습니다.`);
      }
      return doc;
    }

    async function annotateXlsxPackagePreservingOriginal(fileObj, matches, rowOffset, colOffset) {
      const ext = (fileObj.fileName.split('.').pop() || '').toLowerCase();
      if (ext !== 'xlsx' || !fileObj.file) {
        throw new Error('제습건조기 검토표시본의 원본 완전 보존은 .xlsx 파일에서만 지원됩니다.');
      }

      const originalBuffer = await fileObj.file.arrayBuffer();
      const packageZip = await JSZip.loadAsync(originalBuffer);
      const workbookPart = 'xl/workbook.xml';
      const workbookRelsPart = 'xl/_rels/workbook.xml.rels';
      const workbookFile = packageZip.file(workbookPart);
      const workbookRelsFile = packageZip.file(workbookRelsPart);
      if (!workbookFile || !workbookRelsFile) throw new Error('원본 xlsx의 workbook 정보를 찾지 못했습니다.');

      const workbookDoc = parseOoxmlXml(await workbookFile.async('string'), workbookPart);
      const workbookRelsDoc = parseOoxmlXml(await workbookRelsFile.async('string'), workbookRelsPart);
      const sheetNode = getXmlElements(workbookDoc, 'sheet').find(node => node.getAttribute('name') === fileObj.activeSheet);
      if (!sheetNode) throw new Error(`선택 시트 '${fileObj.activeSheet}'를 원본 xlsx에서 찾지 못했습니다.`);

      const sheetRelId = sheetNode.getAttribute('r:id')
        || sheetNode.getAttributeNS('http://schemas.openxmlformats.org/officeDocument/2006/relationships', 'id');
      const relNodes = getXmlElements(workbookRelsDoc, 'Relationship');
      const sheetRel = relNodes.find(node => node.getAttribute('Id') === sheetRelId);
      const stylesRel = relNodes.find(node => /\/styles$/.test(node.getAttribute('Type') || ''));
      if (!sheetRel) throw new Error('선택 시트의 OOXML 관계 정보를 찾지 못했습니다.');

      const sheetPart = resolveOoxmlPartPath(workbookPart, sheetRel.getAttribute('Target'));
      const stylesPart = stylesRel
        ? resolveOoxmlPartPath(workbookPart, stylesRel.getAttribute('Target'))
        : 'xl/styles.xml';
      const sheetFile = packageZip.file(sheetPart);
      const stylesFile = packageZip.file(stylesPart);
      if (!sheetFile || !stylesFile) throw new Error('선택 시트 또는 스타일 정보를 원본 xlsx에서 찾지 못했습니다.');

      const sheetDoc = parseOoxmlXml(await sheetFile.async('string'), sheetPart);
      const stylesDoc = parseOoxmlXml(await stylesFile.async('string'), stylesPart);
      const fillsNode = getXmlElements(stylesDoc, 'fills')[0];
      const cellXfsNode = getXmlElements(stylesDoc, 'cellXfs')[0];
      if (!fillsNode || !cellXfsNode) throw new Error('원본 xlsx의 셀 스타일 구조를 읽지 못했습니다.');

      const styleNs = stylesDoc.documentElement.namespaceURI;
      const fillIdByColor = new Map();
      const styleIdByBaseAndColor = new Map();

      const getFillId = (argb) => {
        if (fillIdByColor.has(argb)) return fillIdByColor.get(argb);
        const fill = stylesDoc.createElementNS(styleNs, 'fill');
        const patternFill = stylesDoc.createElementNS(styleNs, 'patternFill');
        patternFill.setAttribute('patternType', 'solid');
        const fgColor = stylesDoc.createElementNS(styleNs, 'fgColor');
        fgColor.setAttribute('rgb', argb);
        const bgColor = stylesDoc.createElementNS(styleNs, 'bgColor');
        bgColor.setAttribute('indexed', '64');
        patternFill.appendChild(fgColor);
        patternFill.appendChild(bgColor);
        fill.appendChild(patternFill);
        fillsNode.appendChild(fill);
        const fillId = getXmlElements(fillsNode, 'fill').length - 1;
        fillsNode.setAttribute('count', String(fillId + 1));
        fillIdByColor.set(argb, fillId);
        return fillId;
      };

      const getMarkedStyleId = (baseStyleId, argb, wrap) => {
        const cacheKey = `${baseStyleId}_${argb}_${wrap ? 'w' : ''}`;
        if (styleIdByBaseAndColor.has(cacheKey)) return styleIdByBaseAndColor.get(cacheKey);
        const existingXfs = getXmlElements(cellXfsNode, 'xf');
        const baseXf = existingXfs[baseStyleId] || existingXfs[0];
        if (!baseXf) throw new Error('복제할 기본 셀 스타일이 없습니다.');
        const markedXf = baseXf.cloneNode(true);
        markedXf.setAttribute('fillId', String(getFillId(argb)));
        markedXf.setAttribute('applyFill', '1');
        // 셀 안에 사유를 여러 줄로 덧붙이는 경우에만 줄바꿈 표시를 켠다.
        // (수식/도형은 건드리지 않고, 검사 대상 셀의 정렬 속성만 바꾼다.)
        if (wrap) {
          let align = getXmlElements(markedXf, 'alignment')[0];
          if (!align) {
            align = stylesDoc.createElementNS(styleNs, 'alignment');
            const anchor = ['protection', 'extLst']
              .map(n => getXmlElements(markedXf, n)[0]).find(Boolean);
            if (anchor) markedXf.insertBefore(align, anchor);
            else markedXf.appendChild(align);
          }
          align.setAttribute('wrapText', '1');
          if (!align.getAttribute('vertical')) align.setAttribute('vertical', 'top');
          markedXf.setAttribute('applyAlignment', '1');
        }
        cellXfsNode.appendChild(markedXf);
        const styleId = getXmlElements(cellXfsNode, 'xf').length - 1;
        cellXfsNode.setAttribute('count', String(styleId + 1));
        styleIdByBaseAndColor.set(cacheKey, styleId);
        return styleId;
      };

      const cellsByAddress = new Map();
      getXmlElements(sheetDoc, 'c').forEach(cellNode => {
        const address = (cellNode.getAttribute('r') || '').toUpperCase();
        if (address) cellsByAddress.set(address, cellNode);
      });

      const sheetNs = sheetDoc.documentElement.namespaceURI;
      const XML_NS = 'http://www.w3.org/XML/1998/namespace';
      const REL_NS = 'http://schemas.openxmlformats.org/officeDocument/2006/relationships';

      // 공유 문자열 테이블(값이 t="s"인 셀은 여기 인덱스만 갖고 있다)을 미리 읽어둔다.
      const sharedStrings = [];
      try {
        const ssRel = getXmlElements(workbookRelsDoc, 'Relationship')
          .find(node => /\/sharedStrings$/.test(node.getAttribute('Type') || ''));
        const ssPart = ssRel
          ? resolveOoxmlPartPath(workbookPart, ssRel.getAttribute('Target'))
          : 'xl/sharedStrings.xml';
        const ssFile = packageZip.file(ssPart);
        if (ssFile) {
          const ssDoc = parseOoxmlXml(await ssFile.async('string'), ssPart);
          getXmlElements(ssDoc, 'si').forEach(si => {
            sharedStrings.push(getXmlElements(si, 't').map(t => t.textContent).join(''));
          });
        }
      } catch (e) { /* 공유 문자열이 없으면 t="s" 셀도 없다 — 무시 */ }

      // 검사 대상 셀의 "원래 표시 텍스트"를 꺼낸다(수식 셀은 이 경로로 오지 않는다).
      const readCellNodeText = (cellNode) => {
        const t = cellNode.getAttribute('t');
        if (t === 'inlineStr') {
          const is = getXmlElements(cellNode, 'is')[0];
          return is ? getXmlElements(is, 't').map(n => n.textContent).join('') : '';
        }
        const vNode = getXmlElements(cellNode, 'v')[0];
        const raw = vNode ? (vNode.textContent || '') : '';
        if (t === 's') {
          const idx = parseInt(raw, 10);
          return Number.isFinite(idx) && sharedStrings[idx] !== undefined ? sharedStrings[idx] : '';
        }
        if (t === 'b') return raw === '1' ? 'TRUE' : 'FALSE';
        return raw; // 'str' / 'e' / 숫자 / 날짜
      };

      // 검사 대상 셀(수식 아님)에만 사유를 인라인 문자열로 덧붙인다.
      const setCellNodeInlineText = (cellNode, text) => {
        ['f', 'v', 'is'].forEach(name => {
          getXmlElements(cellNode, name).forEach(n => { if (n.parentNode) n.parentNode.removeChild(n); });
        });
        cellNode.setAttribute('t', 'inlineStr');
        const is = sheetDoc.createElementNS(sheetNs, 'is');
        const tEl = sheetDoc.createElementNS(sheetNs, 't');
        tEl.setAttributeNS(XML_NS, 'xml:space', 'preserve');
        tEl.textContent = text;
        is.appendChild(tEl);
        cellNode.appendChild(is);
      };

      // 계산항(수식 셀)은 값/수식을 절대 건드리지 않고, 사유를 엑셀 메모(코멘트)로만 남긴다.
      // 원본 xlsx 패키지에 comments 파트와 (필요 시) VML 도형 파트를 최소한으로 덧붙인다.
      const applyFormulaCellMemos = async (memos) => {
        if (memos.length === 0) return;
        const CT_PART = '[Content_Types].xml';
        const PKG_REL_NS = 'http://schemas.openxmlformats.org/package/2006/relationships';
        const VNS = 'urn:schemas-microsoft-com:vml';
        const ONS = 'urn:schemas-microsoft-com:office:office';
        const XNS = 'urn:schemas-microsoft-com:office:excel';
        const AUTHOR = 'QMS 정합성 검사';

        const ctFile = packageZip.file(CT_PART);
        if (!ctFile) throw new Error('[Content_Types].xml 를 찾지 못했습니다.');
        const ctDoc = parseOoxmlXml(await ctFile.async('string'), CT_PART);
        const ctRoot = ctDoc.documentElement;
        const ctNs = ctRoot.namespaceURI;
        const ctHasOverride = (pn) => getXmlElements(ctRoot, 'Override').some(o => o.getAttribute('PartName') === pn);
        const ctHasDefault = (ext) => getXmlElements(ctRoot, 'Default').some(d => (d.getAttribute('Extension') || '').toLowerCase() === ext);
        const ctAddOverride = (pn, type) => {
          if (ctHasOverride(pn)) return;
          const el = ctDoc.createElementNS(ctNs, 'Override');
          el.setAttribute('PartName', pn);
          el.setAttribute('ContentType', type);
          ctRoot.appendChild(el);
        };
        const ctAddDefault = (ext, type) => {
          if (ctHasDefault(ext)) return;
          const el = ctDoc.createElementNS(ctNs, 'Default');
          el.setAttribute('Extension', ext);
          el.setAttribute('ContentType', type);
          ctRoot.insertBefore(el, ctRoot.firstChild);
        };

        // 선택 시트의 관계(_rels) 파트
        const sheetDir = sheetPart.slice(0, sheetPart.lastIndexOf('/'));
        const sheetBase = sheetPart.slice(sheetPart.lastIndexOf('/') + 1);
        const sheetRelsPart = `${sheetDir}/_rels/${sheetBase}.rels`;
        const srFile = packageZip.file(sheetRelsPart);
        const sheetRelsDoc = srFile
          ? parseOoxmlXml(await srFile.async('string'), sheetRelsPart)
          : new DOMParser().parseFromString(`<Relationships xmlns="${PKG_REL_NS}"/>`, 'application/xml');
        const sheetRelsRoot = sheetRelsDoc.documentElement;
        const relNodes = () => getXmlElements(sheetRelsRoot, 'Relationship');
        const relByType = (suffix) => relNodes().find(r => (r.getAttribute('Type') || '').endsWith(suffix));
        const nextRelId = () => {
          const ids = new Set(relNodes().map(r => r.getAttribute('Id')));
          let n = 1;
          while (ids.has(`rId${n}`)) n++;
          return `rId${n}`;
        };
        const addRel = (id, type, target) => {
          const el = sheetRelsDoc.createElementNS(PKG_REL_NS, 'Relationship');
          el.setAttribute('Id', id);
          el.setAttribute('Type', type);
          el.setAttribute('Target', target);
          sheetRelsRoot.appendChild(el);
        };

        // --- comments 파트 (있으면 재사용, 없으면 새로 만든다) ---
        const MAIN_NS = sheetNs;
        let commentsPart, commentsDoc;
        const commentsRel = relByType('/comments');
        if (commentsRel) {
          commentsPart = resolveOoxmlPartPath(sheetPart, commentsRel.getAttribute('Target'));
          commentsDoc = parseOoxmlXml(await packageZip.file(commentsPart).async('string'), commentsPart);
        } else {
          commentsPart = 'xl/comments_qms.xml';
          let i = 1;
          while (packageZip.file(commentsPart)) commentsPart = `xl/comments_qms${i++}.xml`;
          commentsDoc = new DOMParser().parseFromString(
            `<comments xmlns="${MAIN_NS}"><authors/><commentList/></comments>`, 'application/xml');
          ctAddOverride('/' + commentsPart, 'application/vnd.openxmlformats-officedocument.spreadsheetml.comments+xml');
          addRel(nextRelId(),
            'http://schemas.openxmlformats.org/officeDocument/2006/relationships/comments',
            '../' + commentsPart.slice('xl/'.length));
        }
        const authorsNode = getXmlElements(commentsDoc, 'authors')[0];
        const commentListNode = getXmlElements(commentsDoc, 'commentList')[0];
        let authorId = getXmlElements(authorsNode, 'author').findIndex(a => a.textContent === AUTHOR);
        if (authorId < 0) {
          const a = commentsDoc.createElementNS(MAIN_NS, 'author');
          a.textContent = AUTHOR;
          authorsNode.appendChild(a);
          authorId = getXmlElements(authorsNode, 'author').length - 1;
        }
        memos.forEach(mm => {
          const c = commentsDoc.createElementNS(MAIN_NS, 'comment');
          c.setAttribute('ref', mm.address);
          c.setAttribute('authorId', String(authorId));
          const textEl = commentsDoc.createElementNS(MAIN_NS, 'text');
          const r = commentsDoc.createElementNS(MAIN_NS, 'r');
          const rPr = commentsDoc.createElementNS(MAIN_NS, 'rPr');
          const sz = commentsDoc.createElementNS(MAIN_NS, 'sz'); sz.setAttribute('val', '20'); rPr.appendChild(sz);
          const clr = commentsDoc.createElementNS(MAIN_NS, 'color'); clr.setAttribute('indexed', '81'); rPr.appendChild(clr);
          const rFont = commentsDoc.createElementNS(MAIN_NS, 'rFont'); rFont.setAttribute('val', '맑은 고딕'); rPr.appendChild(rFont);
          const tEl = commentsDoc.createElementNS(MAIN_NS, 't');
          tEl.setAttributeNS(XML_NS, 'xml:space', 'preserve');
          tEl.textContent = mm.note;
          r.appendChild(rPr); r.appendChild(tEl);
          textEl.appendChild(r);
          c.appendChild(textEl);
          commentListNode.appendChild(c);
        });

        // --- VML 도형 파트 (엑셀이 메모 상자를 그리는 데 필요) ---
        let vmlPart, vmlDoc;
        // 이미 시트에 legacyDrawing(VML)이 연결돼 있으면 그 파트를 그대로 쓴다.
        const existingLegacy = getXmlElements(sheetDoc.documentElement, 'legacyDrawing')[0];
        const existingLegacyRelId = existingLegacy
          ? (existingLegacy.getAttributeNS(REL_NS, 'id') || existingLegacy.getAttribute('r:id'))
          : '';
        const vmlRel = (existingLegacyRelId
          ? relNodes().find(r => r.getAttribute('Id') === existingLegacyRelId)
          : null) || relByType('/vmlDrawing');
        if (vmlRel) {
          vmlPart = resolveOoxmlPartPath(sheetPart, vmlRel.getAttribute('Target'));
          vmlDoc = new DOMParser().parseFromString(await packageZip.file(vmlPart).async('string'), 'application/xml');
          if (vmlDoc.getElementsByTagName('parsererror').length > 0) {
            throw new Error('원본 VML 도형을 읽지 못했습니다.');
          }
        } else {
          vmlPart = 'xl/drawings/vmlDrawing_qms.vml';
          let i = 1;
          while (packageZip.file(vmlPart)) vmlPart = `xl/drawings/vmlDrawing_qms${i++}.vml`;
          vmlDoc = new DOMParser().parseFromString(
            `<xml xmlns:v="${VNS}" xmlns:o="${ONS}" xmlns:x="${XNS}">` +
            `<o:shapelayout v:ext="edit"><o:idmap v:ext="edit" data="1"/></o:shapelayout>` +
            `</xml>`, 'application/xml');
          ctAddDefault('vml', 'application/vnd.openxmlformats-officedocument.vmlDrawing');
          const vmlRelId = nextRelId();
          addRel(vmlRelId,
            'http://schemas.openxmlformats.org/officeDocument/2006/relationships/vmlDrawing',
            '../' + vmlPart.slice('xl/'.length));
          const legacy = sheetDoc.createElementNS(sheetNs, 'legacyDrawing');
          legacy.setAttributeNS(REL_NS, 'r:id', vmlRelId);
          const anchorEl = ['picture', 'oleObjects', 'controls', 'webPublishItems', 'tableParts', 'extLst']
            .map(n => getXmlElements(sheetDoc.documentElement, n)[0]).find(Boolean);
          const drawingEl = getXmlElements(sheetDoc.documentElement, 'drawing')[0];
          if (drawingEl) sheetDoc.documentElement.insertBefore(legacy, drawingEl.nextSibling);
          else if (anchorEl) sheetDoc.documentElement.insertBefore(legacy, anchorEl);
          else sheetDoc.documentElement.appendChild(legacy);
        }
        const vmlRoot = vmlDoc.documentElement;
        const hasShapeType = Array.from(vmlRoot.getElementsByTagNameNS('*', 'shapetype'))
          .some(s => s.getAttribute('id') === '_x0000_t202');
        if (!hasShapeType) {
          const st = vmlDoc.createElementNS(VNS, 'v:shapetype');
          st.setAttribute('id', '_x0000_t202');
          st.setAttribute('coordsize', '21600,21600');
          st.setAttributeNS(ONS, 'o:spt', '202');
          st.setAttribute('path', 'm,l,21600r21600,l21600,xe');
          const stroke = vmlDoc.createElementNS(VNS, 'v:stroke'); stroke.setAttribute('joinstyle', 'miter'); st.appendChild(stroke);
          const p = vmlDoc.createElementNS(VNS, 'v:path'); p.setAttribute('gradientshapeok', 't'); p.setAttributeNS(ONS, 'o:connecttype', 'rect'); st.appendChild(p);
          vmlRoot.insertBefore(st, vmlRoot.firstChild);
        }
        let shapeSeq = 1024 + Array.from(vmlRoot.getElementsByTagNameNS('*', 'shape')).length;
        memos.forEach(mm => {
          const shape = vmlDoc.createElementNS(VNS, 'v:shape');
          shape.setAttribute('id', `_x0000_s${++shapeSeq}`);
          shape.setAttribute('type', '#_x0000_t202');
          shape.setAttribute('style', 'position:absolute;margin-left:60pt;margin-top:2pt;width:216pt;height:108pt;z-index:1;visibility:hidden');
          shape.setAttribute('fillcolor', '#ffffe1');
          shape.setAttributeNS(ONS, 'o:insetmode', 'auto');
          const fill = vmlDoc.createElementNS(VNS, 'v:fill'); fill.setAttribute('color2', '#ffffe1'); shape.appendChild(fill);
          const shadow = vmlDoc.createElementNS(VNS, 'v:shadow');
          shadow.setAttribute('on', 't'); shadow.setAttribute('color', 'black'); shadow.setAttribute('obscured', 't'); shape.appendChild(shadow);
          const path = vmlDoc.createElementNS(VNS, 'v:path'); path.setAttributeNS(ONS, 'o:connecttype', 'none'); shape.appendChild(path);
          const tb = vmlDoc.createElementNS(VNS, 'v:textbox'); tb.setAttribute('style', 'mso-direction-alt:auto');
          const div = vmlDoc.createElement('div'); div.setAttribute('style', 'text-align:left'); tb.appendChild(div); shape.appendChild(tb);
          const cd = vmlDoc.createElementNS(XNS, 'x:ClientData'); cd.setAttribute('ObjectType', 'Note');
          cd.appendChild(vmlDoc.createElementNS(XNS, 'x:MoveWithCells'));
          cd.appendChild(vmlDoc.createElementNS(XNS, 'x:SizeWithCells'));
          const anc = vmlDoc.createElementNS(XNS, 'x:Anchor');
          anc.textContent = `${mm.absCol + 1}, 15, ${mm.absRow}, 2, ${mm.absCol + 3}, 15, ${mm.absRow + 4}, 2`;
          cd.appendChild(anc);
          const af = vmlDoc.createElementNS(XNS, 'x:AutoFill'); af.textContent = 'False'; cd.appendChild(af);
          const rw = vmlDoc.createElementNS(XNS, 'x:Row'); rw.textContent = String(mm.absRow); cd.appendChild(rw);
          const cl = vmlDoc.createElementNS(XNS, 'x:Column'); cl.textContent = String(mm.absCol); cd.appendChild(cl);
          shape.appendChild(cd);
          vmlRoot.appendChild(shape);
        });

        const ser = new XMLSerializer();
        packageZip.file(commentsPart, ser.serializeToString(commentsDoc));
        packageZip.file(vmlPart, ser.serializeToString(vmlDoc));
        packageZip.file(sheetRelsPart, ser.serializeToString(sheetRelsDoc));
        packageZip.file(CT_PART, ser.serializeToString(ctDoc));
      };

      const formulaMemos = [];
      matches.forEach(match => {
        // 여러 행 병합 셀은 한 항목만 표시해도 넓은 범위 전체가 물들 수 있으므로 보존 우선.
        if (match.commentOnly) return;
        const absRow = match.row + rowOffset;
        const absCol = match.col + colOffset;
        const address = XLSX.utils.encode_cell({ r: absRow, c: absCol }).toUpperCase();
        const cellNode = cellsByAddress.get(address);
        // 원본에 실제 셀이 없는 경우 새 셀을 만들지 않는다. 원본 구조 보존이 최우선이다.
        if (!cellNode) return;
        const baseStyleId = parseInt(cellNode.getAttribute('s') || '0', 10);
        const safeBase = Number.isFinite(baseStyleId) ? baseStyleId : 0;
        const { fillColor } = getStatusColors(match.status);
        const isFormulaCell = getXmlElements(cellNode, 'f').length > 0;
        const note = (match.note && String(match.note).trim()) ? String(match.note) : '';

        if (isFormulaCell) {
          // 계산항: 색상만 칠하고 값/수식은 그대로 둔다. 사유는 아래에서 메모로 추가.
          cellNode.setAttribute('s', String(getMarkedStyleId(safeBase, fillColor, false)));
          if (note) formulaMemos.push({ address, absRow, absCol, note });
          return;
        }

        cellNode.setAttribute('s', String(getMarkedStyleId(safeBase, fillColor, !!note)));
        if (note) {
          const original = readCellNodeText(cellNode);
          setCellNodeInlineText(cellNode, original ? `${original}\n${note}` : note);
        }
      });

      if (formulaMemos.length > 0) {
        try {
          await applyFormulaCellMemos(formulaMemos);
        } catch (memoErr) {
          console.warn('제습건조기 검토표시본: 계산항 메모 추가 실패(색상 표시는 유지):', memoErr);
        }
      }

      const serializer = new XMLSerializer();
      packageZip.file(sheetPart, serializer.serializeToString(sheetDoc));
      packageZip.file(stylesPart, serializer.serializeToString(stylesDoc));
      return {
        blob: await packageZip.generateAsync({ type: 'blob' }),
        usedFallback: false
      };
    }

    // ExcelJS가 원본 xlsx를 직접 읽지 못했을 때(스타일/구조가 까다로운 일부 파일에서 발생)
    // 쓰는 대체 경로. 이미 성공적으로 파싱해 둔 SheetJS 시트 객체(sheet)에서
    // "실제 값이 들어있는 셀"만 그대로 옮기고 병합 정보(!merges)·열 너비(!cols)를
    // 함께 복원한다. (fileMatrix는 검색용으로 병합 셀 값을 모든 칸에 복제해두므로
    // 여기서는 절대 쓰지 않는다 — 그게 바로 "형식이 깨지는" 원인이었다.)
    function buildWorksheetFromSheetJS(wb, sheet, sheetName) {
      const ws = wb.addWorksheet(sheetName || 'Sheet1');
      const range = XLSX.utils.decode_range(sheet['!ref'] || 'A1');

      if (sheet['!cols']) {
        sheet['!cols'].forEach((col, i) => {
          if (col && (col.wch || col.wpx)) {
            ws.getColumn(i + 1).width = col.wch || (col.wpx / 7);
          }
        });
      }

      for (let R = range.s.r; R <= range.e.r; R++) {
        for (let C = range.s.c; C <= range.e.c; C++) {
          const addr = XLSX.utils.encode_cell({ r: R, c: C });
          const cellData = sheet[addr];
          if (!cellData || cellData.v === undefined) continue; // 값이 없는 칸(병합으로 비어있던 칸 포함)은 건드리지 않는다
          const excelCell = ws.getRow(R - range.s.r + 1).getCell(C - range.s.c + 1);
          excelCell.value = cellData.v;
          excelCell.font = { name: '맑은 고딕', size: 10, color: { argb: 'FF000000' } };
          excelCell.border = {
            top: { style: 'thin', color: { argb: 'FFD9D9D9' } },
            left: { style: 'thin', color: { argb: 'FFD9D9D9' } },
            bottom: { style: 'thin', color: { argb: 'FFD9D9D9' } },
            right: { style: 'thin', color: { argb: 'FFD9D9D9' } }
          };
        }
      }

      if (sheet['!merges']) {
        sheet['!merges'].forEach(m => {
          try {
            ws.mergeCells(
              m.s.r - range.s.r + 1, m.s.c - range.s.c + 1,
              m.e.r - range.s.r + 1, m.e.c - range.s.c + 1
            );
          } catch (e) { /* 유효하지 않은 병합 범위는 건너뜀 */ }
        });
      }

      if (sheet['!rows']) {
        sheet['!rows'].forEach((rowInfo, i) => {
          if (rowInfo && rowInfo.hpx) {
            ws.getRow(i - range.s.r + 1).height = rowInfo.hpx * 0.75;
          }
        });
      }

      return ws;
    }

    // 원본 파일(fileObj)의 사본을 만들어, matches에 담긴 각 위치의 "그 셀 자체"에
    // 판정 색상을 칠하고 셀 안에 줄바꿈으로 상세 분석 사유를 덧붙인다.
    // 행을 삽입하거나 통째로 칠하지 않으므로 병합 셀 등 원본 구조를 건드리지 않는다.
    async function annotateWorkbookCopy(fileObj, matches, rowOffset, colOffset, fileMatrix, preserveOriginalPackage) {
      // 제습건조기 문서는 DrawingML 도형까지 원본 그대로 유지해야 하므로 ExcelJS로
      // 로드/재저장하지 않는다. 원본 ZIP에서 검사 셀의 스타일 참조만 최소 변경한다.
      if (preserveOriginalPackage) {
        return annotateXlsxPackagePreservingOriginal(fileObj, matches, rowOffset, colOffset);
      }
      const wb = new ExcelJS.Workbook();
      const ext = (fileObj.fileName.split('.').pop() || '').toLowerCase();
      let loadedFromOriginal = false;

      if (ext === 'xlsx' && fileObj.file) {
        try {
          const arrayBuf = await fileObj.file.arrayBuffer();
          await wb.xlsx.load(arrayBuf);
          loadedFromOriginal = true;
        } catch (err) {
          console.warn('원본 xlsx 로드 실패, xls→xlsx 변환을 시도합니다:', fileObj.fileName, err);
        }
      }

      // ExcelJS는 최신 OOXML(.xlsx)만 읽을 수 있어서, .xls(예전 바이너리 포맷)나 .csv는
      // 위 분기에서 아예 시도조차 되지 않는다(또는 시도했다가 실패한다). 하지만 이미
      // SheetJS로 성공적으로 읽어둔 fileObj.workbook이 있으므로, 이걸 SheetJS 자체
      // 기능으로 "xlsx 포맷 바이트"로 다시 써서(XLSX.write) ExcelJS에 넣어보면, 값/병합
      // 뿐 아니라 셀 서식(배경색·글꼴색·테두리 등)까지 상당 부분 함께 살아난다.
      // (완벽히 원본과 동일하진 않지만, 아래 buildWorksheetFromSheetJS의 "서식 없는 새
      // 워크북"보다는 원본에 훨씬 가깝다.) .xlsx인데 위에서 로드가 실패한 경우도 이걸로
      // 한 번 더 구제를 시도한다.
      if (!loadedFromOriginal && fileObj.workbook && typeof XLSX !== 'undefined' && XLSX.write) {
        try {
          const convertedBuf = XLSX.write(fileObj.workbook, { bookType: 'xlsx', type: 'array', cellStyles: true });
          await wb.xlsx.load(convertedBuf);
          loadedFromOriginal = true;
        } catch (err) {
          console.warn('xls→xlsx 변환본 로드도 실패, 값·병합구조만 유지한 채 재구성합니다:', fileObj.fileName, err);
        }
      }

      let ws = null;
      let usedFallback = false;
      if (loadedFromOriginal) {
        ws = wb.getWorksheet(fileObj.activeSheet) || wb.worksheets[0];
      }
      if (!ws) {
        usedFallback = true;
        // 위의 두 시도(원본 직접 로드, xls→xlsx 변환 후 로드)가 모두 실패했을 때만
        // 쓰는 최후의 수단: 이미 SheetJS로 파싱해 둔 시트 데이터에서 병합 정보를 살려
        // 서식 없이 재구성한다.
        const sheet = fileObj.workbook && fileObj.workbook.Sheets ? fileObj.workbook.Sheets[fileObj.activeSheet] : null;
        if (sheet) {
          ws = buildWorksheetFromSheetJS(wb, sheet, fileObj.activeSheet);
        } else {
          // 최후의 수단: 이것도 없으면 평면 데이터로만 채운다.
          ws = wb.addWorksheet(fileObj.activeSheet || 'Sheet1');
          fileMatrix.forEach(row => ws.addRow(row));
        }
        rowOffset = 0;
        colOffset = 0;
      }

      // 같은 셀에 여러 판정이 겹칠 수 있으므로 "행_열" 기준으로 먼저 묶는다.
      const priority = ['MISMATCH', 'MISMATCH (단위)', 'REVIEW', 'MISSING', 'SKIPPED'];
      const cellGroups = new Map();
      matches.forEach(m => {
        const key = `${m.row}_${m.col}`;
        if (!cellGroups.has(key)) cellGroups.set(key, { row: m.row, col: m.col, items: [], commentOnly: false });
        const group = cellGroups.get(key);
        group.items.push(m);
        // 그룹 안에 하나라도 commentOnly(여러 행 병합이라 색칠하면 안 되는 경우)가 있으면
        // 그 셀 전체를 comment-only로 취급한다.
        if (m.commentOnly) group.commentOnly = true;
      });

      cellGroups.forEach(group => {
        const excelRow = group.row + rowOffset + 1;
        const excelCol = group.col + colOffset + 1;
        const repStatus = group.items.map(i => i.status).sort((a, b) => priority.indexOf(a) - priority.indexOf(b))[0];
        const { fillColor, fontColor } = getStatusColors(repStatus);
        const noteBlock = group.items.map(i => i.note).filter(Boolean).join('\n');
        const cell = ws.getRow(excelRow).getCell(excelCol);

        if (group.commentOnly) {
          // 여러 세부 항목에 걸쳐 병합된 라벨 칸 등: 배경색을 칠하면 관련 없는 다른 행까지
          // 물들기 때문에, 셀 값/배경은 그대로 두고 Excel 메모(comment)로만 사유를 남긴다.
          try {
            cell.note = noteBlock;
          } catch (e) { /* 메모 추가 실패 시 무시(레이아웃은 보존됨) */ }
          return;
        }

        const originalVal = (cell.value !== null && cell.value !== undefined) ? String(cell.value) : '';
        // 사유(detailNote)에는 이미 ⚠/❌/🔍 같은 아이콘이 포함돼 있으므로 그대로 이어붙인다.
        cell.value = noteBlock ? `${originalVal}\n${noteBlock}` : originalVal;

        // ⚠️ ExcelJS는 서식이 완전히 동일한 셀들을 내부적으로 "같은 스타일 레코드"를
        // 공유하도록 저장한다(엑셀 파일 용량 최적화). 예를 들어 "마모도 판정표"의
        // A/B/C등급 칸들처럼 글꼴/테두리/정렬이 전부 똑같은 셀들은 원본에서부터 이미
        // 하나의 스타일 인덱스를 공유하고 있다. 이 상태에서 cell.fill = {...}로 셀 하나만
        // 바꾸면, ExcelJS가 그 "공유된 스타일 레코드 자체"를 변경해버려서 같은 스타일을
        // 쓰는 다른 셀들(예: 스크류 A등급만 고치려 했는데 체크링 A/B/C, 스크류 B/C 등급
        // 칸까지 전부)까지 같이 색이 바뀌어버리는 문제가 있었다. cell.style을 먼저
        // 얕은 복제해서 이 셀만의 독립된 스타일 객체로 분리한 뒤에 값을 바꿔야 한다.
        cell.style = Object.assign({}, cell.style);

        cell.fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: fillColor } };
        cell.font = { name: cell.font && cell.font.name ? cell.font.name : '맑은 고딕', size: (cell.font && cell.font.size) || 10, color: { argb: fontColor }, bold: true };
        cell.alignment = { wrapText: true, vertical: 'top', horizontal: (cell.alignment && cell.alignment.horizontal) || 'left' };
      });

      const buffer = await wb.xlsx.writeBuffer();
      return { blob: new Blob([buffer]), usedFallback };
    }

    // fileMatrix는 검색 편의를 위해 병합 셀의 값을 병합 범위 전체에 복제해두므로,
    // 검색으로 찾은 (row, col)이 병합의 "진짜 값이 들어있는 좌상단 셀"이 아닐 수 있다.
    // 실제로 값을 쓸 때는 항상 병합의 좌상단 셀로 되돌려야 한다.
    function remapToMergeAnchor(sheet, matrixRow, matrixCol, rowOffset, colOffset) {
      if (!sheet['!merges']) return { row: matrixRow, col: matrixCol };
      const absR = matrixRow + rowOffset;
      const absC = matrixCol + colOffset;
      for (const m of sheet['!merges']) {
        if (absR >= m.s.r && absR <= m.e.r && absC >= m.s.c && absC <= m.e.c) {
          return { row: m.s.r - rowOffset, col: m.s.c - colOffset };
        }
      }
      return { row: matrixRow, col: matrixCol };
    }

    // 특정 문서 슬롯(key)에 업로드된 파일들(여러 개 가능) 각각에 대해,
    // annotations 목록 중 그 파일에서 실제로 발견된 항목만 표시하여 사본을 만든다.
    // sourceItem.__rowMeta(파싱 시 기록해둔 정확한 좌표)가 있으면 텍스트 재검색 없이
    // 바로 그 셀로 찾아가고, 없는 경우(예: Front/Rear 병합으로 합성된 항목)에만
    // 예전 방식(키워드 텍스트 재검색)으로 보완한다.
    async function buildAnnotatedFilesForKey(key, annotations) {
      const results = [];
      const item = docData[key];
      if (!item || !item.filesList || item.filesList.length === 0 || annotations.length === 0) return results;

      // 좌표 정보가 있는 항목은 파일 인덱스별로 미리 묶어 둔다.
      const byFileIdx = new Map();
      let remainingTextSearch = [];
      annotations.forEach(ann => {
        const rowMeta = ann.sourceItem && ann.sourceItem.__rowMeta;
        if (rowMeta && typeof rowMeta.fileIdx === 'number' && typeof rowMeta.localRow === 'number') {
          if (!byFileIdx.has(rowMeta.fileIdx)) byFileIdx.set(rowMeta.fileIdx, []);
          byFileIdx.get(rowMeta.fileIdx).push({ ann, localRow: rowMeta.localRow });
        } else {
          remainingTextSearch.push(ann);
        }
      });

      for (let fileIdx = 0; fileIdx < item.filesList.length; fileIdx++) {
        const fileObj = item.filesList[fileIdx];
        if (!fileObj.workbook || !fileObj.activeSheet) continue;
        const sheet = fileObj.workbook.Sheets[fileObj.activeSheet];
        if (!sheet) continue;

        const fileMatrix = sheetToMatrix(sheet);
        const range = XLSX.utils.decode_range(sheet['!ref'] || 'A1');
        const rowOffset = range.s.r;
        const colOffset = range.s.c;

        const matches = [];

        // 1) 정확한 좌표(__rowMeta)가 있는 항목: 재검색 없이 바로 배치
        const direct = byFileIdx.get(fileIdx) || [];
        direct.forEach(({ ann, localRow }) => {
          if (localRow < 0 || localRow >= fileMatrix.length) return;
          const col = pickTargetCellCol(ann.sourceItem, fileMatrix[localRow], ann.status);
          if (col === -1) return;
          const anchor = remapToMergeAnchor(sheet, localRow, col, rowOffset, colOffset);
          const commentOnly = isCellInMultiRowMerge(sheet, anchor.row + rowOffset, anchor.col + colOffset);
          matches.push({ row: anchor.row, col: anchor.col, status: ann.status, note: ann.note, commentOnly });
        });

        // 2) 좌표가 없는 항목(예: Front/Rear 병합 합성 항목)만 예전 방식으로 보완
        const stillRemaining = [];
        remainingTextSearch.forEach(ann => {
          const loc = locateKeywordCell(fileMatrix, ann.keyword);
          if (!loc) { stillRemaining.push(ann); return; }
          const specCol = findSpecColInRow(fileMatrix[loc.row], ann.specText, loc.col, sheet, loc.row + rowOffset, colOffset);
          const targetCol = specCol !== -1 ? specCol : loc.col;
          const anchor = remapToMergeAnchor(sheet, loc.row, targetCol, rowOffset, colOffset);
          const commentOnly = isCellInMultiRowMerge(sheet, anchor.row + rowOffset, anchor.col + colOffset);
          matches.push({ row: anchor.row, col: anchor.col, status: ann.status, note: ann.note, commentOnly });
        });
        remainingTextSearch = stillRemaining;

        if (matches.length === 0) continue;

        try {
          const { blob, usedFallback } = await annotateWorkbookCopy(fileObj, matches, rowOffset, colOffset, fileMatrix, key === 'dd');
          if (blob) results.push({ fileName: buildAnnotatedCopyFileName(fileObj.fileName), blob, usedFallback });
        } catch (err) {
          console.error('사본 표시 실패:', fileObj.fileName, err);
          if (key === 'dd') {
            showToast(bi(
              `⚠️ 제습건조기 검토표시본은 원본 보존에 실패하여 생성하지 않았습니다: ${err.message}`,
              `⚠️ The dryer review copy was not created because the original workbook could not be preserved: ${err.message}`
            ), 'error');
          }
        }
      }

      return results;
    }

    async function exportExcelWithHighlight() {
      if (analysisResults.length === 0) return;
      if (typeof JSZip === 'undefined') {
        showToast(bi('⚠️ 압축 파일 생성 라이브러리를 불러오지 못했습니다. 네트워크 상태를 확인해주세요.', '⚠️ Could not load the zip library. Please check your network connection.'), 'error');
        return;
      }

      const zip = new JSZip();
      const fallbackFileNames = [];

      // 1) 기존 QMS 결과 리포트(형광펜 하이라이트 xlsx)
      const reportBuffer = await buildReportWorkbookBuffer();
      const reportFileNamePrefix = currentLang === 'eng' ? 'QMS_Result Report' : 'QMS_결과 리포트';
      const dateStr = new Date().toISOString().slice(0, 10);
      zip.file(`${reportFileNamePrefix}_${dateStr}.xlsx`, reportBuffer);

      // 2) 관리계획서 + 하위문서 6종(검사표준서/설비일상점검표/스크류점검일지/작업조건기록지/퍼징작업지도서/제습건조기 사용 관리 기준서)
      //    "사본"에 MISMATCH/MISMATCH(단위)/REVIEW/MISSING 위치와 상세 분석 사유를 표시
      const { cpAnnotations, byDocKey } = collectAnnotationsByDoc();
      const folder = zip.folder(currentLang === 'eng' ? 'Original_Documents_Marked' : '원본문서_표시본');

      const cpFiles = await buildAnnotatedFilesForKey('cp', cpAnnotations);
      cpFiles.forEach(f => {
        folder.file(f.fileName, f.blob);
        if (f.usedFallback) fallbackFileNames.push(f.fileName);
      });

      for (const key of ['is', 'eq', 'sc', 'wc', 'pg', 'dd']) {
        const anns = byDocKey[key] || [];
        if (anns.length === 0) continue;
        const files = await buildAnnotatedFilesForKey(key, anns);
        files.forEach(f => {
          folder.file(f.fileName, f.blob);
          if (f.usedFallback) fallbackFileNames.push(f.fileName);
        });
      }

      const zipBlob = await zip.generateAsync({ type: 'blob' });
      const zipNamePrefix = currentLang === 'eng' ? 'QMS_Consistency_Check_Result' : 'QMS_정합성검사_결과묶음';
      saveAs(zipBlob, `${zipNamePrefix}_${dateStr}.zip`);

      if (fallbackFileNames.length > 0) {
        showToast(bi(
          `⚠️ 다음 파일은 원본 서식을 완전히 읽어오지 못해 값·병합구조만 유지한 채 표시했습니다: ${fallbackFileNames.join(', ')}`,
          `⚠️ The following files could not be read with full original formatting; only values/merged layout were preserved: ${fallbackFileNames.join(', ')}`
        ), 'error');
      }
    }

    function resetAll() {
      ['cp', 'is', 'eq', 'sc', 'wc', 'pg', 'dd'].forEach(key => {
        delete docData[key];
        const fileInput = document.getElementById(`file-${key}`);
        if (fileInput) {
          fileInput.value = '';
        }
        updateDocUI(key);
      });

      analysisResults = [];

      const searchInput = document.getElementById('search-keyword');
      if (searchInput) searchInput.value = '';

      const filterDoc = document.getElementById('filter-doc');
      if (filterDoc) filterDoc.value = 'ALL';

      const filterStatus = document.getElementById('filter-status');
      if (filterStatus) filterStatus.value = 'ALL';

      const tbody = document.getElementById('result-tbody');
      if (tbody) tbody.innerHTML = '';

      const dashSection = document.getElementById('dashboard-section');
      if (dashSection) dashSection.classList.add('hidden');
    }
  </script>
